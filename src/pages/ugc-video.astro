---
import Base from '../layouts/Base.astro';
---

<Base title="UGC Video Production — OKAD Agency" description="UGC for ads and organic. We find the creators, write the scripts, shoot and edit.">

  <!-- Hero -->
  <div class="hero">
    <h1>UGC videos for brands, for <em>content / performance</em></h1>
    <p class="hero-sub">UGC for ads and organic. We find the creators, write the scripts, shoot and edit.</p>
  </div>

  <!-- Feature Cards -->
  <div class="features-grid">
    <div class="feature-card">
      <h3>Our Own Creators</h3>
      <p>600+ creators in our database. We pick who fits your product and audience — you approve before we start.</p>
    </div>
    <div class="feature-card">
      <h3>Script First, Then Shoot</h3>
      <p>Every video starts with a script. We write the hook, structure the story, and edit for the platform.</p>
    </div>
    <div class="feature-card">
      <h3>5 or 50 Videos a Month</h3>
      <p>Same quality whether you need 5 or 50. We have the team and process to keep up.</p>
    </div>
  </div>

  <!-- Campaign Performance Stats -->
  <section class="stats-section">
    <h2 class="section-title">Campaign Performance</h2>
    <div class="stats-grid">
      <div class="stat-card">
        <h2>Organic</h2>
        <div class="stat-tags">
          <span class="stat-tag green">1M+ views</span>
          <span class="stat-tag blue">8% avg. engagement</span>
        </div>
        <p style="color:var(--color-muted);font-size:15px;margin-top:12px;">TikTok, Reels, Shorts — content made for each platform.</p>
      </div>
      <div class="stat-card">
        <h2>E-commerce & Digital</h2>
        <div class="stat-tags">
          <span class="stat-tag">3x ROAS avg.</span>
          <span class="stat-tag pink">-40% CPA</span>
          <span class="stat-tag orange">2.5x CTR lift</span>
        </div>
        <p style="color:var(--color-muted);font-size:15px;margin-top:12px;">UGC ads for e-commerce, SaaS, and service brands. We test and iterate until it works.</p>
      </div>
    </div>
  </section>

  <!-- Process Framework -->
  <section class="process-section">
    <h2 class="section-title">Our UGC Production Process</h2>
    <div class="process-grid">
      <div class="process-step">
        <div class="step-num">1</div>
        <h3>UGC Sourcing</h3>
        <p>We find creators from our 600+ database who match your brand, audience, and budget.</p>
      </div>
      <div class="process-step">
        <div class="step-num">2</div>
        <h3>Creators Matching</h3>
        <p>Review profiles, past work, and audience fit. You approve the final roster before we begin.</p>
      </div>
      <div class="process-step">
        <div class="step-num">3</div>
        <h3>Scripts & Briefs</h3>
        <p>We write hooks, scripts, and shot lists tailored to your campaign goals and platform formats.</p>
      </div>
      <div class="process-step">
        <div class="step-num">4</div>
        <h3>Video Editing</h3>
        <p>Professional post-production: cuts, captions, sound design, and format optimization per channel.</p>
      </div>
      <div class="process-step">
        <div class="step-num">5</div>
        <h3>Delivery</h3>
        <p>Final assets delivered in all required formats with naming conventions, ready to upload.</p>
      </div>
    </div>
  </section>

  <!-- Expected Results -->
  <section class="stats-section">
    <h2 class="section-title">Expected Results</h2>
    <div class="features-grid">
      <div class="feature-card">
        <h3>Higher ROAS</h3>
        <p>UGC ads usually beat polished brand videos. Most clients see 2–5x ROAS.</p>
      </div>
      <div class="feature-card">
        <h3>Lower CPA</h3>
        <p>Creator content looks real — people engage more, cost per lead drops 30–50%.</p>
      </div>
      <div class="feature-card">
        <h3>Faster Iteration</h3>
        <p>We can test 10–30 versions a month. You find what works fast and scale it.</p>
      </div>
      <div class="feature-card">
        <h3>Cross-Platform</h3>
        <p>One shoot — multiple formats. Same content adapted for TikTok, Meta, YouTube.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact-section">
    <div class="contact-inner">
      <h2>Discuss your case</h2>
      <p>Tell us what you're working on — we'll share relevant cases and suggest an approach.</p>
      <div class="contact-buttons">
        <a href="https://calendly.com/okad-agency/30min" class="btn" target="_blank" rel="noopener">Schedule a call</a>
        <a href="mailto:olga@okad.agency" class="contact-btn">Email us</a>
      </div>
    </div>
  </section>

</Base>
