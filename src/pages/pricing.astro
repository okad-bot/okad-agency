---
import Base from '../layouts/Base.astro';
---

<Base title="Pricing — OKAD Agency" description="Ad creatives, UGC video, branding, web design — per-unit and monthly pricing.">

  <div class="page-header">
    <h1>Pricing</h1>
    <p>Start with one task or a monthly package. Scale when ready.</p>
  </div>

  <!-- Per Unit Pricing -->
  <section class="unit-pricing">
    <h2 class="section-title">Per Unit Pricing</h2>
    <table class="unit-table">
      <thead>
        <tr>
          <th>Service</th>
          <th>Price</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Static ad / post (design + copy)</td>
          <td>from $100</td>
        </tr>
        <tr>
          <td>Carousel (design + copy)</td>
          <td>from $200</td>
        </tr>
        <tr>
          <td>UGC video (editing only / ai-gen)</td>
          <td>from $120</td>
        </tr>
        <tr>
          <td>UGC video full (scripts + full production)</td>
          <td>from $250</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Monthly Packages -->
  <h2 class="section-title">Monthly Packages</h2>
  <section class="pricing-section">
    <div class="pricing-grid">

      <!-- Test & Learn -->
      <div class="pricing-card">
        <span class="pricing-pill" style="background:#e5fff0;color:#00b894;">Starter</span>
        <h3>Test & Learn</h3>
        <div class="pricing-price">$2,500</div>
        <div class="pricing-period">per month</div>
        <p class="pricing-desc">Starting paid ads for the first time. Test what works, then scale.</p>
        <ul class="pricing-features">
          <li>10 creatives per month</li>
          <li>Ad strategy & creative direction</li>
          <li>1 creator sourced & managed</li>
          <li>Variations testing</li>
          <li>Winner scaling</li>
          <li>Weekly analytics report</li>
        </ul>
        <a href="mailto:olga@okad.agency?subject=Test%20%26%20Learn%20Package" class="btn">Get started</a>
      </div>

      <!-- Scale What Works -->
      <div class="pricing-card featured">
        <span class="pricing-pill" style="background:#e8e5ff;color:#6c5ce7;">Popular</span>
        <h3>Scale What Works</h3>
        <div class="pricing-price">$3,500</div>
        <div class="pricing-period">per month</div>
        <p class="pricing-desc">You know what works — now you need more of it, faster.</p>
        <ul class="pricing-features">
          <li>20-30 creatives per month</li>
          <li>1-3 creators sourced & managed</li>
          <li>Full creative strategy</li>
          <li>A/B testing & iteration</li>
          <li>Performance-based optimization</li>
          <li>Bi-weekly strategy calls</li>
        </ul>
        <a href="mailto:olga@okad.agency?subject=Scale%20What%20Works%20Package" class="btn">Get started</a>
      </div>

      <!-- Always-On Content -->
      <div class="pricing-card">
        <span class="pricing-pill" style="background:#ffe5f0;color:#e84393;">Enterprise</span>
        <h3>Always-On Content</h3>
        <div class="pricing-price">$5,000</div>
        <div class="pricing-period">per month</div>
        <p class="pricing-desc">Non-stop content across channels. New creatives every week.</p>
        <ul class="pricing-features">
          <li>30+ creatives per month</li>
          <li>1-3+ creators sourced & managed</li>
          <li>Full creative & content strategy</li>
          <li>Multi-channel content calendar</li>
          <li>Priority turnaround</li>
          <li>Weekly strategy calls</li>
        </ul>
        <a href="mailto:olga@okad.agency?subject=Always-On%20Content%20Package" class="btn">Get started</a>
      </div>

    </div>
  </section>

  <!-- One-time Projects -->
  <h2 class="section-title">One-time Projects</h2>
  <section class="projects-section">
    <div class="projects-grid">
      <div class="project-item">
        <span>Ad/Content strategy + competitor audit</span>
        <span>from $1,000</span>
      </div>
      <div class="project-item">
        <span>Branding</span>
        <span>from $1,500</span>
      </div>
      <div class="project-item">
        <span>Landing page</span>
        <span>from $1,500</span>
      </div>
      <div class="project-item">
        <span>Multi-page website</span>
        <span>$1,700 - $7,500</span>
      </div>
      <div class="project-item">
        <span>Branding + website bundle</span>
        <span>from $5,000</span>
      </div>
      <div class="project-item">
        <span>Packaging design</span>
        <span>from $1,000</span>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact-section">
    <div class="contact-inner">
      <h2>Not sure which plan fits?</h2>
      <p>Book a 20-min call — we'll help you pick the right setup.</p>
      <div class="contact-buttons">
        <a href="https://calendly.com/okad-agency/30min" class="btn" target="_blank" rel="noopener">Book a call</a>
        <a href="mailto:olga@okad.agency" class="contact-btn">Email us</a>
      </div>
    </div>
  </section>

</Base>
