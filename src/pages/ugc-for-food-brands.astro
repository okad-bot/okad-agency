        .faq summary { padding:20px 0;cursor:pointer;list-style:none;font-weight:500;font-size:16px;display:flex;justify-content:space-between;align-items:center; }
        .faq summary::-webkit-details-marker { display:none; }
        .faq summary::after { content:"+";font-size:20px;color:var(--muted); }
        .faq details[open] summary::after { content:"\2212"; }
        .faq .ans { padding:0 0 20px;font-size:15px;line-height:1.65;max-width:680px; }
      </style>
    </section>

