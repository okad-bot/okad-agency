---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getCollection, render } from 'astro:content';
import { topicOf, readMinutes } from '../../lib/learn';
import '../../styles/okad-house.css';

export async function getStaticPaths() {
  const cases = await getCollection('cases');
  return cases
    .filter(c => c.data.type === 'blog')
    .map(entry => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = topicOf(entry);

const all = await getCollection('cases');
const blog = all.filter(c => c.id !== entry.id && c.data.type === 'blog');
// related: same topic first, then the rest; stable order so builds don't reshuffle
const related = [
  ...blog.filter(c => c.data.topic === entry.data.topic),
  ...blog.filter(c => c.data.topic !== entry.data.topic),
].slice(0, 3);

const faqs = entry.data.faqs || [];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": entry.data.title,
  "description": entry.data.description || "",
  "image": entry.data.cover || "",
  "author": { "@type": "Organization", "name": "OKAD Agency", "url": "https://okad.agency" },
  "publisher": { "@type": "Organization", "name": "OKAD Agency", "url": "https://okad.agency" },
  "mainEntityOfPage": { "@type": "WebPage", "@id": `https://okad.agency/blog/${entry.id}/` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://okad.agency/" },
    { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://okad.agency/blog/" },
    { "@type": "ListItem", "position": 3, "name": entry.data.title },
  ],
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
} : null;
---

<Base title={`${entry.data.title} — OKAD Agency`} description={entry.data.description} ogImage={entry.data.cover} lang={entry.data.lang}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>

  <div class="okh">
    <article class="post">
      <header class="post-head" style={`--tc:${t.color}`}>
        <div class="w">
          <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/blog/">Learn</a> / <span>{t.label}</span></nav>
          <h1>{entry.data.title}</h1>
          {entry.data.description && <p class="lead">{entry.data.description}</p>}
          <div class="post-meta"><span class="gc-topic">{t.label}</span><span>{readMinutes(entry)} min read</span><span>by the OKAD team</span></div>
        </div>
      </header>

      <div class="w">
        <div class="prose">
          <Content />
        </div>

        {faqs.length > 0 && (
          <section class="post-faq">
            <h2>Questions people ask</h2>
            {faqs.map(f => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <div class="xband post-cta">
          <div style="display:grid;gap:10px">
            <span class="hand">rather have us do it?</span>
            <h3>A testing plan for your first 10 videos, from $200</h3>
          </div>
          <a class="btn" href="/#offer">See the offers →</a>
        </div>
      </div>
    </article>

    {related.length > 0 && (
      <section class="sec">
        <div class="w">
          <div class="head">
            <h2>Keep <span class="cap g">reading</span></h2>
            <a class="btn ghost" href="/blog/">All guides →</a>
          </div>
          <div class="ggrid">
            {related.map(c => <GuideCard entry={c} />)}
          </div>
        </div>
      </section>
    )}
  </div>
</Base>
