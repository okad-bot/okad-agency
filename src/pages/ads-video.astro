---
import Base from '../layouts/Base.astro';
---

<Base title="Ads Video Production — OKAD Agency" description="Video ads for TikTok, Instagram, and Meta. We script, shoot, and edit — you run the campaigns.">

  <!-- Hero -->
  <div class="hero">
    <h1>UGC Video Ads That <em>Actually Work</em></h1>
    <p class="hero-sub">Video ads for TikTok, Instagram, and Meta. We script, shoot, and edit — you run the campaigns.</p>
  </div>

  <!-- Happy Customers Stat -->
  <div style="text-align:center;padding:0 24px 40px;">
    <span class="stat-tag" style="font-size:14px;padding:8px 20px;">200+ BRANDS WORKED WITH</span>
  </div>

  <!-- Industry Verticals -->
  <h2 class="section-title">Industries We Serve</h2>
  <div class="features-grid">
    <div class="feature-card">
      <h3>Skincare & Wellness</h3>
      <p>Product demos, before-and-after, creator reviews. People trust real faces more than studio ads.</p>
    </div>
    <div class="feature-card">
      <h3>SaaS & Fintech</h3>
      <p>Short explainer videos that show what the product does. No jargon, real use cases.</p>
    </div>
    <div class="feature-card">
      <h3>Education</h3>
      <p>Tutorials, student stories, educational hooks — content that speaks to both learners and parents.</p>
    </div>
    <div class="feature-card">
      <h3>Fashion & E-commerce</h3>
      <p>Unboxings, styling, hauls — the kind of content people actually watch before buying.</p>
    </div>
  </div>

  <!-- Video Format Types -->
  <h2 class="section-title">Video Format Types</h2>
  <div class="features-grid">
    <div class="feature-card">
      <h3>Silent</h3>
      <p>Bold visuals and text overlays for people scrolling with sound off. Feed and stories.</p>
    </div>
    <div class="feature-card">
      <h3>Speaking</h3>
      <p>Creator talks to camera with a scripted hook. Captions on. This format builds trust.</p>
    </div>
    <div class="feature-card">
      <h3>Creative Action</h3>
      <p>Fast cuts, product demos, transitions — made to grab attention in 2–3 seconds.</p>
    </div>
    <div class="feature-card">
      <h3>Creative Story</h3>
      <p>Short stories: problem → solution → result. People watch longer and share more.</p>
    </div>
  </div>

  <!-- Pricing Plans -->
  <h2 class="section-title">Pricing Plans</h2>
  <section class="pricing-section">
    <div class="pricing-grid">

      <div class="pricing-card">
        <span class="pricing-pill" style="background:#e5fff0;color:#00b894;">Basic</span>
        <h3>Video Editing</h3>
        <div class="pricing-price">$700+</div>
        <div class="pricing-period">per month</div>
        <p class="pricing-desc">You send footage — we edit, add captions, sound, and export in all formats.</p>
        <ul class="pricing-features">
          <li>Professional video editing</li>
          <li>Caption & subtitle overlay</li>
          <li>Sound design & music</li>
          <li>Multi-format exports</li>
          <li>2 revision rounds</li>
        </ul>
        <a href="mailto:olga@okad.agency?subject=Video%20Editing%20Plan" class="btn">Get started</a>
      </div>

      <div class="pricing-card featured">
        <span class="pricing-pill" style="background:#e8e5ff;color:#6c5ce7;">Popular</span>
        <h3>Creative Video Editing</h3>
        <div class="pricing-price">$1,000+</div>
        <div class="pricing-period">per month</div>
        <p class="pricing-desc">We write the hooks, structure the story, and edit for performance. Not just cutting — thinking.</p>
        <ul class="pricing-features">
          <li>Everything in Video Editing</li>
          <li>Hook scripting & creative direction</li>
          <li>A/B test variations</li>
          <li>Trend-driven formats</li>
          <li>Performance recommendations</li>
        </ul>
        <a href="mailto:olga@okad.agency?subject=Creative%20Video%20Editing" class="btn">Get started</a>
      </div>

      <div class="pricing-card">
        <span class="pricing-pill" style="background:#ffe5f0;color:#e84393;">Full</span>
        <h3>Full UGC Production</h3>
        <div class="pricing-price">$2,500+</div>
        <div class="pricing-period">per month</div>
        <p class="pricing-desc">We handle everything: find the creator, write the script, coordinate filming, edit, and deliver.</p>
        <ul class="pricing-features">
          <li>Everything in Creative Editing</li>
          <li>Creator sourcing & management</li>
          <li>Full script writing</li>
          <li>Filming coordination</li>
          <li>Strategy & analytics</li>
          <li>Priority turnaround</li>
        </ul>
        <a href="mailto:olga@okad.agency?subject=Full%20UGC%20Production" class="btn">Get started</a>
      </div>

    </div>
  </section>

  <!-- Comparison Table -->
  <section class="comparison-section">
    <h2 class="section-title">OKAD vs Other Agencies</h2>
    <table class="comparison-table">
      <thead>
        <tr>
          <th>Feature</th>
          <th>OKAD</th>
          <th>Other Agencies</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Creator database</td>
          <td>600+ vetted creators</td>
          <td>Limited roster</td>
        </tr>
        <tr>
          <td>Turnaround time</td>
          <td>5-7 business days</td>
          <td>2-4 weeks</td>
        </tr>
        <tr>
          <td>Script writing</td>
          <td>Included in all plans</td>
          <td>Often extra cost</td>
        </tr>
        <tr>
          <td>Performance tracking</td>
          <td>Weekly analytics & optimization</td>
          <td>Monthly or none</td>
        </tr>
        <tr>
          <td>Revision rounds</td>
          <td>2-3 rounds included</td>
          <td>1 round or paid extra</td>
        </tr>
        <tr>
          <td>Multi-platform formats</td>
          <td>All formats included</td>
          <td>One format, extras cost more</td>
        </tr>
        <tr>
          <td>Dedicated strategist</td>
          <td>Yes, from day one</td>
          <td>Account manager only</td>
        </tr>
      </tbody>
    </table>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <h2>What Our Clients Say</h2>
    <p class="testimonials-sub">From skincare to SaaS — here's what clients say.</p>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <blockquote>Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/9yQb8hBXfQCe1f6JkqCRMnt4AKs.jpeg" alt="Maxime Lenzlinger" loading="lazy" />
          <div>
            <div class="testimonial-name">Maxime Lenzlinger</div>
            <div class="testimonial-role">Co-founder / Marketing, VUE SWISS</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>You're the best team I've ever worked with. You are professional, organized, creative, and kind.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/LaQrt95uuBqxdIKPQ5u3sWttcvc.png" alt="Claire Ginn" loading="lazy" />
          <div>
            <div class="testimonial-name">Claire Ginn</div>
            <div class="testimonial-role">Founder, YPM Agency</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>The final result exceeded my expectations. The structure was clear, the content was well-aligned with the brand tone.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/mkinoi0MbzI3iMzkSDbgPOq2GI.png" alt="Kristina Hr." loading="lazy" />
          <div>
            <div class="testimonial-name">Kristina Hr.</div>
            <div class="testimonial-role">Marketing, Mushroom genetics</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact-section">
    <div class="contact-inner">
      <h2>Let's Talk Video</h2>
      <p>Tell us what you need — we'll show you relevant work and suggest an approach.</p>
      <div class="contact-buttons">
        <a href="https://calendly.com/okad-agency/30min" class="btn" target="_blank" rel="noopener">Book a call</a>
        <a href="mailto:olga@okad.agency" class="contact-btn">Email us</a>
      </div>
    </div>
  </section>

</Base>
