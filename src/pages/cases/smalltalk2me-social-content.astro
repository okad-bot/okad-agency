.case-designed .steps{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.case-designed .step{border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:6px;min-width:0}
