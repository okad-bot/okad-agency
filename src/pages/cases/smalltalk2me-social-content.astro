---
import Base from '../../layouts/Base.astro';
// Converted from the OKAD case artifact. Styles are scoped under .case-designed.
const title = "24K views on one tip. 849 people saved it. | OKAD Agency";
const description = "SmallTalk2Me is an AI app for practicing English: IELTS speaking, job interviews, business calls. I ran their social content as one system: creator videos, carousels, UGC photo carousels and daily stories. Everything was built to be useful first, so people save it and come back.";
const ogImage = "/images/cases/smalltalk2me-social-content/st/b1.jpg";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
  </Fragment>
  <div class="case-designed">



<!-- COVER -->
<section class="cover">
  <div class="w">
    <div class="cover-grid">
      <div class="stack" style="gap:24px">
        <span class="kick">SmallTalk2Me · TikTok, Instagram, LinkedIn · organic and ads</span>
        <h1>24K views on one tip. <span class="cap g">849 people saved it.</span></h1>
        <p class="lead">SmallTalk2Me is an AI app for practicing English: IELTS speaking, job interviews, business calls. I ran their social content as one system: creator videos, carousels, UGC photo carousels and daily stories. Everything was built to be useful first, so people save it and come back.</p>
        <div class="meta">
          <div><b>My scope</b><span>Scripts, creator direction, editing, carousels, stories, ad creatives</span></div>
          <div><b>Not my scope</b><span>Media buying and the product itself</span></div>
        </div>
      </div>
      <div class="proofgrid" aria-label="Frames from the published videos">
        <div class="ann hand" style="right:-6px;top:-70px">real learners, real problems<svg width="70" height="60" viewBox="0 0 70 60"><path d="M6 6 C 34 2, 56 18, 60 52"/><path d="M51 44 L60 54 L66 42"/></svg></div>
        <img loading="lazy" decoding="async" alt="My mistakes when I first started working in English" src="/images/cases/smalltalk2me-social-content/st/b1.jpg">
        <img loading="lazy" decoding="async" alt="Yes it's me, and I still struggle with my English" src="/images/cases/smalltalk2me-social-content/st/c2.jpg">
        <img loading="lazy" decoding="async" alt="I watched all these webinars in one evening" src="/images/cases/smalltalk2me-social-content/st/c4.jpg">
        <img loading="lazy" decoding="async" alt="Creator talking to camera" src="/images/cases/smalltalk2me-social-content/st/a1.jpg">
        <img loading="lazy" decoding="async" alt="Course screen: Meetings, Cultural Fit for Working in the U.S." src="/images/cases/smalltalk2me-social-content/st/c3.jpg">
        <img loading="lazy" decoding="async" alt="SmallTalk2Me website on a laptop" src="/images/cases/smalltalk2me-social-content/st/b3.jpg">
      </div>
    </div>
    <div class="strip">
      <div><b>24.1K</b><span>TikTok views on the top creator video</span></div>
      <div><b>849</b><span>saves on that one video</span></div>
      <div><b>7,643</b><span>views on the top carousel</span></div>
      <div><b>1,000+</b><span>stories designed and posted</span></div>
    </div>
  </div>
</section>

<!-- Q1 -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q1 · What did the videos look like?</span>
      <h2>A confession, <span class="cap g">then the fix.</span></h2>
      <p class="lead">Nobody wants an ad for an English course. Everyone recognizes the moment they froze on a call. So every video opened with a creator admitting a real struggle and ended with the app as the thing that helped. I wrote the scripts, directed the creators and cut the videos with fast captions and small motion accents.</p>
    </div>
    <div class="fmt-grid">
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="My mistakes when I first started working in English" src="/images/cases/smalltalk2me-social-content/st/b1.jpg"></figure><span class="lbl proof">Confession</span><h3>"My mistakes"</h3><p>A creator lists what went wrong when she started working in English.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Yes it's me and I still struggle with my English" src="/images/cases/smalltalk2me-social-content/st/c2.jpg"></figure><span class="lbl proof">Self-irony</span><h3>"I still struggle"</h3><p>A hand-drawn arrow, a wink to camera. Honest beats polished.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Laptop with the app open" src="/images/cases/smalltalk2me-social-content/st/b3.jpg"></figure><span class="lbl native">Product on screen</span><h3>Show the practice</h3><p>The app on a laptop, right before a real meeting.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Cat meme, I watched all these webinars in one evening" src="/images/cases/smalltalk2me-social-content/st/c4.jpg"></figure><span class="lbl native">Meme cut</span><h3>A beat of humor</h3><p>"I watched all these webinars in one evening." A cat says it best.</p></div>
    </div>
  </div>
</section>

<!-- Q2 -->
<section>
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q2 · Which number mattered most?</span>
      <h2>Saves, <span class="cap y">not views.</span></h2>
      <p class="lead">For a learning app, a save means "I'll practice this later". That's a person planning to come back. The best creator video, a lazy IELTS tip, got 24,100 views on TikTok and 849 saves. A list of the top three IELTS prep websites got 4,586 views and 192 saves.</p>
      <p class="pro"><b>For marketers</b>The practical tips here were saved by 3.5% to 4.2% of everyone who watched. If your product teaches, measure saves before views.</p>
    </div>
    <div class="box dark">
      <span class="tag g dewtag">Creator videos</span>
      <div class="mx-wrap" style="margin-top:0;background:transparent">
        <table class="res" style="min-width:0">
          <tr><th>Video</th><th>Views</th><th>Saves</th><th>Save rate</th></tr>
          <tr><td>Lazy IELTS tip</td><td class="n">24,100</td><td class="n">849</td><td class="n">3.5%</td></tr>
          <tr><td>Top 3 IELTS prep websites</td><td class="n">4,586</td><td class="n">192</td><td class="n">4.2%</td></tr>
          <tr><td>Work English, second creator</td><td class="n">~1,000</td><td class="n" colspan="2">TikTok, plus 500 to 900 on Instagram</td></tr>
        </table>
      </div>
      <p>TikTok numbers from the creators' own accounts.</p>
    </div>
  </div>
</section>

<!-- Q3 -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q3 · What did the carousels do?</span>
      <h2>Lessons people <span class="cap g">swipe to the end.</span></h2>
      <p class="lead">Each carousel was one small lesson with a framework you can use today. PREP for IELTS speaking. Five podcasts for listening. Phrases for opening a business call. Mobile first, big type, one idea per slide, the app only on the last slide.</p>
    </div>
    <div class="stack" style="margin-top:44px;gap:16px">
      <img loading="lazy" decoding="async" class="board" alt="Top carousels with 7,643, 6,508 and 3,591 views" src="/images/cases/smalltalk2me-social-content/stb/bv1.jpg">
      <img loading="lazy" decoding="async" class="board" alt="5 podcasts carousel, 6,508 views" src="/images/cases/smalltalk2me-social-content/stb/bv2.jpg">
      <img loading="lazy" decoding="async" class="board" alt="Sound like a pro carousel, 3,591 views" src="/images/cases/smalltalk2me-social-content/stb/bv3.jpg">
    </div>
    <div class="chips">
      <span class="chip"><b>7,643</b> PREP framework</span>
      <span class="chip"><b>6,508</b> 5 podcasts</span>
      <span class="chip"><b>3,591</b> Sound like a pro</span>
    </div>
  </div>
</section>

<!-- Q4 -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q4 · And UGC without video?</span>
      <h2>A creator's photos, <span class="cap v">a teacher's tips.</span></h2>
      <p class="lead">UGC carousels were the cheapest thing to make and some of the best to perform. A creator puts a real IELTS score on the cover, then each of their own photos carries one tip. It reads like a friend's photo dump, not a course.</p>
    </div>
    <div class="stack" style="margin-top:44px;gap:16px">
      <img loading="lazy" decoding="async" class="board" alt="UGC carousel: My writing tips, 6,219 views" src="/images/cases/smalltalk2me-social-content/stb/ugc1.jpg">
      <img loading="lazy" decoding="async" class="board" alt="UGC carousel: Speaking tips and tricks, 4,256 views" src="/images/cases/smalltalk2me-social-content/stb/ugc2.jpg">
      <img loading="lazy" decoding="async" class="board" alt="UGC carousel: Why you're failing the IELTS speaking test, 2,665 views" src="/images/cases/smalltalk2me-social-content/stb/ugc3.jpg">
    </div>
    <div class="chips">
      <span class="chip"><b>6,219</b> writing tips, 8.0 score</span>
      <span class="chip"><b>4,256</b> speaking tips, 8.5 score</span>
      <span class="chip"><b>2,665</b> why you're failing speaking</span>
    </div>
  </div>
</section>

<!-- Q5 -->
<section class="dew">
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q5 · How was it run?</span>
      <h2>Every day, <span class="cap g">every format.</span></h2>
      <p class="lead">In the first month alone the account got 9 posts, 11 videos and stories every day. Over the project that added up to more than a thousand stories: vocabulary, memes, polls, phrasal verbs. For B2B I also made LinkedIn visuals aimed at recruiting agencies hiring people who work in English.</p>
      <p class="pro"><b>For marketers</b>Stories are where a learning app stays in someone's day. Posts bring people in, stories keep them practicing.</p>
    </div>
    <img loading="lazy" decoding="async" class="board" alt="Wall of over 1,000 stories created" src="/images/cases/smalltalk2me-social-content/stb/s7.jpg">
  </div>
  <div class="w">
    <div class="learn">
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Admit the struggle</h3><p>Creators who confessed their mistakes got further than creators who explained grammar.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Make it worth saving</h3><p>A concrete tip or a framework turned viewers into people who came back.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>UGC can be a photo</h3><p>Photo carousels with a real score on the cover cost little and held their own against video.</p></div>
    </div>
  </div>
</section>

<!-- OFFER -->
<section>
  <div class="w">
    <div class="offer">
      <span class="q-kick">Q6 · What would this look like for you?</span>
      <h2>Content people save <span class="cap g">is content that sells.</span></h2>
      <p class="lead">For learning apps, edtech and any product that teaches. I build a content system where creator videos, carousels and stories all do one job: be useful enough to keep.</p>
      <div class="steps">
        <div class="step"><span class="mono">step 1</span><b>Research</b><p>Competitors and the questions your users ask.</p></div>
        <div class="step"><span class="mono">step 2</span><b>Script</b><p>Confession hooks and practical tips.</p></div>
        <div class="step"><span class="mono">step 3</span><b>Cast</b><p>Creators who are real learners.</p></div>
        <div class="step"><span class="mono">step 4</span><b>Design</b><p>Carousels, stories, ad creatives.</p></div>
        <div class="step"><span class="mono">step 5</span><b>Measure</b><p>Saves and views, every week.</p></div>
      </div>
      <div class="cta"><a class="btn" href="https://calendly.com/okad_calls/first" target="_blank" rel="noopener">Book a call</a><a class="btn" href="/#offer" style="background:#fff">10 videos · $500</a><span class="hn"><span style="flex:none"><svg width="54" height="22" viewBox="0 0 54 22"><path d="M51 12 C 36 16, 20 7, 5 11"/><path d="M13 4 L4 11 L12 18"/></svg></span><span class="hand">start here</span></span></div>
    </div>
  </div>
</section>

<p class="w case-foot">OKAD · SmallTalk2Me, 2024 to 2025. View and save counts are from the creators' accounts and the brand's Instagram.</p>


  </div>
</Base>

<style is:global>
.case-designed{margin:0;padding:0;background:#ffffff}
.case-designed img{max-width:100%}
.case-designed .case-foot{padding-block:28px 44px;color:var(--soft);font-size:.85rem;max-width:1180px}
.case-designed .cta .btn + .btn{color:#111}
.case-designed{color-scheme:light}.case-designed{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}.case-designed img{max-width:100%}.case-designed [hidden]:not([hidden=until-found i]){display:none!important}

/* OKAD house style: white page, Instrument Serif caps for headlines, Instrument Sans for reading,
   Reenie Beanie for hand-written notes with drawn arrows. Pastel outline marks the key words;
   dew-green bands and black cards create rhythm. */
.case-designed{
  --paper:#ffffff; --card:#f4f4f1; --ink:#111111; --soft:#5f5f5b; --rule:#e6e6e1;
  --dew:#eefb6e; --dew-ink:#111111; --on-dew-card:#ffffff;
  --yel:#f2fa5a; --mint:#b5f5c6; --lav:#d4d4fc; --peach:#ffe2ad; --lilac:#ecc8fa;
  --hi:var(--dew); --hi-ink:#111111; --pink:#111111;
  --c1:#8f4fd6; --c2:#17904f;
  --stage:#121114; --stage-ink:#f4f4f0; --stage-soft:#b9b9b3;
  --good:#17904f; --mid:#c98a14; --bad:#d03e3e;
  --display:"Instrument Serif","Times New Roman",serif;
  --body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --hand:"Reenie Beanie","Bradley Hand",cursive;
  --mono:var(--body);
  --r:28px;
}
.case-designed{color-scheme:light}

.case-designed *{box-sizing:border-box}
.case-designed{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
.case-designed .w{max-width:1180px;margin:0 auto;padding-inline:20px}
.case-designed section{padding-block:96px;position:relative}
.case-designed p{margin:0;max-width:64ch}
.case-designed h1,.case-designed h2{font-family:var(--display);font-weight:400;margin:0;line-height:.94;text-transform:uppercase;letter-spacing:-.012em;text-wrap:balance}
.case-designed h1{font-size:clamp(2.8rem,6.4vw,5.6rem)}
.case-designed h2{font-size:clamp(2.3rem,4.9vw,4.1rem)}
.case-designed h3{font-family:var(--body);font-style:italic;font-weight:600;font-size:1.16rem;line-height:1.2;margin:0;letter-spacing:-.005em}
.case-designed .kick{font-family:var(--body);font-size:.92rem;color:var(--soft)}
.case-designed .lead{font-size:1.2rem;color:var(--soft);max-width:60ch}
.case-designed .stack{display:flex;flex-direction:column;gap:20px}
.case-designed .mono{font-family:var(--body);font-size:.8rem}
.case-designed .q-kick{font-family:var(--body);font-style:normal;font-weight:400;font-size:1rem;color:var(--soft)}
.case-designed .pro{font-size:.92rem;color:var(--soft);background:var(--card);border-radius:18px;padding:14px 18px 16px;max-width:70ch}
.case-designed .dew .pro{background:rgba(255,255,255,.55)}
.case-designed .pro b{display:block;font-family:var(--hand);font-style:normal;font-weight:400;font-size:1.7rem;line-height:.9;color:var(--ink);margin-bottom:2px}
.case-designed details.more{margin-top:32px}
.case-designed details.more summary{cursor:pointer;font-family:var(--body);font-weight:600;list-style:none;display:inline-flex;gap:10px;align-items:center;padding:12px 20px;border-radius:99px;background:var(--ink);color:var(--paper)}
.case-designed details.more summary::-webkit-details-marker{display:none}
.case-designed details.more summary::after{content:"+"}
.case-designed details.more[open] summary::after{content:"-"}
.case-designed .howto{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:26px;font-size:.88rem;color:var(--soft)}
.case-designed .howto b{color:var(--ink);font-style:normal;font-weight:600}

/* key words: thick pastel outline traced around the letters */
.case-designed .cap{--hl:transparent;color:inherit}
.case-designed .cap.g,.case-designed .cap.p,.case-designed .cap.y,.case-designed .cap.v,.case-designed h1 .cap.g{color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding-inline:.04em}
.case-designed .cap.g{--hl:var(--mint)} .case-designed .cap.p{--hl:var(--lilac)} .case-designed .cap.y{--hl:var(--peach)} .case-designed .cap.v{--hl:var(--lav)}
.case-designed h1 .cap.g{--hl:var(--yel)}
.case-designed .dew .cap.g,.case-designed .dew .cap.p,.case-designed .dew .cap.y,.case-designed .dew .cap.v{--hl:#ffffff}

/* hand-written notes */
.case-designed .hand{font-family:var(--hand);font-size:2.1rem;line-height:.95;color:var(--ink);font-weight:400}
.case-designed .ann{position:absolute;display:flex;gap:4px;align-items:flex-end;pointer-events:none;z-index:2}
.case-designed .ann svg,.case-designed .hn svg,.case-designed .arrow svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .hn{display:flex;align-items:center;gap:8px;color:var(--ink)}

/* phone frames */
.case-designed .ph{position:relative;aspect-ratio:9/16;max-width:100%;border-radius:18px;overflow:hidden;background:#000}
.case-designed .ph img{width:100%;height:100%;object-fit:cover;display:block}
.case-designed .ph figcaption{position:absolute;left:8px;bottom:8px;right:8px;font-size:.7rem;color:#fff;background:rgba(0,0,0,.55);padding:4px 7px;border-radius:6px;line-height:1.3}
.case-designed figure{margin:0}

/* dew bands + black cards */
.case-designed .dew{background:var(--dew);color:var(--dew-ink);--ink:#111;--soft:#3d3f22;--card:var(--on-dew-card);--rule:rgba(17,17,17,.12)}
.case-designed .dark,.case-designed .box.dark,.case-designed .ins.dark{background:var(--stage)!important;color:var(--stage-ink);--ink:var(--stage-ink);--soft:var(--stage-soft);--rule:rgba(255,255,255,.14)}

/* cover */
.case-designed .cover{padding-block:28px 84px}
.case-designed .top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:20px}
.case-designed .logo{font-family:var(--display);font-size:1.7rem;letter-spacing:.02em}
.case-designed .cover-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center;margin-top:28px}
.case-designed .collage{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
.case-designed .collage .ph:nth-child(even){transform:translateY(28px)}
.case-designed .meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 24px;margin-top:8px}
.case-designed .meta div{display:grid;grid-template-columns:48px minmax(0,1fr);column-gap:12px;row-gap:2px;align-content:start;min-width:0;background:var(--card);border-radius:18px;padding:14px 16px}
.case-designed .meta div svg{grid-row:1 / span 2;width:48px;height:48px;fill:none;stroke:#111;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .meta div svg .blob{stroke:none}
.case-designed .meta b{font-weight:600}
.case-designed .meta span{color:var(--soft);font-size:.92rem}

/* stat strip */
.case-designed .strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--card);border-radius:var(--r);margin-top:72px}
.case-designed .strip div{padding:26px 26px 24px;border-right:1px solid var(--rule)}
.case-designed .strip div:last-child{border-right:0}
.case-designed .strip b{display:block;font-family:var(--display);font-style:italic;font-size:3.6rem;font-weight:400;line-height:.95;font-variant-numeric:tabular-nums}
.case-designed .strip span{color:var(--soft);font-size:.92rem}

/* boxes */
.case-designed .two{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.case-designed .two>*{min-width:0}
.case-designed .before-after{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.case-designed .box{background:var(--card);border-radius:var(--r);padding:26px;display:flex;flex-direction:column;gap:12px;min-width:0}
.case-designed .box p{color:var(--soft)}
.case-designed .box ul{margin:0;padding-left:0;list-style:none;color:var(--soft);display:grid;gap:10px}
.case-designed .box li{background:#ffffff;border-radius:14px;padding:10px 14px}
.case-designed .dew .box li{background:var(--card)}
.case-designed .dark li,.case-designed .box.dark li{background:rgba(255,255,255,.07)!important}
