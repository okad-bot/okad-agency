---
import Base from '../../layouts/Base.astro';
// Converted from the OKAD case artifact. Styles are scoped under .case-designed.
const title = "68 ads. Story before product. | OKAD Agency";
const description = "A European brand launched a daily longevity drink for people 40 and older. They had a launch film, a nutrition scientist on camera and a stack of creator clips. I turned that footage into a library of ads built on three things: a scientist who explains, real people with real stories, and AI...";
const ogImage = "/images/cases/longevity-supplement-story-ads/lg/l3a.jpg";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
  </Fragment>
  <div class="case-designed">




<!-- COVER -->
<section class="cover">
  <div class="w">
    <div class="cover-grid">
      <div class="stack" style="gap:24px">
        <span class="kick">European longevity supplement · Meta ads · English and German</span>
        <h1>68 ads. <span class="cap g">Story before product.</span></h1>
        <p class="lead">A European brand launched a daily longevity drink for people 40 and older. They had a launch film, a nutrition scientist on camera and a stack of creator clips. I turned that footage into a library of ads built on three things: a scientist who explains, real people with real stories, and AI b-roll and charts that show what happens inside the body. The product never shows up before the story has done its job.</p>
        <div class="meta">
          <div><b>My scope</b><span>Scripts, story structures, re-editing, AI b-roll, charts and captions, hook variations, German versions</span></div>
          <div><b>Not my scope</b><span>Media buying and the original brand shoot</span></div>
        </div>
      </div>
      <div class="vgrid" aria-label="Clips from the finished ads">
        <div class="ann hand" style="right:-6px;top:-70px">clips from the ads<svg width="70" height="60" viewBox="0 0 70 60"><path d="M6 6 C 34 2, 56 18, 60 52"/><path d="M51 44 L60 54 L66 42"/></svg></div>
        <figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/doctor.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/doctor.mp4" aria-label="The scientist + a chart"></video><figcaption class="cap-s">The scientist + a chart</figcaption></figure>
        <figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/party.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/party.mp4" aria-label="The party confession"></video><figcaption class="cap-s">The party confession</figcaption></figure>
        <figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/fifties.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/fifties.mp4" aria-label="Feeling drained at 40+"></video><figcaption class="cap-s">Feeling drained at 40+</figcaption></figure>
      </div>
    </div>
    <div class="strip">
      <div><b>68</b><span>finished ads in the English library</span></div>
      <div><b>27</b><span>scripts, each cut in up to 4 hook versions</span></div>
      <div><b>6</b><span>story formats tested</span></div>
      <div><b>2</b><span>languages, English and German</span></div>
    </div>
  </div>
</section>

<!-- Q1 -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q1 · What did I have to work with?</span>
      <h2>Good footage. <span class="cap g">No story yet.</span></h2>
      <p class="lead">The brand had already paid for a polished launch film, a day of filming with a nutrition scientist and a set of creator videos. All of it looked expensive and none of it stopped the scroll. Ads opened on a pouch and a list of 14 ingredients. People 40 and older don't buy ingredients. They buy the feeling of keeping up with their own life.</p>
    </div>
    <div class="rule-row">
      <div class="box"><span class="tag g">The scientist</span><h3>Authority on camera</h3><p>A nutrition scientist and former head of nutrition in elite cycling, filmed against a whiteboard. Perfect for explaining, too slow on his own.</p></div>
      <div class="box"><span class="tag g">The people</span><h3>Creators 40 to 60</h3><p>Moms, runners, men in their fifties, a woman who turned 49. Raw clips of real mornings, walks and kitchens.</p></div>
      <div class="box"><span class="tag g">What I added</span><h3>AI b-roll and charts</h3><p>Glowing cells, molecules, organs and simple falling charts, made for each script to show what can't be filmed.</p></div>
    </div>
  </div>
</section>

<!-- Q2 DOCTOR -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q2 · How do you make a scientist watchable?</span>
      <h2>Cut him every <span class="cap y">two and a half seconds.</span></h2>
      <p class="lead">A talking head explaining NAD+ for 36 seconds loses everyone. So I broke each of his takes into single sentences and put something to look at under every one: a chart when he says a number, a molecule when he names it, a research paper when he says "studies". He stays the voice of authority, the visuals carry the attention.</p>
    </div>
    <div class="grid-reel gr7">
      <figure><img loading="lazy" decoding="async" alt="Scientists have discovered" src="/images/cases/longevity-supplement-story-ads/lg/l3a.jpg"><figcaption class="cap-s">0 s · the claim</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="that NAD+ levels drop by 50%" src="/images/cases/longevity-supplement-story-ads/lg/l3b.jpg"><figcaption class="cap-s">3 s · a chart</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="between ages 20 and 50" src="/images/cases/longevity-supplement-story-ads/lg/l3c.jpg"><figcaption class="cap-s">5 s · the drop</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="I find NAD+ fascinating" src="/images/cases/longevity-supplement-story-ads/lg/l3d.jpg"><figcaption class="cap-s">10 s · AI molecule</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="and scientific studies show it naturally declines" src="/images/cases/longevity-supplement-story-ads/lg/l3e.jpg"><figcaption class="cap-s">15 s · the curve</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="which is why researchers study it extensively" src="/images/cases/longevity-supplement-story-ads/lg/l3f.jpg"><figcaption class="cap-s">25 s · the research</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="use 300mg daily" src="/images/cases/longevity-supplement-story-ads/lg/l3g.jpg"><figcaption class="cap-s">28 s · the dose</figcaption></figure>
    </div>
    <div class="insights">
      <div class="ins">
        <div class="quote">"Even elite athletes and Tour de France cyclists can't get everything from food alone."<small>THE CREDENTIAL AS A HOOK</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="Even elite athletes" src="/images/cases/longevity-supplement-story-ads/lg/l2a.jpg"></figure>
        <p><b>Borrowed credibility.</b> A swimmer and a cyclist open the ad before the scientist says a word about his past in elite sport.</p>
      </div>
      <div class="ins dark">
        <div class="quote">"I can tell you that most supplement companies get the dosing wrong."<small>THE ENEMY</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="most supplement companies get the dosing wrong" src="/images/cases/longevity-supplement-story-ads/lg/l2d.jpg"></figure>
        <p><b>A villain, not a pitch.</b> Close-ups of generic supplement labels under the line, then a lab shot for "every ingredient is dosed exactly".</p>
      </div>
      <div class="ins">
        <div class="quote">"That 3 PM energy crash? It's not just you."<small>THE EVERYDAY PROBLEM</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="That 3pm energy crash?" src="/images/cases/longevity-supplement-story-ads/lg/l1a.jpg"></figure>
        <p><b>Start where the viewer is.</b> A tired man at his desk, then the scientist explains why, with a falling chart under "my energy was slowly declining".</p>
      </div>
    </div>
  </div>
</section>

<!-- Q3 STORY -->
<section class="dew">
  <div class="w">
    <div class="two">
    <div class="stack">
      <span class="q-kick">Q3 · What does story-first look like?</span>
      <h2>Robert waits <span class="cap g">21 seconds for the product.</span></h2>
      <p class="lead">Robert is an active man in his fifties who has started to feel worn out. The first 20 seconds are only about him: the pickleball court, the tired kitchen, the head in his hands at the laptop, a red AI shot of what fatigue feels like inside and a chart for "it began to affect his focus". The drink comes in at second 21 as the answer. Then the ending shows him back in his life.</p>
    </div>
    <div class="vside"><figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/robert.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/robert.mp4" aria-label="The first seconds of the Robert ad"></video><figcaption class="cap-s">The first seconds of the Robert ad</figcaption></figure></div>
    </div>
    <div class="grid-reel gr8">
      <figure><img loading="lazy" decoding="async" alt="This is Robert" src="/images/cases/longevity-supplement-story-ads/lg/r0.jpg"><figcaption class="cap-s">0 s · "This is Robert"</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="who has always enjoyed staying fit" src="/images/cases/longevity-supplement-story-ads/lg/r1.jpg"><figcaption class="cap-s">4 s · who he was</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="more worn out than usual" src="/images/cases/longevity-supplement-story-ads/lg/r2.jpg"><figcaption class="cap-s">7 s · worn out</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="and the frustration of not being able to keep up" src="/images/cases/longevity-supplement-story-ads/lg/r3.jpg"><figcaption class="cap-s">11 s · can't keep up</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="He used to ignore these signs" src="/images/cases/longevity-supplement-story-ads/lg/r4.jpg"><figcaption class="cap-s">14 s · AI b-roll</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="But it began to affect his focus" src="/images/cases/longevity-supplement-story-ads/lg/r5.jpg"><figcaption class="cap-s">18 s · a chart</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="and improve his mental sharpness" src="/images/cases/longevity-supplement-story-ads/lg/r7.jpg"><figcaption class="cap-s">35 s · inside the body</figcaption></figure>
      <figure><img loading="lazy" decoding="async" alt="He has the energy to tackle his day" src="/images/cases/longevity-supplement-story-ads/lg/r8.jpg"><figcaption class="cap-s">39 s · back in his life</figcaption></figure>
    </div>
    <div class="timeline tl4">
      <div><span class="s">0 to 3 s</span><b>Hook</b><span class="q">A person or a question. "Feeling worn down even though you've always been active?"</span></div>
      <div><span class="s">3 to 16 s</span><b>Story</b><span class="q">The problem in their life, shot on real creator footage, with AI b-roll and charts for what happens inside.</span></div>
      <div><span class="s">16 s +</span><b>Product</b><span class="q">The drink arrives as the turning point of the story.</span></div>
      <div><span class="s">end</span><b>Life back</b><span class="q">The same person, now keeping up. Then the offer.</span></div>
    </div>
  </div>
</section>

<!-- Q4 FORMATS -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q4 · Which stories did I test?</span>
      <h2>Six formats, <span class="cap v">one audience.</span></h2>
      <p class="lead">Every format was written for the same person: 40 or older, still active, quietly scared of slowing down. Each script went out in three or four versions with different first lines, so the data could pick the hook.</p>
    </div>
    <div class="fmt-grid">
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="I used to live for the night" src="/images/cases/longevity-supplement-story-ads/lg/p0.jpg"></figure><span class="lbl proof">Confession</span><h3>"I used to live for the night"</h3><p>Wild parties, then a chart: "that lifestyle was aging me fast". Then a lab and glowing cells: "the real party is inside your cells".</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Have you ever wondered why your energy disappears after having a baby?" src="/images/cases/longevity-supplement-story-ads/lg/mo0.jpg"></figure><span class="lbl proof">Mom story</span><h3>"Why your energy disappears"</h3><p>A young mom, a toddler, a laptop and an espresso machine. Exhaustion everyone recognizes.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="I'm 49 and a few months ago" src="/images/cases/longevity-supplement-story-ads/lg/t0.jpg"></figure><span class="lbl native">Testimonial</span><h3>"I'm 49"</h3><p>A real age on screen, a walk of 3.5 miles, sleeping well. Then an AI body lighting up: "Now, at 49, I feel better".</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Tired, foggy and worn out?" src="/images/cases/longevity-supplement-story-ads/lg/o0.jpg"></figure><span class="lbl native">Ingredient story</span><h3>"Tired, foggy, worn out?"</h3><p>Every ingredient gets its own AI visual, so a list becomes a sequence people watch.</p></div>
    </div>
    <div class="vs">
      <div class="box">
        <span class="tag">Kinetic manifesto</span>
        <p>"We've been sold on the lie that we need endless pills." One word per cut, gym, track, kitchen, street. Built entirely from b-roll.</p>
        <div class="grid-reel gr5"><figure><img loading="lazy" decoding="async" alt="SOLD" src="/images/cases/longevity-supplement-story-ads/lg/m1.jpg"></figure><figure><img loading="lazy" decoding="async" alt="HEALTH" src="/images/cases/longevity-supplement-story-ads/lg/m2.jpg"></figure><figure><img loading="lazy" decoding="async" alt="CHOICE" src="/images/cases/longevity-supplement-story-ads/lg/m3.jpg"></figure><figure><img loading="lazy" decoding="async" alt="YOUR" src="/images/cases/longevity-supplement-story-ads/lg/m4.jpg"></figure><figure><img loading="lazy" decoding="async" alt="WITH" src="/images/cases/longevity-supplement-story-ads/lg/m5.jpg"></figure></div>
      </div>
      <div class="box dark">
        <span class="tag g dewtag">The scientist explains</span>
        <p>Five takes with the scientist became five ads: NAD+, the 3 PM crash, elite sport, why he changed his mind at 40, and too many pills.</p>
        <div class="grid-reel gr5"><figure><img loading="lazy" decoding="async" alt="Even elite athletes" src="/images/cases/longevity-supplement-story-ads/lg/l2a.jpg"></figure><figure><img loading="lazy" decoding="async" alt="and Tour de France cyclists" src="/images/cases/longevity-supplement-story-ads/lg/l2b.jpg"></figure><figure><img loading="lazy" decoding="async" alt="every detail matters" src="/images/cases/longevity-supplement-story-ads/lg/l2c.jpg"></figure><figure><img loading="lazy" decoding="async" alt="every ingredient is dosed exactly" src="/images/cases/longevity-supplement-story-ads/lg/l2e.jpg"></figure><figure><img loading="lazy" decoding="async" alt="was slowly declining" src="/images/cases/longevity-supplement-story-ads/lg/l1b.jpg"></figure></div>
      </div>
    </div>
  </div>
</section>

<!-- Q5 VISUALS -->
<section class="dew">
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q5 · How do you show energy and cells?</span>
      <h2>Charts and AI b-roll <span class="cap g">for the invisible.</span></h2>
      <p class="lead">You can't film NAD+ or a tired cell. So every abstract line got a picture. A red bar chart that falls for "drop by 50%". A curve that sinks for "naturally declines". Glowing cells for "cellular health", an orange body for "mental sharpness", a molecule for every ingredient name. Simple enough to read in half a second, strange enough to stop a thumb.</p>
      <p class="pro"><b>For marketers</b>Health claims are tightly regulated in Europe. Showing a chart of what science says about aging, then letting the person tell their own story, kept the ads clear without promising results.</p>
    </div>
    <div class="stack" style="gap:10px">
      <div class="trio"><img loading="lazy" decoding="async" alt="Chart: between ages 20 and 50" src="/images/cases/longevity-supplement-story-ads/lg/l3c.jpg"><img loading="lazy" decoding="async" alt="Curve: naturally declines" src="/images/cases/longevity-supplement-story-ads/lg/l3e.jpg"><img loading="lazy" decoding="async" alt="Chart: was slowly declining" src="/images/cases/longevity-supplement-story-ads/lg/l1b.jpg"></div>
      <div class="trio"><img loading="lazy" decoding="async" alt="AI cells: inside your cells every day" src="/images/cases/longevity-supplement-story-ads/lg/p4.jpg"><img loading="lazy" decoding="async" alt="AI body: Now, at 49, I feel better" src="/images/cases/longevity-supplement-story-ads/lg/t3.jpg"><img loading="lazy" decoding="async" alt="AI: who report more focus" src="/images/cases/longevity-supplement-story-ads/lg/l1c.jpg"></div>
      <p class="cap-s">Charts and AI b-roll as they appear inside the finished ads.</p>
    </div>
  </div>
  <div class="w"><div class="vgrid vrow"><figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/aibody.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/aibody.mp4" aria-label="AI body: &quot;your body needs the right support&quot;"></video><figcaption class="cap-s">AI body: "your body needs the right support"</figcaption></figure><figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/athletes.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/athletes.mp4" aria-label="Real people, then the AI body"></video><figcaption class="cap-s">Real people, then the AI body</figcaption></figure><figure class="vf"><video autoplay muted loop playsinline preload="none" poster="/images/cases/longevity-supplement-story-ads/lg/v/perfect.jpg" src="/images/cases/longevity-supplement-story-ads/lg/v/perfect.mp4" aria-label="A December story ad"></video><figcaption class="cap-s">A December story ad</figcaption></figure></div></div>
</section>

<!-- Q6 TIMELINE -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q6 · How did it run?</span>
      <h2>Four months, <span class="cap g">one growing library.</span></h2>
      <p class="lead">I worked month by month from September to December 2025, adding new stories each round and keeping what the client's team wanted more of.</p>
    </div>
    <div class="timeline tl3">
      <div><span class="s">September and October</span><b>Test, then stories</b><span class="q">Reverse hooks, mom stories, men in their fifties, ingredient stories, then five scientist ads, Robert and the party confession.</span></div>
      <div><span class="s">November</span><b>Creator b-roll + German</b><span class="q">Fresh lifestyle footage filmed by a creator, and German cuts of the strongest ads.</span></div>
      <div><span class="s">December</span><b>Testimonials + shorts</b><span class="q">"I'm 49" testimonials, the kinetic manifesto and short 8 to 18 second cutdowns.</span></div>
    </div>
    <div class="learn">
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Earn the product shot</h3><p>When 16 seconds of story come first, the product feels like relief, not a pitch.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Authority needs pace</h3><p>A scientist works when every sentence has its own picture. A chart for a number, a molecule for a name.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Say the age out loud</h3><p>"I'm 49", "a man in his fifties". The audience finds itself faster in a number than in an adjective.</p></div>
    </div>
  </div>
</section>

<!-- OFFER -->
<section>
  <div class="w">
    <div class="offer">
      <span class="q-kick">Q7 · What would this look like for you?</span>
      <h2>You have the footage. <span class="cap g">I'll find the story.</span></h2>
      <p class="lead">For health and supplement brands with a scientist, a launch film or a folder of creator clips that still sells like an ad. I re-edit it into story-first creatives, with charts and AI b-roll where the camera can't go.</p>
      <div class="steps">
        <div class="step"><span class="mono">step 1</span><b>Audit</b><p>Everything you've already shot.</p></div>
        <div class="step"><span class="mono">step 2</span><b>Stories</b><p>Scripts built on real people and real ages.</p></div>
        <div class="step"><span class="mono">step 3</span><b>Visuals</b><p>Charts and AI b-roll for every claim.</p></div>
        <div class="step"><span class="mono">step 4</span><b>Hooks x3</b><p>Three to four openings per script.</p></div>
        <div class="step"><span class="mono">step 5</span><b>Localize</b><p>New languages from the same cut.</p></div>
      </div>
      <div class="cta"><a class="btn" href="https://calendly.com/okad_calls/first" target="_blank" rel="noopener">Book a call</a><a class="btn" href="/#offer" style="background:#fff">10 videos · $500</a><span class="hn"><span style="flex:none"><svg width="54" height="22" viewBox="0 0 54 22"><path d="M51 12 C 36 16, 20 7, 5 11"/><path d="M13 4 L4 11 L12 18"/></svg></span><span class="hand">start here</span></span></div>
    </div>
  </div>
</section>

<p class="w case-foot">OKAD · Brand name withheld at the client's request. Frames are from the finished ads, September to December 2025.</p>


  </div>
</Base>

<style is:global>
.case-designed{margin:0;padding:0;background:#ffffff}
.case-designed img{max-width:100%}
.case-designed .case-foot{padding-block:28px 44px;color:var(--soft);font-size:.85rem;max-width:1180px}
.case-designed .cta .btn + .btn{color:#111}
.case-designed{color-scheme:light}.case-designed{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}.case-designed img{max-width:100%}.case-designed [hidden]:not([hidden=until-found i]){display:none!important}

/* OKAD house style: white page, Instrument Serif caps for headlines, Instrument Sans for reading,
   Reenie Beanie for hand-written notes with drawn arrows. Pastel outline marks the key words;
   dew-green bands and black cards create rhythm. */
.case-designed{
  --paper:#ffffff; --card:#f4f4f1; --ink:#111111; --soft:#5f5f5b; --rule:#e6e6e1;
  --dew:#eefb6e; --dew-ink:#111111; --on-dew-card:#ffffff;
  --yel:#f2fa5a; --mint:#b5f5c6; --lav:#d4d4fc; --peach:#ffe2ad; --lilac:#ecc8fa;
  --hi:var(--dew); --hi-ink:#111111; --pink:#111111;
  --c1:#8f4fd6; --c2:#17904f;
  --stage:#121114; --stage-ink:#f4f4f0; --stage-soft:#b9b9b3;
  --good:#17904f; --mid:#c98a14; --bad:#d03e3e;
  --display:"Instrument Serif","Times New Roman",serif;
  --body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --hand:"Reenie Beanie","Bradley Hand",cursive;
  --mono:var(--body);
  --r:28px;
}
.case-designed{color-scheme:light}

.case-designed *{box-sizing:border-box}
.case-designed{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
.case-designed .w{max-width:1180px;margin:0 auto;padding-inline:20px}
.case-designed section{padding-block:96px;position:relative}
.case-designed p{margin:0;max-width:64ch}
.case-designed h1,.case-designed h2{font-family:var(--display);font-weight:400;margin:0;line-height:.94;text-transform:uppercase;letter-spacing:-.012em;text-wrap:balance}
.case-designed h1{font-size:clamp(2.8rem,6.4vw,5.6rem)}
.case-designed h2{font-size:clamp(2.3rem,4.9vw,4.1rem)}
.case-designed h3{font-family:var(--body);font-style:italic;font-weight:600;font-size:1.16rem;line-height:1.2;margin:0;letter-spacing:-.005em}
