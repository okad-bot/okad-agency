---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allCases = await getCollection('cases');
const cases = allCases
  .filter(c => c.data.type === 'case' && c.data.cover)
  .sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });
---

<Base title="Cases — OKAD Agency" description="Case studies and portfolio">
  <div class="page-header page-header--left">
    <h1>Our <em>Cases</em></h1>
    <p>Design, branding, UGC, and marketing projects for global brands</p>
  </div>
  <div class="cases-listing">
    <div class="cases-grid">
      {cases.map(c => (
        <a href={`/cases/${c.id}`} class="case-list-card">
          {c.data.cover && <img src={c.data.cover} alt={c.data.coverAlt || c.data.title} loading="lazy" />}
          <div class="card-body">
            <h3>{c.data.title}</h3>
            <p>{c.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
