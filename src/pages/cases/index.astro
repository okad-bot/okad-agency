---
import Base from '../../layouts/Base.astro';
import '../../styles/okad-house.css';
import { getCollection } from 'astro:content';

const allCases = await getCollection('cases');
const cases = allCases
  .filter(c => c.data.type === 'case' && c.data.cover)
  .sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).getTime() : 0;
    const db = b.data.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });

const featuredIds = [
  'creative-testing-ai-app-meta-ads',
  'womens-health-supplement-ads',
  'zentoes-walmart-launch-ads',
  'dating-com-creator-content',
];

const ugcIds = [
  'high-roas-ugc-ads',
  'high-converting-video-ads-for-dtc-brands',
  'ugc-creators-over-45',
  'alcohol-ugc-content',
  'lookalikey-ugc-ads',
  'organic-video-content-1m-views',
  'static-ad-creatives-digital-products',
  'case-flipsystem-creatives',
  'case-uprest',
  'case-tisa-school',
  'case-cyberpulse',
  'case-cosmowiki',
  'case-upstream',
  'case-robbo-scholl',
  'case-book-club',
];

const featured = featuredIds.map(id => cases.find(c => c.id === id)).filter(Boolean);
const ugc = ugcIds.map(id => cases.find(c => c.id === id)).filter(Boolean);
const usedIds = new Set([...featuredIds, ...ugcIds]);
const design = cases.filter(c => !usedIds.has(c.id));

const newCases = [
  { title: 'Baby Furniture AI Product Visuals', desc: 'AI-generated lifestyle shots from customer photos — no studio, no shipping.', href: '/cases/baby-furniture-ai-product-visuals', img: '/images/cases/ai-app-designed/img-29.jpg' },
  { title: 'Christian Dating App UGC & B-roll', desc: '60 videos a month, 800K-view Reel, B-roll library for a dating app.', href: '/cases/christian-dating-app-ugc-broll', img: '/images/cases/dating-com-creator-content/img-05.jpg' },
  { title: 'Collectibles Store Video Content', desc: 'Video content factory for an e-commerce collectibles brand.', href: '/cases/collectibles-store-video-content-factory', img: '/images/cases/high-roas-ugc-ads.jpg' },
  { title: 'Drawing App Faceless UGC', desc: 'Canvas-style content that reached 1.5M organic views.', href: '/cases/drawing-app-faceless-ugc', img: '/images/cases/organic-video-content-1m-views.jpg' },
  { title: 'EdTech App UGC & Social Content', desc: 'UGC ads and social content for an education platform.', href: '/cases/edtech-app-ugc-social-content', img: '/images/cases/static-ad-creatives-digital-products.png' },
  { title: 'Supplement UGC Ad Testing', desc: '16 creator videos → 48 hook versions. Problem-callout hooks won by 40%.', href: '/cases/supplement-ugc-ad-testing', img: '/images/cases/womens-health-supplement-ads/img-03.jpg' },
  { title: 'Canvas & Tech UGC Without New Shoots', desc: 'Turning existing footage and screen recordings into new ads.', href: '/cases/canvas-tech-ugc-without-new-shoots/', img: '/images/cases/ai-app/ai-app-10.webp' },
];
---

<Base title="Cases — UGC Video Ads, Design & Branding | OKAD" description="Case studies from 100+ brands: UGC video ads, creative testing, web design, branding. Real numbers, real results.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
  </Fragment>

  <div class="okh">

    <!-- HERO -->
    <section class="khero" style="padding:80px 0 32px">
      <div class="w" style="max-width:1100px">
        <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);margin-bottom:16px">Real work, <span class="cap">real numbers</span></h1>
        <p class="lead">UGC video ads, creative testing, web design, branding — case studies from 100+ brands with actual results.</p>
      </div>
    </section>

    <!-- FILTER CHIPS -->
    <div style="max-width:1100px;margin:0 auto;padding:0 24px 40px">
      <div class="filter-chips">
        <button class="chip active" data-filter="all">All</button>
        <button class="chip" data-filter="ugc">UGC & Video</button>
        <button class="chip" data-filter="design">Design & Branding</button>
        <button class="chip" data-filter="latest">Latest</button>
      </div>
    </div>

    <!-- FEATURED UGC CASES -->
    <section data-category="ugc" style="max-width:1100px;margin:0 auto;padding:0 24px 48px">
      <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:20px">
        {featured.map(c => (
          <a href={`/cases/${c.id}`} style="display:block;border-radius:16px;overflow:hidden;border:1px solid var(--border,#e6e6e6);transition:box-shadow .2s;text-decoration:none;color:inherit" class="case-card-hover">
            <img src={c.data.cover} alt={c.data.coverAlt || c.data.title} loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;display:block" />
            <div style="padding:20px 24px">
              <h3 style="font-size:18px;font-weight:600;margin-bottom:8px;letter-spacing:-0.2px">{c.data.title}</h3>
              <p style="font-size:14px;color:var(--soft,#4d4d49);line-height:1.5;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{c.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- NEW CASES (flat HTML) -->
    <section data-category="latest" style="max-width:1100px;margin:0 auto;padding:0 24px 48px">
      <h2 style="font-size:clamp(1.3rem,2.5vw,1.8rem);margin-bottom:24px">Latest <span class="cap g">cases</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        {newCases.map(c => (
          <a href={c.href} style="display:block;border-radius:14px;overflow:hidden;border:1px solid var(--border,#e6e6e6);transition:box-shadow .2s;text-decoration:none;color:inherit" class="case-card-hover">
            <img src={c.img} alt={c.title} loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;display:block" />
            <div style="padding:16px 20px">
              <h3 style="font-size:15px;font-weight:600;margin-bottom:6px">{c.title}</h3>
              <p style="font-size:13px;color:var(--soft,#4d4d49);line-height:1.5;margin:0">{c.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- MORE UGC & VIDEO CASES -->
    <section data-category="ugc" style="max-width:1100px;margin:0 auto;padding:0 24px 48px">
      <h2 style="font-size:clamp(1.3rem,2.5vw,1.8rem);margin-bottom:24px">UGC & <span class="cap y">video ads</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        {ugc.map(c => (
          <a href={`/cases/${c.id}`} style="display:block;border-radius:14px;overflow:hidden;border:1px solid var(--border,#e6e6e6);transition:box-shadow .2s;text-decoration:none;color:inherit" class="case-card-hover">
            <img src={c.data.cover} alt={c.data.coverAlt || c.data.title} loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;display:block" />
            <div style="padding:16px 20px">
              <h3 style="font-size:15px;font-weight:600;margin-bottom:6px">{c.data.title}</h3>
              <p style="font-size:13px;color:var(--soft,#4d4d49);line-height:1.5;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{c.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- DESIGN & BRANDING CASES -->
    <section data-category="design" style="max-width:1100px;margin:0 auto;padding:0 24px 80px">
      <h2 style="font-size:clamp(1.3rem,2.5vw,1.8rem);margin-bottom:24px">Design & <span class="cap p">branding</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px">
        {design.map(c => (
          <a href={`/cases/${c.id}`} style="display:block;border-radius:14px;overflow:hidden;border:1px solid var(--border,#e6e6e6);transition:box-shadow .2s;text-decoration:none;color:inherit" class="case-card-hover">
            <img src={c.data.cover} alt={c.data.coverAlt || c.data.title} loading="lazy" style="width:100%;aspect-ratio:16/10;object-fit:cover;display:block" />
            <div style="padding:16px 20px">
              <h3 style="font-size:15px;font-weight:600;margin-bottom:6px">{c.data.title}</h3>
              <p style="font-size:13px;color:var(--soft,#4d4d49);line-height:1.5;margin:0;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden">{c.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--stage,#111);padding:80px 24px;text-align:center">
      <div style="max-width:700px;margin:0 auto">
        <h2 style="color:#fff;font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:16px">Want results like these?</h2>
        <p style="color:var(--stage-soft,#8e8e8e);margin-bottom:32px">Start with 10 videos for $500, no call needed. Or book a call to discuss a bigger plan.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a class="btn" href="/#offer">Order 10 videos &middot; $500</a>
          <a class="btn dew" href="https://calendly.com/okad_calls/first" target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

  </div>

  <style>
    .filter-chips {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .chip {
      padding: 8px 20px;
      border-radius: 100px;
      border: 1px solid var(--border, #e6e6e6);
      background: #fff;
      font-size: 14px;
      font-weight: 500;
      color: var(--soft, #4d4d49);
      cursor: pointer;
      transition: all 0.2s;
      font-family: inherit;
    }
    .chip:hover {
      border-color: #111;
      color: #111;
    }
    .chip.active {
      background: #111;
      color: #fff;
      border-color: #111;
    }
    .case-card-hover:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    [data-category] { transition: opacity 0.25s, max-height 0.3s; }
    [data-category].hidden-section {
      display: none;
    }
    @media (max-width: 640px) {
      section > div[style*="repeat(2,1fr)"] { grid-template-columns: 1fr !important; }
    }
  </style>

  <script>
    document.querySelectorAll('.chip').forEach(chip => {
      chip.addEventListener('click', () => {
        document.querySelector('.chip.active')?.classList.remove('active');
        chip.classList.add('active');
        const filter = chip.dataset.filter;
        document.querySelectorAll('[data-category]').forEach(section => {
          if (filter === 'all' || section.dataset.category === filter) {
            section.classList.remove('hidden-section');
          } else {
            section.classList.add('hidden-section');
          }
        });
      });
    });
  </script>
</Base>
