---
import Base from '../../layouts/Base.astro';
// Converted from the OKAD case artifact. Styles are scoped under .case-designed.
const title = "One story per person. Four hooks each. Zero reshoots. | OKAD Agency";
const description = "A supplement brand in a strictly moderated health category needed video ads that show what to scale, not just look good. We turned their full brand analytics into a 12-video test and edited it from footage they already had.";
const ogImage = "/images/cases/womens-health-supplement-ads/img-01.jpg";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
  </Fragment>
  <div class="case-designed">





<!-- COVER -->
<section class="cover">
  <div class="w">
    <div class="cover-grid">
      <div class="stack" style="gap:24px">
        <span class="kick">Women's health supplement · DTC · Meta ads</span>
        <h1>One story per person. <span class="cap g">Four hooks each.</span> Zero reshoots.</h1>
        <p class="lead">A supplement brand in a strictly moderated health category needed video ads that show what to scale, not just look good. We turned their full brand analytics into a 12-video test and edited it from footage they already had.</p>
        <div class="meta">
          <div><b>September 2026</b><span>Test batch, round 1</span></div>
          <div><b>2 UGC creators</b><span>4 hooks each, 9:16, 86–96 s</span></div>
          <div><b>Our scope</b><span>Research, angles, scripts, approval doc, editing, sound, graphics</span></div>
          <div><b>Not our scope</b><span>Filming and media buying: the client shot and runs the ads</span></div>
        </div>
      </div>
      <div class="collage" aria-label="Hooks from the test">
        <div class="ann hand" style="right:-6px;top:-74px">real frames from the ads<svg width="70" height="60" viewBox="0 0 70 60"><path d="M6 6 C 34 2, 56 18, 60 52"/><path d="M51 44 L60 54 L66 42"/></svg></div>
        <figure class="ph"><img alt="Creator 2 with hair-loss overlay" src="/images/cases/womens-health-supplement-ads/img-01.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Creator 1, head in hands at laptop" src="/images/cases/womens-health-supplement-ads/img-02.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Creator 2 with two-options card" src="/images/cases/womens-health-supplement-ads/img-03.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Creator 1, tired with phone" src="/images/cases/womens-health-supplement-ads/img-04.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Cascade graphic: stress to symptoms" src="/images/cases/womens-health-supplement-ads/img-05.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Creator 1 talking to camera" src="/images/cases/womens-health-supplement-ads/img-06.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Creator 2 with camera-off card" src="/images/cases/womens-health-supplement-ads/img-07.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Creator 1 outdoors" src="/images/cases/womens-health-supplement-ads/img-08.jpg" loading="lazy"></figure>
      </div>
    </div>
    <div class="strip">
      <div><b>12</b><span>videos delivered for the test</span></div>
      <div><b>2</b><span>creators, one story each, hooks swapped in the edit</span></div>
      <div><b>+4</b><span>founder videos rebuilt from existing footage</span></div>
      <div><b>0</b><span>reshoots, licensed tracks or stock sounds</span></div>
    </div>
    <div class="howto"><span><b>Hook</b> = the first seconds that make people stop scrolling.</span><span><b>Body</b> = the main part, shared by all four hooks.</span><span><b>Angle</b> = the reason to care that a video tests.</span></div>
  </div>
</section>

<!-- Q1 -->
<section>
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q1 · Why not just make a few good videos?</span>
      <h2>Because a nice video <span class="cap p">doesn't tell you what to scale.</span></h2>
      <p class="lead">The brand sells a daily hormone-support supplement through paid Meta traffic. Its best ads were raw founder and customer stories. Now it needed a test that shows which opening works, and every line had to pass Meta's rules for health ads.</p>
      <p class="pro"><b>For marketers</b>Hook isolation needs identical bodies; 3 angles pre-validated by the client's ad data; no cure or treatment claims anywhere.</p>
    </div>
    <div class="before-after">
      <div class="box before">
        <span class="tag">What we got</span>
        <ul>
          <li>A survey of 834 customers and persona research</li>
          <li>10 best-performing past ads</li>
          <li>Long continuous takes, full of pauses</li>
          <li>Founder voiceover recorded apart from her video</li>
        </ul>
      </div>
      <div class="box dark">
        <span class="tag g">The brief</span>
        <ul>
          <li>2 creators × 4 hooks, plus founder videos</li>
          <li>Hooks built on the 3 angles that already sell</li>
          <li>Every story follows the beats of past winners</li>
          <li>"Feeling like yourself again" as the through-line</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Q2 RESEARCH -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q2 · How do you know what to say?</span>
      <h2>We started with <span class="cap g">what 834 customers already told the brand.</span></h2>
      <p class="lead">The client handed over everything: survey results, personas, the founder's story, product facts, brand voice, the creator guide and their winning ads. We read all of it before writing a line.</p>
      <p class="pro"><b>For marketers</b>10 winners transcribed and broken down by hook type, angle, emotion and where the product enters; our own early ideas checked against the brief, weak ones cut.</p>
    </div>
    <div class="sources">
      <div class="box"><span class="tag g">1 · We read</span><h3>Everything the brand knows</h3><p>Customer survey, personas, founder story, product facts, brand voice and the creator guide.</p></div>
      <div class="box"><span class="tag g">2 · We decode</span><h3>Why the winners won</h3><p>Ten past ads transcribed: which hooks stop people, which emotions carry, when the product appears.</p></div>
      <div class="box"><span class="tag g">3 · We write</span><h3>Scripts in customers' words</h3><p>Every beat and hook points back to something a real customer said.</p></div>
    </div>
    <div class="insights">
      <div class="ins">
        <div class="quote">"I want to feel like myself again."<small>#1 PHRASE IN THE SURVEY · 147 MENTIONS</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img alt="Creator 2 talking to camera" src="/images/cases/womens-health-supplement-ads/img-09.jpg" loading="lazy"></figure>
        <p><b>Every story ends on getting yourself back, not on a symptom score.</b> The endings are small, visible moments: the camera back on, the open collar, feeling like herself by week 8.</p>
      </div>
      <div class="ins dark">
        <div class="quote">Doctors who couldn't figure it out.<small>STRONGEST EMOTION ACROSS THE WINNING ADS</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img alt="Creator 2 with acne photo overlay" src="/images/cases/womens-health-supplement-ads/img-10.jpg" loading="lazy"></figure>
        <p><b>"Who failed her" became a beat of its own.</b> Not a vague "nobody listened", but named specialists and named prescriptions, so viewers recognise their own path.</p>
      </div>
      <div class="ins">
        <div class="quote">"Too many pills."<small>#1 REASON BUYERS LEFT OTHER BRANDS · 64 MENTIONS</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img alt="Creator 1 reading phone" src="/images/cases/womens-health-supplement-ads/img-11.jpg" loading="lazy"></figure>
        <p><b>The product never shows up as "one more supplement".</b> It enters as the thing that replaces the stack. 81% of customers said simplicity is what they value most.</p>
      </div>
    </div>
  </div>
</section>

<!-- Q3 MATRIX -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q3 · Why 12 videos?</span>
      <h2>3 stories × 4 hooks = <span class="cap g">12 tests for the price of 3.</span></h2>
      <p class="lead">Each creator films her story once. Four different openings are cut in during the edit. Inside each group the main part is exactly the same, so the test compares openings, not editing accidents. The founder's videos were rebuilt the same way.</p>
      <p class="pro"><b>For marketers</b>Creator angle coverage: root cause ×3, undiagnosed ×2, diagnosis and its mechanism ×2, identity ×1. All three angles from the brief covered.</p>
    </div>
    <details class="more"><summary>See the 8 creator hooks</summary>
    <div class="mx-wrap">
      <table class="mx">
        <thead><tr><th scope="col">Video</th><th scope="col">Angle</th><th scope="col">Hook (shortened)</th></tr></thead>
        <tbody>
          <tr><td>Creator 1.1</td><td>Diagnosis</td><td class="h">"My doctor put me on birth control 'for my PCOS' and told me to give it three months."</td></tr>
          <tr><td>Creator 1.2</td><td>Root cause</td><td class="h">"Ask your gynecologist the words: insulin resistance. If she just shrugs…"</td></tr>
          <tr><td>Creator 1.3</td><td>Undiagnosed</td><td class="h">"I loaded six years of my labs into ChatGPT. It answered in 40 seconds with one word."</td></tr>
          <tr><td>Creator 1.4</td><td>Root cause</td><td class="h">"'Eat less, move more.' Turns out my insulin doesn't work."</td></tr>
          <tr><td>Creator 2.1</td><td>Identity</td><td class="h">"I didn't know that same day was going to break my body."</td></tr>
          <tr><td>Creator 2.2</td><td>Diagnosis</td><td class="h">"Have a baby right now, or take the pill until menopause. I'm 29."</td></tr>
          <tr><td>Creator 2.3</td><td>Root cause</td><td class="h">"'Take a long leave, it's just stress.' Not in month four of the job I chased for eight years."</td></tr>
          <tr><td>Creator 2.4</td><td>Undiagnosed</td><td class="h">"Four months into my promotion I started turning my camera off on every call."</td></tr>
          <tr><td colspan="3" style="color:var(--soft);font-weight:400">+ 4 founder videos, rebuilt from existing footage with the same hook-and-body structure</td></tr>
        </tbody>
      </table>
    </div>
    </details>
    <div class="chips">
      <span class="chip"><b>3</b> angles from the client's ad data</span>
      <span class="chip"><b>4</b> hooks per story</span>
      <span class="chip"><b>1</b> body per creator, filmed once</span>
      <span class="chip"><b>4</b> rounds of hook rewrites</span>
      <span class="chip"><b>5</b>-point audit before sending</span>
    </div>
  </div>
</section>

<!-- Q4 BEATS -->
<section class="dew">
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q4 · What does every story have to hit?</span>
      <h2>Five beats, <span class="cap g">taken from the ads that already sold.</span></h2>
      <p class="lead">The client asked for stories built on the beats of their winning ads. We mapped those beats and wrote every story to the same skeleton, then sharpened the hooks with real, specific details.</p>
    </div>
    <div class="stack">
      <div class="hooks">
        <div class="box dark"><span class="tag g dewtag">Details we added</span>
          <ul class="hook-list">
            <li>Hair coming out in clumps</li>
            <li>Camera off on every call</li>
            <li>Down to three hoodies in the closet</li>
            <li>Labs read by AI in 40 seconds</li>
            <li>A choice of two options, neither of them hers</li>
          </ul>
        </div>
        <div class="box plain"><span class="tag">Checked before sending</span>
          <ul class="hook-list">
            <li>Matches the brief</li>
            <li>Believable and logical</li>
            <li>Has potential to win</li>
            <li>Length close to winners</li>
            <li>Hook leads into the body</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="w">
    <div class="timeline" aria-label="Story structure">
      <div><span class="s">beat 1</span><b>One pain</b><span class="q">"Six years. Chin acne that no facewash touched."</span></div>
      <div><span class="s">beat 2</span><b>Who didn't help</b><span class="q">"The dermatologist said acne. The gynecologist said stress."</span></div>
      <div><span class="s">beat 3</span><b>The real cause</b><span class="q">"Stress raises cortisol. Cortisol breaks your insulin sensitivity."</span></div>
      <div><span class="s">beat 4</span><b>One instead of many</b><span class="q">"Her whole list, in one sachet."</span></div>
      <div><span class="s">beat 5</span><b>Result and hope</b><span class="q">"Week 10, first regular cycle in a year. Month 3, camera back on."</span></div>
    </div>
  </div>
</section>

<!-- Q5 CASTING -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q5 · Who tells which story?</span>
      <h2>Each creator tells <span class="cap p">the story her audience lives.</span></h2>
      <p class="lead">We didn't give both creators the same script with a different face. Each story was written for a real customer group from the research, so viewers recognise themselves in the first seconds.</p>
      <p class="pro"><b>For marketers</b>Creator 1 maps to the diagnosed persona (51% of buyers, clinical language, "insulin resistance"); Creator 2 to the burnout pathway ("running on empty", corporate roles).</p>
    </div>
    <div class="cast">
      <div class="person">
        <figure class="ph"><img alt="Creator 1 pointing" src="/images/cases/womens-health-supplement-ads/img-12.jpg" loading="lazy"></figure>
        <div class="stack" style="gap:6px"><span class="kick">Diagnosed, still stuck</span><h3>Creator 1</h3><ul><li>8 doctors, 8 diagnoses</li><li>Her labs decoded by AI</li><li>Off the pill only with her doctor</li></ul></div>
      </div>
      <div class="person">
        <figure class="ph"><img alt="Creator 2" src="/images/cases/womens-health-supplement-ads/img-13.jpg" loading="lazy"></figure>
        <div class="stack" style="gap:6px"><span class="kick">Career woman, burnt out</span><h3>Creator 2</h3><ul><li>Promotion, then the camera goes off</li><li>Two options she refused</li><li>Stress → hormones, explained</li></ul></div>
      </div>
    </div>
  </div>
</section>

<!-- Q6 SAFETY -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q6 · Can you even advertise this on Meta?</span>
      <h2>Yes, as long as no line <span class="cap g">promises a cure.</span></h2>
      <p class="lead">Health is one of the most restricted ad categories. Safety was built into the scripts from the first draft, not fixed in moderation.</p>
    </div>
    <div class="rule-row">
      <div class="box"><span class="tag g">Rule 1</span><h3>No cure language</h3><p>Stories describe how someone feels, never what the product treats.</p></div>
      <div class="box"><span class="tag g">Rule 2</span><h3>Said out loud</h3><p>"It doesn't replace your doctor. It's not a treatment." Spoken in the video, not hidden in the caption.</p></div>
      <div class="box"><span class="tag g">Rule 3</span><h3>Doctor in the loop</h3><p>Any change to medication happens "under her supervision", never on the viewer's own.</p></div>
    </div>
    <div class="box" style="margin-top:14px">
      <span class="tag hand-lbl">approval</span>
      <h3>One round of comments</h3>
      <p>The client got a short doc: batch structure, angle matrix, full hooks, bodies as beats and in full. Their edits were minor wording, made in the same doc with comments kept.</p>
    </div>
  </div>
</section>

<!-- Q7 PRODUCTION -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q7 · How do you make four hooks a fair test?</span>
      <h2>We edit in code, <span class="cap g">so only the hook changes.</span></h2>
      <p class="lead">The edit is written frame by frame, not dragged on a timeline. The main part is rendered once, and each variant is the hook joined to it without re-encoding. Four files, one identical body, and a fix in the body is one rebuild instead of four.</p>
      <p class="pro"><b>For marketers</b>[hook]+[body] stream-copy concat on a forced keyframe; bodies byte-identical across variants; every segment's frame count checked against the plan.</p>
    </div>
    <div class="variants" aria-label="Four variants share one body">
      <div class="vrow"><div class="vh a">Hook A</div><div class="vb">Same body<span>86–96 s</span></div></div>
      <div class="vrow"><div class="vh b">Hook B</div><div class="vb">Same body<span>byte for byte</span></div></div>
      <div class="vrow"><div class="vh c">Hook C</div><div class="vb">Same body<span>byte for byte</span></div></div>
      <div class="vrow"><div class="vh d">Hook D</div><div class="vb">Same body<span>byte for byte</span></div></div>
    </div>
    <div class="kpis light">
      <div class="kpi"><small>lip-sync</small><b>0.10–0.26 s</b><span>worst gap between lips and voice where the voice was recorded apart from the video. Simple stretching gave 0.89 s.</span></div>
      <div class="kpi"><small>sound vs picture</small><b>≤0.09 s</b><span>max drift. Building the timeline from 19 audio files as delivered would have pushed the voice 0.70 s ahead.</span></div>
      <div class="kpi"><small>loudness</small><b>−14 LUFS</b><span>the level of the feed. The raw videos sat at −28, about half as loud as everything around them.</span></div>
    </div>
    <details class="more"><summary>See how the edit was engineered</summary>
      <div class="eng">
        <div class="box"><h3>Pauses cut by speech, not by eye</h3><p>Gaps over 0.45 s shrink to 0.22 s: still a breath, not a hole. A map of original time to edit time drives every B-roll, caption and graphic.</p></div>
        <div class="box"><h3>Lip-sync in three steps</h3><p>Word-level alignment at 10 ms, matching words in order so short words don't latch onto the wrong spot, then a smooth time-warp with a knot every ~2 s so motion never jitters.</p></div>
        <div class="box"><h3>A hidden offset, found and fixed</h3><p>In every talking-head clip the picture started 0.2–0.8 s after the sound. Measured clip by clip; the missing frames went to the previous B-roll shot.</p></div>
        <div class="box"><h3>Two shots no warp could save</h3><p>Replaced with pop-up cards on a clean background that land exactly on their word, so the meaning reads with sound off.</p></div>
        <div class="box"><h3>Mastering without delay</h3><p>The standard limiter adds 5 ms of lookahead and shifts the track. Peaks are tamed by a gain curve instead, and checked again after AAC encoding.</p></div>
        <div class="box"><h3>Picture never re-encoded</h3><p>Every sound fix is a remux with the video copied. Delivery: 1.4 GB in 74 parts, rebuilt on the client side, 8 of 8 matched by checksum.</p></div>
      </div>
    </details>
  </div>
</section>

<!-- Q8 SOUND & SCREEN -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q8 · What about music, captions and graphics?</span>
      <h2>Nothing borrowed, <span class="cap y">so the ads can run for months.</span></h2>
      <p class="lead">The client's music reference came from a free library, and those licences almost always forbid paid ads. So we made everything ourselves.</p>
    </div>
    <div class="rule-row">
      <div class="box"><span class="tag">Music</span><h3>Written from scratch</h3><p>Same tempo, key and mood as the reference, no samples inside. It drops under the voice and opens up between lines.</p></div>
      <div class="box"><span class="tag">Graphics</span><h3>In the product's colours</h3><p>Picked with an eyedropper from the product footage, so overlays match the pack in the frame.</p></div>
      <div class="box"><span class="tag">Captions</span><h3>Built for sound-off</h3><p>Readable on any background, broken by real text width, a number never split from what it counts.</p></div>
    </div>
    <div class="hn" style="justify-content:flex-end;margin-top:14px"><svg style="transform:scaleX(-1)" width="60" height="46" viewBox="0 0 60 46"><path d="M4 42 C 26 42, 34 10, 54 6"/><path d="M45 1 L55 6 L47 13"/></svg><span class="hand">sound effects synthesised too</span></div>
    <div class="reel"><figure class="ph"><img alt="Cascade step 1" src="/images/cases/womens-health-supplement-ads/img-14.jpg" loading="lazy"><figcaption>Cards build word by word</figcaption></figure><figure class="ph"><img alt="Cascade step 3" src="/images/cases/womens-health-supplement-ads/img-15.jpg" loading="lazy"><figcaption>…in the product palette</figcaption></figure><figure class="ph"><img alt="Cascade final" src="/images/cases/womens-health-supplement-ads/img-05.jpg" loading="lazy"><figcaption>…ending on the spoken word</figcaption></figure><figure class="ph"><img alt="Hair overlay" src="/images/cases/womens-health-supplement-ads/img-16.jpg" loading="lazy"><figcaption>Proof shown, not told</figcaption></figure><figure class="ph"><img alt="Camera off" src="/images/cases/womens-health-supplement-ads/img-17.jpg" loading="lazy"><figcaption>Native UI, not a banner</figcaption></figure><figure class="ph"><img alt="Option card" src="/images/cases/womens-health-supplement-ads/img-18.jpg" loading="lazy"><figcaption>Lands on the spoken word</figcaption></figure></div>
  </div>
</section>

<!-- Q9 RESULTS -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q9 · What did the client get?</span>
      <h2>Twelve finished videos, <span class="cap g">each one a clean test.</span></h2>
      <p class="lead">Two creators with four hooks each, plus four founder videos rebuilt from footage the brand already had. Every video checks one angle and one opening, so after the test the brand knows what to scale.</p>
    </div>
    <div class="kpis">
      <div class="kpi"><b>12</b><span>videos delivered: 8 creator + 4 founder, 1080×1920, 86–96 s.</span></div>
      <div class="kpi"><b>0</b><span>reshoots, and no licensed assets in sound or graphics: nothing to clear, credit or renew.</span></div>
      <div class="kpi"><b>1 rebuild</b><span>is what a fifth hook or a new market costs. Not a new project.</span></div>
    </div>
    <div class="hn" style="justify-content:flex-end;margin-top:14px"><svg style="transform:scaleX(-1)" width="60" height="46" viewBox="0 0 60 46"><path d="M4 42 C 26 42, 34 10, 54 6"/><path d="M45 1 L55 6 L47 13"/></svg><span class="hand">ad results come after launch</span></div>
  </div>
</section>

<!-- OFFER -->
<section style="border-top:0">
  <div class="w">
    <div class="offer">
      <span class="q-kick">Q10 · What would this look like for you?</span>
      <h2>You bring the brand data. <span class="cap g">We turn it into a test.</span></h2>
      <p class="lead">For DTC brands in women's health (hormones, menopause, fertility, skin, digestion) that sell on Meta and TikTok and keep hitting health-ad limits.</p>
      <div class="steps">
        <div class="step"><span class="mono">step 1</span><b>Research</b><p>Your survey, reviews, personas and winning ads.</p></div>
        <div class="step"><span class="mono">step 2</span><b>Test plan</b><p>3 stories × 4 hooks across your proven angles.</p></div>
        <div class="step"><span class="mono">step 3</span><b>Scripts</b><p>Meta-safe, approved in one round of comments.</p></div>
        <div class="step"><span class="mono">step 4</span><b>Edit</b><p>From your footage, founder lip-sync, AI voice when needed.</p></div>
        <div class="step"><span class="mono">step 5</span><b>Delivery</b><p>12 variants, no licences, rebuild-ready.</p></div>
      </div>
      <div class="cta"><a class="btn" href="https://okad.agency" target="_blank" rel="noopener">Book a call · okad.agency</a><span class="hn"><span style="flex:none"><svg width="54" height="22" viewBox="0 0 54 22"><path d="M51 12 C 36 16, 20 7, 5 11"/><path d="M13 4 L4 11 L12 18"/></svg></span><span class="hand">start here</span></span></div>
    </div>
  </div>
</section>

<footer class="w">OKAD · Lisbon · Client anonymised. Survey figures come from the client's customer research (n = 834). Hooks are quoted from the approved scripts, 2026.</footer>

  </div>
</Base>

<style is:global>
.case-designed{margin:0;padding:0;background:#ffffff}
.case-designed img{max-width:100%}
.case-designed{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}.case-designed{scroll-padding-top:env(safe-area-inset-top,0px)}

/* OKAD house style: white page, Instrument Serif caps for headlines, Instrument Sans for reading,
   Reenie Beanie for hand-written notes with drawn arrows. Pastel outline marks the key words;
   dew-green bands and black cards create rhythm. */
.case-designed{
  --paper:#ffffff; --card:#f4f4f1; --ink:#111111; --soft:#5f5f5b; --rule:#e6e6e1;
  --dew:#eefb6e; --dew-ink:#111111; --on-dew-card:#ffffff;
  --yel:#f2fa5a; --mint:#b5f5c6; --lav:#d4d4fc; --peach:#ffe2ad; --lilac:#ecc8fa;
  --hi:var(--dew); --hi-ink:#111111; --pink:#111111;
  --c1:#8f4fd6; --c2:#17904f;
  --stage:#121114; --stage-ink:#f4f4f0; --stage-soft:#b9b9b3;
  --good:#17904f; --mid:#c98a14; --bad:#d03e3e;
  --display:"Instrument Serif","Times New Roman",serif;
  --body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --hand:"Reenie Beanie","Bradley Hand",cursive;
  --mono:var(--body);
  --r:28px;
}
.case-designed{color-scheme:light}

.case-designed *{box-sizing:border-box}
.case-designed{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
.case-designed .w{max-width:1180px;margin:0 auto;padding-inline:20px}
.case-designed section{padding-block:96px;position:relative}
.case-designed p{margin:0;max-width:64ch}
.case-designed h1,.case-designed h2{font-family:var(--display);font-weight:400;margin:0;line-height:.94;text-transform:uppercase;letter-spacing:-.012em;text-wrap:balance}
.case-designed h1{font-size:clamp(2.8rem,6.4vw,5.6rem)}
.case-designed h2{font-size:clamp(2.3rem,4.9vw,4.1rem)}
.case-designed h3{font-family:var(--body);font-style:italic;font-weight:600;font-size:1.16rem;line-height:1.2;margin:0;letter-spacing:-.005em}
.case-designed .kick{font-family:var(--body);font-size:.92rem;color:var(--soft)}
.case-designed .lead{font-size:1.2rem;color:var(--soft);max-width:60ch}
.case-designed .stack{display:flex;flex-direction:column;gap:20px}
.case-designed .mono{font-family:var(--body);font-size:.8rem}
.case-designed .q-kick{font-family:var(--body);font-style:normal;font-weight:400;font-size:1rem;color:var(--soft)}
.case-designed .pro{font-size:.92rem;color:var(--soft);background:var(--card);border-radius:18px;padding:14px 18px 16px;max-width:70ch}
.case-designed .dew .pro{background:rgba(255,255,255,.55)}
.case-designed .pro b{display:block;font-family:var(--hand);font-style:normal;font-weight:400;font-size:1.7rem;line-height:.9;color:var(--ink);margin-bottom:2px}
.case-designed details.more{margin-top:32px}
.case-designed details.more summary{cursor:pointer;font-family:var(--body);font-weight:600;list-style:none;display:inline-flex;gap:10px;align-items:center;padding:12px 20px;border-radius:99px;background:var(--ink);color:var(--paper)}
.case-designed details.more summary::-webkit-details-marker{display:none}
.case-designed details.more summary::after{content:"+"}
.case-designed details.more[open] summary::after{content:"–"}
.case-designed .howto{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:26px;font-size:.88rem;color:var(--soft)}
.case-designed .howto b{color:var(--ink);font-style:normal;font-weight:600}

/* key words: thick pastel outline traced around the letters */
.case-designed .cap{--hl:transparent;color:inherit}
.case-designed .cap.g,.case-designed .cap.p,.case-designed .cap.y,.case-designed .cap.v,.case-designed h1 .cap.g{color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding-inline:.04em}
.case-designed .cap.g{--hl:var(--mint)} .case-designed .cap.p{--hl:var(--lilac)} .case-designed .cap.y{--hl:var(--peach)} .case-designed .cap.v{--hl:var(--lav)}
.case-designed h1 .cap.g{--hl:var(--yel)}
.case-designed .dew .cap.g,.case-designed .dew .cap.p,.case-designed .dew .cap.y,.case-designed .dew .cap.v{--hl:#ffffff}

/* hand-written notes */
.case-designed .hand{font-family:var(--hand);font-size:2.1rem;line-height:.95;color:var(--ink);font-weight:400}
.case-designed .ann{position:absolute;display:flex;gap:4px;align-items:flex-end;pointer-events:none;z-index:2}
.case-designed .ann svg,.case-designed .hn svg,.case-designed .arrow svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .hn{display:flex;align-items:center;gap:8px;color:var(--ink)}

/* phone frames */
.case-designed .ph{position:relative;aspect-ratio:9/16;max-width:100%;border-radius:18px;overflow:hidden;background:#000}
.case-designed .ph img{width:100%;height:100%;object-fit:cover;display:block}
.case-designed .ph figcaption{position:absolute;left:8px;bottom:8px;right:8px;font-size:.7rem;color:#fff;background:rgba(0,0,0,.55);padding:4px 7px;border-radius:6px;line-height:1.3}
.case-designed figure{margin:0}

/* dew bands + black cards */
.case-designed .dew{background:var(--dew);color:var(--dew-ink);--ink:#111;--soft:#3d3f22;--card:var(--on-dew-card);--rule:rgba(17,17,17,.12)}
.case-designed .dark,.case-designed .box.dark,.case-designed .ins.dark{background:var(--stage)!important;color:var(--stage-ink);--ink:var(--stage-ink);--soft:var(--stage-soft);--rule:rgba(255,255,255,.14)}

/* cover */
.case-designed .cover{padding-block:28px 84px}
.case-designed .top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:20px}
.case-designed .logo{font-family:var(--display);font-size:1.7rem;letter-spacing:.02em}
.case-designed .cover-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center;margin-top:28px}
.case-designed .collage{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
.case-designed .collage .ph:nth-child(even){transform:translateY(28px)}
.case-designed .meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 24px;margin-top:8px}
.case-designed .meta div{display:grid;grid-template-columns:48px minmax(0,1fr);column-gap:12px;row-gap:2px;align-content:start;min-width:0;background:var(--card);border-radius:18px;padding:14px 16px}
.case-designed .meta div svg{grid-row:1 / span 2;width:48px;height:48px;fill:none;stroke:#111;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .meta div svg .blob{stroke:none}
.case-designed .meta b{font-weight:600}
.case-designed .meta span{color:var(--soft);font-size:.92rem}

/* stat strip */
.case-designed .strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--card);border-radius:var(--r);margin-top:72px}
.case-designed .strip div{padding:26px 26px 24px;border-right:1px solid var(--rule)}
.case-designed .strip div:last-child{border-right:0}
.case-designed .strip b{display:block;font-family:var(--display);font-style:italic;font-size:3.6rem;font-weight:400;line-height:.95;font-variant-numeric:tabular-nums}
.case-designed .strip span{color:var(--soft);font-size:.92rem}

/* boxes */
.case-designed .two{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.case-designed .two>*{min-width:0}
.case-designed .before-after{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.case-designed .box{background:var(--card);border-radius:var(--r);padding:26px;display:flex;flex-direction:column;gap:12px;min-width:0}
.case-designed .box p{color:var(--soft)}
.case-designed .box ul{margin:0;padding-left:0;list-style:none;color:var(--soft);display:grid;gap:10px}
.case-designed .box li{background:#ffffff;border-radius:14px;padding:10px 14px}
.case-designed .dew .box li{background:var(--card)}
.case-designed .dark li,.case-designed .box.dark li{background:rgba(255,255,255,.07)!important}
.case-designed .tag{--hl:var(--yel);align-self:flex-start;font-family:var(--display);font-size:1.6rem;line-height:1;text-transform:uppercase;color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding:4px .08em 0}
.case-designed .tag.g{--hl:var(--mint)}
.case-designed .dark .tag{color:#111}
/* "Before": neutral, deliberately unappealing */
.case-designed .box.before .tag{color:var(--soft);text-shadow:none;padding-inline:0}
.case-designed .box.before li{color:#8a8a85}
/* hand caption label (Learned) */
.case-designed .tag.hand-lbl{font-family:var(--hand);font-size:2.3rem;text-transform:none;text-shadow:none;color:var(--soft);padding:0;line-height:.8}
.case-designed .dark .tag.hand-lbl{color:var(--stage-soft)}
/* openings: left = dew accents, right = no colour */
.case-designed .box.dark .tag.dewtag{--hl:var(--dew)}
.case-designed .box.plain .tag{text-shadow:none;color:var(--ink);padding-inline:0}
.case-designed .box.plain .hook-list li span{color:var(--soft)}
.case-designed .box .hook-list li{background:none!important;padding:0;border-radius:0}

/* research */
.case-designed .sources{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .sources .box:nth-child(2) .tag{--hl:var(--lav)} .case-designed .sources .box:nth-child(3) .tag{--hl:var(--peach)}
.case-designed .insights{display:grid;gap:18px;margin-top:56px}
.case-designed .ins{display:grid;grid-template-columns:1.3fr 70px .9fr 1.1fr;gap:20px;align-items:center;background:var(--card);border-radius:var(--r);padding:26px}
.case-designed .quote{font-family:var(--display);font-style:italic;font-size:1.75rem;font-weight:400;line-height:1.08}
.case-designed .quote small{display:block;margin-top:12px;font-family:var(--hand);font-style:normal;font-size:1.45rem;color:var(--soft);letter-spacing:0}
.case-designed .arrow{color:var(--ink);display:grid;place-items:center}
.case-designed .ins .ph{max-width:200px}
.case-designed .ins p{font-size:.98rem;color:var(--soft)}
.case-designed .ins p b{color:var(--ink);font-style:normal;font-weight:600}

/* matrix */
.case-designed .mx-wrap{overflow-x:auto;margin-top:36px;border-radius:var(--r);background:var(--card)}
.case-designed table{border-collapse:collapse;width:100%}
.case-designed .mx{min-width:760px;font-size:.92rem}
.case-designed .mx th,.case-designed .mx td{padding:14px 16px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}
.case-designed .mx th{font-family:var(--display);font-size:1.15rem;text-transform:uppercase;color:var(--ink);font-weight:400}
.case-designed .mx tr:last-child td{border-bottom:0}
.case-designed .mx td:first-child{font-weight:600;white-space:nowrap}
.case-designed .mx .h{font-style:italic}
.case-designed .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.case-designed .chip{background:var(--card);border-radius:99px;padding:8px 16px;font-size:.92rem;font-family:var(--body);font-style:normal}
.case-designed .chip b{font-family:var(--body);font-style:normal;font-weight:600;font-size:.92rem}

/* formats (dew band, white post cards) */
.case-designed .fmt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:44px;position:relative}
.case-designed .fmt{display:flex;flex-direction:column;gap:8px;min-width:0;background:var(--card);border-radius:22px;padding:12px 12px 18px}
.case-designed .fmt .ph{border-radius:12px}
.case-designed .fmt h3{font-size:1.02rem;padding-inline:4px}
.case-designed .fmt p{font-size:.88rem;color:var(--soft);padding-inline:4px}
.case-designed .fmt .lbl{font-family:var(--display);font-size:1.05rem;text-transform:uppercase;line-height:1;padding:6px 4px 0}
.case-designed .lbl.native{color:var(--ink)} .case-designed .lbl.proof{color:var(--c1)}
.case-designed .rule-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .rule-row .box:nth-child(2) .tag{--hl:var(--lav)} .case-designed .rule-row .box:nth-child(3) .tag{--hl:var(--peach)}
.case-designed .dew .tag.g{--hl:var(--mint)}

/* anatomy */
.case-designed .anat{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px;margin-top:88px;position:relative}
.case-designed .anat-item{display:grid;grid-template-columns:minmax(0,260px) 1fr;gap:24px;align-items:start}
.case-designed .pin{position:absolute;width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew);font-family:var(--display);font-size:1.05rem;display:grid;place-items:center;box-shadow:0 0 0 3px var(--dew);transform:translate(-50%,-50%)}
.case-designed ol.notes{margin:0;padding:0;list-style:none;display:grid;gap:14px;counter-reset:n}
.case-designed ol.notes li{display:grid;grid-template-columns:30px 1fr;gap:10px;font-size:.95rem;counter-increment:n;color:var(--soft)}
.case-designed ol.notes li::before{content:counter(n);width:26px;height:26px;border-radius:50%;background:#111;color:var(--dew);font-family:var(--display);font-style:normal;font-size:1rem;display:grid;place-items:center}
.case-designed ol.notes b{font-style:normal;font-weight:600;color:var(--ink)}

/* casting */
.case-designed .cast{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:44px}
.case-designed .person{display:grid;grid-template-columns:150px 1fr;gap:20px;align-items:start;background:var(--card);border-radius:var(--r);padding:20px}
.case-designed .person .ph{border-radius:14px}
.case-designed .person h3{font-family:var(--display);font-style:normal;font-weight:400;font-size:2.4rem;text-transform:uppercase;line-height:.9}
.case-designed .person p{}
.case-designed .person ul{margin:6px 0 0;padding-left:0;list-style:none;color:var(--soft);font-size:.92rem;display:grid;gap:6px}
.case-designed .person li{background:#ffffff;border-radius:12px;padding:7px 12px}

.case-designed .chart-card{margin-top:16px;background:var(--card);border-radius:var(--r);padding:26px;overflow-x:auto;position:relative}
.case-designed .chart-card > svg{display:block;min-width:620px;width:100%;height:auto}
.case-designed .src-note{font-size:.8rem;color:var(--soft);margin-top:12px}

/* scripts (dew band) */
.case-designed .timeline{display:grid;grid-template-columns:1fr 1.4fr 1.6fr 1.1fr 1.1fr;margin-top:44px;border-radius:var(--r);overflow:hidden;background:var(--card)}
.case-designed .timeline div{padding:18px;border-right:1px solid var(--rule);display:flex;flex-direction:column;gap:6px;min-width:0}
.case-designed .timeline div:last-child{border-right:0}
.case-designed .timeline .s{font-family:var(--hand);font-size:1.5rem;line-height:.8;color:var(--soft)}
.case-designed .timeline b{font-family:var(--display);font-weight:400;font-size:1.45rem;text-transform:uppercase;line-height:1}
.case-designed .timeline .q{font-size:.9rem;color:var(--soft)}
.case-designed .hooks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:0}
.case-designed .box .hook-list{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.case-designed .hook-list li{font-weight:600;font-size:1rem;line-height:1.3;color:var(--ink);border:0;padding:0}
.case-designed .hook-list li span{font-family:var(--display);font-style:normal;font-weight:400;font-size:1.1rem;color:var(--soft);margin-left:6px}
.case-designed .dark .hook-list li span{color:var(--dew)}

/* data loop */
.case-designed .res{min-width:640px;font-size:.92rem}
.case-designed .res th,.case-designed .res td{padding:13px 16px;border-bottom:1px solid var(--rule);text-align:left}
.case-designed .res th{font-family:var(--display);font-size:1.1rem;text-transform:uppercase;color:var(--ink);font-weight:400}
.case-designed .res td.n{font-variant-numeric:tabular-nums;font-family:var(--display);font-size:1.15rem}
.case-designed .res tr:last-child td{border-bottom:0}
.case-designed .st{display:inline-flex;align-items:center;gap:6px;font-size:.84rem}
.case-designed .st i{width:9px;height:9px;border-radius:50%}
.case-designed .s-g i{background:var(--good)} .case-designed .s-y i{background:var(--mid)} .case-designed .s-r i{background:var(--bad)}
.case-designed .loop{margin-top:40px;grid-template-columns:1.5fr 1fr}
.case-designed .funnel{display:grid;gap:10px;margin-top:6px}
.case-designed .fn{display:grid;grid-template-columns:90px minmax(0,1fr);gap:12px;align-items:center;font-size:.92rem}
.case-designed .fn .b{height:38px;border-radius:10px;background:var(--rule);display:flex;align-items:center;padding-left:12px;font-family:var(--display);font-style:normal;font-size:1.4rem;font-variant-numeric:tabular-nums;flex:none}
.case-designed .fn .b.g{background:var(--dew);color:#111;min-width:52px}
.case-designed .learn{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}

/* results (dew band, black cards) */
.case-designed .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .kpi{background:var(--stage);color:var(--stage-ink);border-radius:var(--r);padding:30px;display:flex;flex-direction:column;gap:14px}
.case-designed .kpi b{font-family:var(--display);font-style:italic;font-size:5rem;font-weight:400;line-height:.85;font-variant-numeric:tabular-nums}
.case-designed .kpi span{color:var(--stage-soft);font-size:.95rem}

/* batch 2 */
.case-designed .reel{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:40px}

/* offer */
.case-designed .offer{background:var(--stage);color:var(--stage-ink);border-radius:36px;padding:60px 48px;display:grid;gap:28px;--ink:var(--stage-ink);--soft:var(--stage-soft)}
