---
import Base from '../../layouts/Base.astro';
// Converted from the OKAD case artifact. Styles are scoped under .case-designed.
const title = "Dating after 40 is a hard sell. So we made it a conversation. | OKAD Agency";
const description = "Dating.com and its app Zendate needed content that grown-up singles would watch, save and send to a friend. Over five months we wrote the scripts, cast the creators, briefed every shoot and edited 60+ videos in seven formats for the brands' own feeds.";
const ogImage = "/images/cases/dating-com-creator-content/img-01.jpg";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
  </Fragment>
  <div class="case-designed">






<!-- COVER -->
<section class="cover">
  <div class="w">
    <div class="cover-grid">
      <div class="stack" style="gap:24px">
        <span class="kick">Dating platform · Singles 40+ · TikTok and Instagram</span>
        <h1>Dating after 40 is a hard sell. <span class="cap g">So we made it a conversation.</span></h1>
        <p class="lead">Dating.com and its app Zendate needed content that grown-up singles would watch, save and send to a friend. Over five months we wrote the scripts, cast the creators, briefed every shoot and edited 60+ videos in seven formats for the brands' own feeds.</p>
        <div class="meta">
          <div><b>March–August 2026</b><span>Five months, several waves</span></div>
          <div><b>10+ creators</b><span>Solo, couples, street interviews</span></div>
          <div><b>Our scope</b><span>Product research, scripts, casting, shooting and editing briefs, editing</span></div>
          <div><b>Where it ran</b><span>Dating.com TikTok and Zendate Instagram</span></div>
        </div>
      </div>
      <div class="collage" aria-label="Videos from the feeds">
        <div class="ann hand" style="right:-6px;top:-74px">straight from the feeds<svg width="70" height="60" viewBox="0 0 70 60"><path d="M6 6 C 34 2, 56 18, 60 52"/><path d="M51 44 L60 54 L66 42"/></svg></div>
        <figure class="ph"><img alt="She was talking to 3 people when we met" src="/images/cases/dating-com-creator-content/img-01.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Street interview in New York" src="/images/cases/dating-com-creator-content/img-02.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="I met him online at 47" src="/images/cases/dating-com-creator-content/img-03.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="He made me soup" src="/images/cases/dating-com-creator-content/img-04.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="5 questions, 1 evening" src="/images/cases/dating-com-creator-content/img-05.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="I'm the funniest person in my language" src="/images/cases/dating-com-creator-content/img-06.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="The sexiest thing a man ever did" src="/images/cases/dating-com-creator-content/img-07.jpg" loading="lazy"></figure>
        <figure class="ph"><img alt="Couple podcast" src="/images/cases/dating-com-creator-content/img-08.jpg" loading="lazy"></figure>
      </div>
    </div>
    <div class="strip">
      <div><b>60+</b><span>videos edited and delivered</span></div>
      <div><b>80+</b><span>scripts and text hooks written</span></div>
      <div><b>7</b><span>formats, from a couple podcast to street interviews</span></div>
      <div><b>9.6K</b><span>organic views on the top TikTok</span></div>
    </div>
    <div class="howto"><span><b>Hook</b> = the first seconds that make people stop scrolling.</span><span><b>Organic</b> = posted on the brand's own profile, not paid.</span><span><b>Text hook</b> = a silent clip where the words on screen tell the story.</span></div>
  </div>
</section>

<!-- Q1 -->
<section>
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q1 · Why is this hard to advertise?</span>
      <h2>Because this audience <span class="cap p">doesn't want to be sold to.</span></h2>
      <p class="lead">Singles in their 40s and 50s scroll past anything that looks like an app ad. They stop for honesty: eating dinner alone in a big city, a first date after fifteen years of marriage, a dad's secret to 38 years together. So the brief was content first, brand last.</p>
      <p class="pro"><b>For marketers</b>Videos with a CTA were edited with a pause before it, so the same file can run as an organic post or as a paid ad.</p>
    </div>
    <div class="before-after">
      <div class="box before">
        <span class="tag">What we got</span>
        <ul>
          <li>A list of content topics</li>
          <li>An audience of 45 to 60</li>
          <li>A request for trends and reactions</li>
          <li>A product we signed up for ourselves</li>
        </ul>
      </div>
      <div class="box dark">
        <span class="tag g">The brief</span>
        <ul>
          <li>First-person stories, not advice</li>
          <li>Native editing, no agency polish</li>
          <li>Formats from the feed, not from ads</li>
          <li>Brand at the end, after a pause</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Q2 -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q2 · Where did the scripts come from?</span>
      <h2>We graded every topic <span class="cap g">and rewrote the weak ones.</span></h2>
      <p class="lead">The starting list read like blog titles. We scored each of 26 topics out of 10, wrote down why, and turned it into something a real person would say to camera. Two hooks per script, so the opening can be tested too.</p>
      <p class="pro"><b>For marketers</b>Seven rubrics: relationships after 35, loneliness, real stories, POV memes, film breakdowns, save-worthy lists and trend reactions.</p>
    </div>
    <div class="insights">
      <div class="ins">
        <div class="quote">"I asked my dad the secret to 38 years of marriage. His third answer broke me."<small>WAS "WHAT MAKES A RELATIONSHIP LAST" · 4/10</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph t34"><img alt="My parents have been married 38 years" src="/images/cases/dating-com-creator-content/img-09.jpg" loading="lazy"></figure>
        <p><b>A lecture became a family story.</b> The advice is the same; now it comes from someone's dad, with a cliffhanger on the third point.</p>
      </div>
      <div class="ins dark">
        <div class="quote">"She was talking to 3 people. I was only talking to her. Who was wrong?"<small>WAS A RISKY CONFESSION · 5/10</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph t34"><img alt="She was talking to 3 people" src="/images/cases/dating-com-creator-content/img-01.jpg" loading="lazy"></figure>
        <p><b>A story that judged became a question.</b> No villain, just a debate the comments can finish. 9.6K views, one of the best in the feed.</p>
      </div>
      <div class="ins">
        <div class="quote">"POV: First video call date. Where do I even look?"<small>WAS A MEME REFERENCE · 5/10, TOO YOUNG</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph t34"><img alt="POV first video call date" src="/images/cases/dating-com-creator-content/img-10.jpg" loading="lazy"></figure>
        <p><b>A trend, adapted for 45+.</b> Screen or camera, the boring ceiling, the hands: and quietly, the product's video calls become normal.</p>
      </div>
    </div>
  </div>
</section>

<!-- Q3 FORMATS -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q3 · Why so many formats?</span>
      <h2>Seven formats, <span class="cap g">so the feed never repeats itself.</span></h2>
      <p class="lead">A brand feed of one person talking gets skipped by week two. We mixed formats so every post feels like something people already watch, and so the brand learns which one its audience answers to.</p>
    </div>
    <div class="fmt-grid six">
      <div class="fmt"><figure class="ph t34"><img alt="Talking head" src="/images/cases/dating-com-creator-content/img-11.jpg" loading="lazy"></figure><span class="lbl native">Talking head</span><h3>One person, one confession</h3><p>Loneliness, first dates, the five-minute test. Native subtitles and a title card.</p></div>
      <div class="fmt"><figure class="ph t34"><img alt="Street interview" src="/images/cases/dating-com-creator-content/img-12.jpg" loading="lazy"></figure><span class="lbl native">Street interviews</span><h3>Strangers in New York</h3><p>"What's the loneliest thing about living here?" Real answers, no script.</p></div>
      <div class="fmt"><figure class="ph t34"><img alt="POV skit" src="/images/cases/dating-com-creator-content/img-03.jpg" loading="lazy"></figure><span class="lbl native">POV skits</span><h3>Trends, made for 45+</h3><p>Your kids find your profile. First date after fifteen years married.</p></div>
      <div class="fmt"><figure class="ph t34"><img alt="List video" src="/images/cases/dating-com-creator-content/img-05.jpg" loading="lazy"></figure><span class="lbl proof">Lists and films</span><h3>Things people save</h3><p>Five questions for one evening, Before Sunrise, five films to talk about after.</p></div>
      <div class="fmt"><figure class="ph t34"><img alt="Couple podcast" src="/images/cases/dating-com-creator-content/img-13.jpg" loading="lazy"></figure><span class="lbl proof">Podcast</span><h3>Two sides of one question</h3><p>A real couple argues it out at the table. Roles swap from clip to clip.</p></div>
      <div class="fmt"><figure class="ph"><img alt="Silent text hook" src="/images/cases/dating-com-creator-content/img-04.jpg" loading="lazy"></figure><span class="lbl proof">Text hooks</span><h3>The words do the talking</h3><p>Silent acting, one line on screen. Built for Zendate's Instagram.</p></div>
    </div>
  </div>
</section>


<!-- Q4 PODCAST -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q4 · What is the podcast format?</span>
      <h2>Two people, one table, <span class="cap g">opposite answers.</span></h2>
      <p class="lead">A real couple at a table with coffee, arguing one dating question per episode: age, texting, who pays, starting over after a divorce. One plays the doubter, the other the straight talker, and the comments pick a side.</p>
      <p class="pro"><b>For marketers</b>Ten episodes, each aimed at a user segment from the client's data: companion, romantic or transactional. Roles rotate between episodes so the same two faces never feel repetitive.</p>
    </div>
    <div class="reel three">
      <figure class="ph"><img alt="Butterflies are a red flag" src="/images/cases/dating-com-creator-content/img-14.jpg" loading="lazy"><figcaption>"Butterflies are a red flag"</figcaption></figure>
      <figure class="ph"><img alt="Coming out of a long relationship, is it over?" src="/images/cases/dating-com-creator-content/img-15.jpg" loading="lazy"><figcaption>"Is it too late to start over?"</figcaption></figure>
      <figure class="ph"><img alt="Do you want me to fight somebody?" src="/images/cases/dating-com-creator-content/img-16.jpg" loading="lazy"><figcaption>"What does feeling safe mean?"</figcaption></figure>
    </div>
    <div class="rule-row">
      <div class="box"><span class="tag">Setup</span><h3>Built for subtitles</h3><p>Seated, elbows on the table, bright mugs, no black clothes. A quarter of the frame left free at the top for captions.</p></div>
      <div class="box"><span class="tag">Delivery</span><h3>Hook exact, rest alive</h3><p>The first 2–3 lines word for word. After that, a real conversation with interruptions and laughs, reactions 30–40% brighter than life.</p></div>
      <div class="box"><span class="tag">Roles</span><h3>Never the same pair twice</h3><p>Cocky and gentle, teased nice guy, tough love, tender. The dynamic changes every episode.</p></div>
    </div>
    <details class="more"><summary>See all ten episode questions</summary>
    <div class="mx-wrap"><table class="mx"><thead><tr><th scope="col">#</th><th scope="col">Question</th><th scope="col">Segment</th></tr></thead><tbody>
      <tr><td>1</td><td class="h">Be honest: does age actually matter?</td><td>Companion, romantic</td></tr>
      <tr><td>2</td><td class="h">When does texting cross the line?</td><td>Companion</td></tr>
      <tr><td>3</td><td class="h">Why do guys switch up after they get comfortable?</td><td>All</td></tr>
      <tr><td>4</td><td class="h">Men think feeling safe means one thing. It doesn't.</td><td>Romantic</td></tr>
      <tr><td>5</td><td class="h">Should the man always pay?</td><td>All</td></tr>
      <tr><td>6</td><td class="h">Is it too late to start over?</td><td>Companion, romantic</td></tr>
      <tr><td>7</td><td class="h">Things women find hot that men have zero clue about</td><td>All</td></tr>
      <tr><td>8</td><td class="h">Nobody's talking about this: lonely men</td><td>Companion</td></tr>
      <tr><td>9</td><td class="h">Butterflies aren't what you think they are</td><td>Romantic</td></tr>
      <tr><td>10</td><td class="h">The #1 turn-off you don't know you're doing</td><td>Transactional</td></tr>
    </tbody></table></div>
    </details>
  </div>
</section>

<!-- Q5 ZENDATE -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q5 · And Zendate?</span>
      <h2>A second audience: <span class="cap y">people far from home.</span></h2>
      <p class="lead">For Zendate we wrote 45 short text hooks for expats and the Asian diaspora: mom's matchmaking, accents, culture clashes on a first date, being "cute but short". Creators act each one out without a word; the line on screen carries the joke.</p>
      <p class="pro"><b>For marketers</b>Every hook was tagged by content pillar (culture, identity, trust and safety, product), creator profile, and a note on why it spreads: who forwards it and what the comments will argue about.</p>
    </div>
    <div class="reel">
      <figure class="ph"><img alt="If I date someone my mom chose" src="/images/cases/dating-com-creator-content/img-17.jpg" loading="lazy"><figcaption>Mom's choice vs mine</figcaption></figure>
      <figure class="ph"><img alt="Mom: why won't you marry the girl I found" src="/images/cases/dating-com-creator-content/img-18.jpg" loading="lazy"><figcaption>The family resume</figcaption></figure>
      <figure class="ph"><img alt="His mom sent me kimchi" src="/images/cases/dating-com-creator-content/img-19.jpg" loading="lazy"><figcaption>Kimchi after date two</figcaption></figure>
      <figure class="ph"><img alt="Two options if you're an Asian woman" src="/images/cases/dating-com-creator-content/img-20.jpg" loading="lazy"><figcaption>"That's the menu"</figcaption></figure>
      <figure class="ph"><img alt="Funniest person in my language" src="/images/cases/dating-com-creator-content/img-06.jpg" loading="lazy"><figcaption>Funny in one language</figcaption></figure>
      <figure class="ph"><img alt="My parents found me a wife" src="/images/cases/dating-com-creator-content/img-21.jpg" loading="lazy"><figcaption>6,000 miles from home</figcaption></figure>
    </div>
  </div>
</section>

<!-- Q5 BRIEFS -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q6 · How do you brief ten different creators?</span>
      <h2>One brief per format, <span class="cap g">down to the gesture.</span></h2>
      <p class="lead">A silent clip lives or dies on a face. A couple dialogue dies if both people play the same role every time. So each format got its own brief, and the editors got one too.</p>
    </div>
    <div class="rule-row">
      <div class="box"><span class="tag g">Silent hooks</span><h3>Readable with sound off</h3><p>"Look at the camera, serious, 2–3 seconds. Look away. Smile like you amused yourself." Each gesture is one beat of the line.</p></div>
      <div class="box"><span class="tag g">Couple talk</span><h3>Roles that rotate</h3><p>Cocky and gentle, teased nice guy, tough love. Reactions 30–40% brighter than life; only the hook said word for word.</p></div>
      <div class="box"><span class="tag g">Editing</span><h3>Native, not polished</h3><p>A 3–7 second title card, small CapCut-style subtitles, 2–3 b-roll inserts, moody music at night, light music for lists.</p></div>
    </div>
    <div class="hn" style="justify-content:flex-end;margin-top:14px"><svg style="transform:scaleX(-1)" width="60" height="46" viewBox="0 0 60 46"><path d="M4 42 C 26 42, 34 10, 54 6"/><path d="M45 1 L55 6 L47 13"/></svg><span class="hand">"at this rate I'm going to date a volcano"</span></div>
    <div class="reel three">
      <figure class="ph"><img alt="Volcano text hook" src="/images/cases/dating-com-creator-content/img-22.jpg" loading="lazy"><figcaption>Serious face, then the smile</figcaption></figure>
      <figure class="ph"><img alt="I like honest guys text hook" src="/images/cases/dating-com-creator-content/img-23.jpg" loading="lazy"><figcaption>Confident gesture, awkward smile</figcaption></figure>
      <figure class="ph"><img alt="The sexiest thing a man ever did" src="/images/cases/dating-com-creator-content/img-07.jpg" loading="lazy"><figcaption>Lights up on the line</figcaption></figure>
    </div>
  </div>
</section>

<!-- Q7 RESULTS -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q7 · Which videos travelled furthest?</span>
      <h2>The posts that broke out, <span class="cap g">and why they did.</span></h2>
      <p class="lead">Organic views on the Dating.com TikTok, with no creator audience to borrow from. The winners share one thing: a question or a confession the viewer wants to answer.</p>
    </div>
    <div class="kpis">
      <div class="kpi"><small>street interview</small><b>9.6K</b><span>"What's one thing you'd never ask on a first date?" Strangers in New York, no script.</span></div>
      <div class="kpi"><small>debate story</small><b>9.6K</b><span>"She was talking to 3 people. I was only talking to her. Who was wrong?"</span></div>
      <div class="kpi"><small>confession</small><b>7.8K</b><span>"I met him online at 47." A first-person story with a twist at the end.</span></div>
    </div>
    <div class="reel">
      <figure class="ph t34"><img alt="Street interview" src="/images/cases/dating-com-creator-content/img-02.jpg" loading="lazy"><figcaption>Street interview</figcaption></figure>
      <figure class="ph t34"><img alt="Who was wrong" src="/images/cases/dating-com-creator-content/img-01.jpg" loading="lazy"><figcaption>Debate story</figcaption></figure>
      <figure class="ph t34"><img alt="Met him online at 47" src="/images/cases/dating-com-creator-content/img-03.jpg" loading="lazy"><figcaption>Confession</figcaption></figure>
      <figure class="ph t34"><img alt="5 questions, 1 evening" src="/images/cases/dating-com-creator-content/img-05.jpg" loading="lazy"><figcaption>Save-worthy list</figcaption></figure>
      <figure class="ph t34"><img alt="Talked out loud to break the silence" src="/images/cases/dating-com-creator-content/img-24.jpg" loading="lazy"><figcaption>Loneliness</figcaption></figure>
      <figure class="ph t34"><img alt="And everything just came out" src="/images/cases/dating-com-creator-content/img-11.jpg" loading="lazy"><figcaption>One real conversation</figcaption></figure>
    </div>
    <div class="hn" style="justify-content:flex-end;margin-top:14px"><svg style="transform:scaleX(-1)" width="60" height="46" viewBox="0 0 60 46"><path d="M4 42 C 26 42, 34 10, 54 6"/><path d="M45 1 L55 6 L47 13"/></svg><span class="hand">six posts above 7K</span></div>
  </div>
</section>

<!-- OFFER -->
<section>
  <div class="w">
    <div class="offer">
      <span class="q-kick">Q8 · What would this look like for you?</span>
      <h2>Your audience ignores ads. <span class="cap g">Give them something to send a friend.</span></h2>
      <p class="lead">For apps and communities whose buyers scroll past anything that looks like marketing: dating, social, wellbeing, 40+ audiences.</p>
      <div class="steps">
        <div class="step"><span class="mono">step 1</span><b>Research</b><p>We use your product like a customer first.</p></div>
        <div class="step"><span class="mono">step 2</span><b>Scripts</b><p>Topics graded, rewritten, two hooks each.</p></div>
        <div class="step"><span class="mono">step 3</span><b>Casting</b><p>Creators who look like your users.</p></div>
        <div class="step"><span class="mono">step 4</span><b>Briefs</b><p>Per format, down to the gesture.</p></div>
        <div class="step"><span class="mono">step 5</span><b>Edit</b><p>Native, with an optional CTA for paid.</p></div>
      </div>
      <div class="cta"><a class="btn" href="https://okad.agency" target="_blank" rel="noopener">Book a call · okad.agency</a><span class="hn"><span style="flex:none"><svg width="54" height="22" viewBox="0 0 54 22"><path d="M51 12 C 36 16, 20 7, 5 11"/><path d="M13 4 L4 11 L12 18"/></svg></span><span class="hand">start here</span></span></div>
    </div>
  </div>
</section>

<footer class="w">OKAD · Lisbon · View counts as shown on the Dating.com TikTok profile, October 2026. Hooks quoted from approved scripts.</footer>

  </div>
</Base>

<style is:global>
.case-designed{margin:0;padding:0;background:#ffffff}
.case-designed img{max-width:100%}
.case-designed{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}.case-designed{scroll-padding-top:env(safe-area-inset-top,0px)}

/* OKAD house style: white page, Instrument Serif caps for headlines, Instrument Sans for reading,
   Reenie Beanie for hand-written notes with drawn arrows. Pastel outline marks the key words;
   dew-green bands and black cards create rhythm. */
.case-designed{
  --paper:#ffffff; --card:#f4f4f1; --ink:#111111; --soft:#5f5f5b; --rule:#e6e6e1;
  --dew:#eefb6e; --dew-ink:#111111; --on-dew-card:#ffffff;
  --yel:#f2fa5a; --mint:#b5f5c6; --lav:#d4d4fc; --peach:#ffe2ad; --lilac:#ecc8fa;
  --hi:var(--dew); --hi-ink:#111111; --pink:#111111;
  --c1:#8f4fd6; --c2:#17904f;
  --stage:#121114; --stage-ink:#f4f4f0; --stage-soft:#b9b9b3;
  --good:#17904f; --mid:#c98a14; --bad:#d03e3e;
  --display:"Instrument Serif","Times New Roman",serif;
  --body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --hand:"Reenie Beanie","Bradley Hand",cursive;
  --mono:var(--body);
  --r:28px;
}
.case-designed{color-scheme:light}

.case-designed *{box-sizing:border-box}
.case-designed{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
.case-designed .w{max-width:1180px;margin:0 auto;padding-inline:20px}
.case-designed section{padding-block:96px;position:relative}
.case-designed p{margin:0;max-width:64ch}
.case-designed h1,.case-designed h2{font-family:var(--display);font-weight:400;margin:0;line-height:.94;text-transform:uppercase;letter-spacing:-.012em;text-wrap:balance}
.case-designed h1{font-size:clamp(2.8rem,6.4vw,5.6rem)}
.case-designed h2{font-size:clamp(2.3rem,4.9vw,4.1rem)}
.case-designed h3{font-family:var(--body);font-style:italic;font-weight:600;font-size:1.16rem;line-height:1.2;margin:0;letter-spacing:-.005em}
.case-designed .kick{font-family:var(--body);font-size:.92rem;color:var(--soft)}
.case-designed .lead{font-size:1.2rem;color:var(--soft);max-width:60ch}
.case-designed .stack{display:flex;flex-direction:column;gap:20px}
.case-designed .mono{font-family:var(--body);font-size:.8rem}
.case-designed .q-kick{font-family:var(--body);font-style:normal;font-weight:400;font-size:1rem;color:var(--soft)}
.case-designed .pro{font-size:.92rem;color:var(--soft);background:var(--card);border-radius:18px;padding:14px 18px 16px;max-width:70ch}
.case-designed .dew .pro{background:rgba(255,255,255,.55)}
