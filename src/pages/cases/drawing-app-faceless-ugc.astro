---
import Base from '../../layouts/Base.astro';
// Converted from the OKAD case artifact. Styles are scoped under .case-designed.
const title = "1.5M organic views. Zero faces on camera. | OKAD Agency";
const description = "A drawing app for iPad started at about 100 downloads a week and wanted Tier 1 users without paying for ads. I put the app screen in front instead of a creator: a hand, a pencil, a line of text and a drawing people watch to the end.";
const ogImage = "/images/cases/drawing-app-faceless-ugc/grid01.jpg";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
  </Fragment>
  <div class="case-designed">









<!-- COVER -->
<section class="cover">
  <div class="w">
    <div class="cover-grid">
      <div class="stack" style="gap:24px">
        <span class="kick">Faceless canvas UGC · iPad drawing app · organic only</span>
        <h1>1.5M organic views. <span class="cap g">Zero faces on camera.</span></h1>
        <p class="lead">A drawing app for iPad started at about 100 downloads a week and wanted Tier 1 users without paying for ads. I put the app screen in front instead of a creator: a hand, a pencil, a line of text and a drawing people watch to the end.</p>
        <div class="meta">
          <div><b>My scope</b><span>Research, faceless creators, 4 accounts, formats, hooks, daily posting, weekly review</span></div>
          <div><b>Not my scope</b><span>Paid ads and the in-app subscription funnel</span></div>
        </div>
      </div>
      <div class="proofgrid" aria-label="One account's profile grid with real view counts">
        <div class="ann hand" style="right:-6px;top:-70px">one account, real views<svg width="70" height="60" viewBox="0 0 70 60"><path d="M6 6 C 34 2, 56 18, 60 52"/><path d="M51 44 L60 54 L66 42"/></svg></div>
        <img loading="lazy" decoding="async" alt="9,073 views" src="/images/cases/drawing-app-faceless-ugc/grid01.jpg">
        <img loading="lazy" decoding="async" alt="5,417 views" src="/images/cases/drawing-app-faceless-ugc/grid02.jpg">
        <img loading="lazy" decoding="async" alt="5,623 views" src="/images/cases/drawing-app-faceless-ugc/grid05.jpg">
        <img loading="lazy" decoding="async" alt="ridiculous, 5,193 views" src="/images/cases/drawing-app-faceless-ugc/grid08.jpg">
        <img loading="lazy" decoding="async" alt="this is a bomb, 5,210 views" src="/images/cases/drawing-app-faceless-ugc/grid10.jpg">
        <img loading="lazy" decoding="async" alt="4,709 views" src="/images/cases/drawing-app-faceless-ugc/grid11.jpg">
      </div>
    </div>
    <div class="strip">
      <div><b>1,257</b><span>videos published</span></div>
      <div><b>1.5M</b><span>organic views, zero ad spend</span></div>
      <div><b>2,000</b><span>registrations in the app</span></div>
      <div><b>4</b><span>accounts on TikTok, Instagram, YouTube</span></div>
    </div>
  </div>
</section>

<!-- Q1 FORMATS -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q1 · What is canvas UGC?</span>
      <h2>The app screen <span class="cap g">is the creator.</span></h2>
      <p class="lead">Hands and an Apple Pencil only. A hook on screen, a small story while the drawing grows, a reveal at the end. The viewer watches the product work without being sold to. Every creator tested at least five new formats a week; these four held up.</p>
    </div>
    <div class="fmt-grid">
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Two players writing messages on one canvas" src="/images/cases/drawing-app-faceless-ugc/v4_f0.jpg"></figure><span class="lbl proof">Multiplayer</span><h3>Two people, one canvas</h3><p>They draw together and write to each other. The strongest format.</p></div>
      <div class="fmt"><figure class="ph wide"><img loading="lazy" decoding="async" alt="POV You try to draw an eggplant with an eggplant, 8,479 views" src="/images/cases/drawing-app-faceless-ugc/grid09.jpg"></figure><span class="lbl native">POV joke</span><h3>An absurd premise</h3><p>"POV: You try to draw an eggplant with an eggplant." 8,479 views.</p></div>
      <div class="fmt"><figure class="ph wide"><img loading="lazy" decoding="async" alt="neon mode!, 3,107 views" src="/images/cases/drawing-app-faceless-ugc/grid12.jpg"></figure><span class="lbl native">Process + reveal</span><h3>Watch it come alive</h3><p>"neon mode!" A flat sketch turns into a glowing picture.</p></div>
      <div class="fmt"><figure class="ph wide"><img loading="lazy" decoding="async" alt="what can I do, 5,518 views" src="/images/cases/drawing-app-faceless-ugc/grid07.jpg"></figure><span class="lbl proof">Relatable struggle</span><h3>It went wrong, again</h3><p>"what can I do, guess we'll just go with whatever happens." 5,518 views.</p></div>
    </div>
  </div>
</section>

<!-- Q4 MULTIPLAYER -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q2 · What worked best?</span>
      <h2>Drawing together, <span class="cap y">talking on the canvas.</span></h2>
      <p class="lead">The best variation was multiplayer drawing. Two people share one canvas, react to each other and write messages instead of speaking. Something unexpected always happens. That tension and its resolution keep people watching until the picture is done.</p>
    </div>
    <div class="insights">
      <div class="ins">
        <div class="quote">"I'm fire." "You are water."<small>WRITTEN ON THE CANVAS</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="I'm fire, you are water on the canvas" src="/images/cases/drawing-app-faceless-ugc/v5_f2.jpg"></figure>
        <p><b>Became a little rivalry.</b> Red and blue fight over the shape, then the finished owls hug. The ending pays off the conflict from the first second.</p>
      </div>
      <div class="ins dark">
        <div class="quote">"What is it?" "Why you drawing so long?"<small>ONE PLAYER TEASES THE OTHER</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="Why you drawing so long written on canvas" src="/images/cases/drawing-app-faceless-ugc/v2_f4.jpg"></figure>
        <p><b>Became a question people stay for.</b> The viewer wants to know what the picture is, the same way the second player does.</p>
      </div>
      <div class="ins">
        <div class="quote">"I can't, I'm famous." "Let's be friends?"<small>A CONVERSATION IN HANDWRITING</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="Let's be friends written on the canvas" src="/images/cases/drawing-app-faceless-ugc/v3_f5.jpg"></figure>
        <p><b>Became a story about strangers.</b> Shared canvases feel social, which is exactly what makes people comment and ask what app this is.</p>
      </div>
    </div>
  </div>
</section>

<!-- Q5 FACE VS FACELESS -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q3 · Did I test a face too?</span>
      <h2>I did. <span class="cap v">The canvas won.</span></h2>
      <p class="lead">One account ran classic talking-head UGC: a creator reacting to camera, "I found THE BEST drawing app!!!" The same afternoon I screenshotted both profiles. Faceless canvas videos were sitting at several thousand views each. The face videos mostly stayed in the hundreds.</p>
      <p class="pro"><b>For marketers</b>Hype reviews read as ads in a creative niche. Showing the drawing happen is proof. Telling people it's the best app is a claim.</p>
    </div>
    <div class="vs">
      <div class="box before">
        <span class="tag">Talking head</span>
        <b class="big">13 to 1,192</b>
        <p>views per video on the face account. "I can't believe I found THE BEST drawing app", "it literally HELPS me LEARN to draw".</p>
        <div class="facecards" aria-hidden="true">
          <div class="facecard"><div class="face"></div><span>I found THE BEST drawing app!!!</span><i>873</i></div>
          <div class="facecard"><div class="face"></div><span>it literally HELPS me LEARN to draw</span><i>303</i></div>
          <div class="facecard"><div class="face"></div><span>why tf it's so hard, do u like it?</span><i>94</i></div>
        </div>
      </div>
      <div class="box dark">
        <span class="tag g dewtag">Faceless canvas</span>
        <b class="big">3,107 to 9,073</b>
        <p>views per video across twelve posts in a row on one canvas account, screenshotted the same day.</p>
        <div class="grid-reel" style="grid-template-columns:repeat(3,minmax(0,1fr))">
          <figure><img loading="lazy" decoding="async" alt="Video with 3,844 views" src="/images/cases/drawing-app-faceless-ugc/grid03.jpg"></figure>
          <figure><img loading="lazy" decoding="async" alt="Video with 3,913 views" src="/images/cases/drawing-app-faceless-ugc/grid06.jpg"></figure>
          <figure><img loading="lazy" decoding="async" alt="Video with 5,192 views" src="/images/cases/drawing-app-faceless-ugc/grid04.jpg"></figure>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Q6 SYSTEM -->
<section class="dew">
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q4 · How do you post 1,257 videos?</span>
      <h2>Creators on a schedule, <span class="cap g">KPIs that climb weekly.</span></h2>
      <p class="lead">Every creator signed the same terms: three videos a day, 70 to 90 a month, Tier 1 country only. Pay was tied to average views, with a bonus when creators came up with working ideas on their own. Month one shipped 90 videos. Month two shipped 195.</p>
      <p class="pro"><b>For marketers</b>TikTok reads location signals hard. All posting was done by hand from a team member in the US, so every account looked local to the market I wanted.</p>
    </div>
    <div class="box">
      <span class="tag hand-lbl">average views per video, creator KPI</span>
      <div class="ramp">
        <div class="fn"><span>Week 1</span><span class="b" style="width:33%">500</span></div>
        <div class="fn"><span>Week 2</span><span class="b" style="width:47%">700</span></div>
        <div class="fn"><span>Week 3</span><span class="b" style="width:67%">1,000</span></div>
        <div class="fn"><span>Week 4</span><span class="b" style="width:100%">1,500</span></div>
      </div>
      <p>Each new account had a month to grow into the bar. Creators who beat it twice over could drop to two videos a day.</p>
    </div>
  </div>
  <div class="w">
    <div class="rule-row">
      <div class="box"><span class="tag g">I cast</span><h3>Faceless creators, Tier 1</h3><p>Artists from the US and other Tier 1 countries who could draw on an iPad daily and think in hooks, not just in pictures.</p></div>
      <div class="box"><span class="tag g">I brief</span><h3>References, not scripts</h3><p>Video references, editing and motion rules, monthly topics. Creators shoot, edit and add music themselves.</p></div>
      <div class="box"><span class="tag g">I review</span><h3>Every week, with numbers</h3><p>I checked every upload, sent feedback and new hooks, and walked the founders through the week on a call.</p></div>
    </div>
    <div class="chips">
      <span class="chip"><b>3</b> videos a day per creator</span>
      <span class="chip"><b>5+</b> new formats tested weekly</span>
      <span class="chip"><b>90</b> videos in month one</span>
      <span class="chip"><b>195</b> in month two</span>
      <span class="chip"><b>4</b> accounts on TikTok, Instagram, YouTube</span>
    </div>
  </div>
</section>

<!-- Q7 SIGNALS -->
<section>
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q5 · How do you know it sells?</span>
      <h2>People asked <span class="cap g">what app it was.</span></h2>
      <p class="lead">The app never needs a pitch in these videos. It's on screen the whole time, so the audience does the work. Under the posts the most common comment was a question about the name, and the account answered in a reply.</p>
      <img loading="lazy" decoding="async" class="statimg" alt="Top video analytics: 29.8K views" src="/images/cases/drawing-app-faceless-ugc/stat_top.jpg">
    </div>
    <div class="box dark">
      <span class="tag g dewtag">From the comments</span>
      <div class="chat">
        <div class="bub">Game name, is it free?<small>under the eggplant POV</small></div>
        <div class="bub">game name?<small>under "But look, I can't do anything."</small></div>
        <div class="bub">What app?<small>under "Guys is it real pointillism??"</small></div>
        <div class="bub">Game name?<small>under "POV: You find crazy creatives"</small></div>
        <div class="bub">I prefer left hand<small>first comment, a drawing debate</small></div>
      </div>
      <p>Viewers called it a game. That's the best thing a learning app can hear.</p>
    </div>
  </div>
</section>

<!-- Q8 RESULTS -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q6 · What came out of it?</span>
      <h2>1.5M views turned into <span class="cap g">2,000 registrations.</span></h2>
      <p class="lead">From a starting point of about 100 downloads a week and no content at all, the accounts built a steady organic flow into the App Store.</p>
    </div>
    <div class="kpis">
      <div class="kpi"><b>1,257</b><span>faceless videos published across four accounts.</span></div>
      <div class="kpi"><b>1.5M</b><span>organic views on TikTok, Instagram and YouTube. No paid boost.</span></div>
      <div class="kpi"><b>2,000</b><span>registrations in the app from organic content.</span></div>
    </div>
    <div class="learn">
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Faceless beats hype</h3><p>A finished drawing convinced more people than a creator shouting that it's the best app.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Two players beat one</h3><p>Multiplayer canvases gave every video a story and a reason to comment.</p></div>
      <div class="box"><span class="tag hand-lbl">next</span><h3>Scale is accounts</h3><p>The top video reached 29.8K. The category leader runs 10 to 15 accounts, so the next step was more profiles, not more videos per profile.</p></div>
    </div>
  </div>
</section>

<!-- OFFER -->
<section>
  <div class="w">
    <div class="offer">
      <span class="q-kick">Q7 · What would this look like for you?</span>
      <h2>Your app has a screen. <span class="cap g">That's your creator.</span></h2>
      <p class="lead">For apps where the product is easy to show and hard to explain: creative tools, learning apps, games, utilities. I build faceless canvas content that runs every day without anyone on camera.</p>
      <div class="steps">
        <div class="step"><span class="mono">step 1</span><b>Research</b><p>What already works for your competitors and why.</p></div>
        <div class="step"><span class="mono">step 2</span><b>Cast</b><p>Faceless creators from your target countries.</p></div>
        <div class="step"><span class="mono">step 3</span><b>Set up</b><p>Accounts warmed up and posted from the right geo.</p></div>
        <div class="step"><span class="mono">step 4</span><b>Post daily</b><p>New formats every week, hooks tested in volume.</p></div>
        <div class="step"><span class="mono">step 5</span><b>Review</b><p>Weekly numbers, what to keep, what to cut.</p></div>
      </div>
      <div class="cta"><a class="btn" href="https://calendly.com/okad_calls/first" target="_blank" rel="noopener">Book a call</a><a class="btn" href="/#offer" style="background:#fff">10 videos · $500</a><span class="hn"><span style="flex:none"><svg width="54" height="22" viewBox="0 0 54 22"><path d="M51 12 C 36 16, 20 7, 5 11"/><path d="M13 4 L4 11 L12 18"/></svg></span><span class="hand">start here</span></span></div>
    </div>
  </div>
</section>

<p class="w case-foot">OKAD · Lisbon · Brand name withheld at the client's request. View counts are from profile screenshots and analytics, 2025 to 2026.</p>


  </div>
</Base>

<style is:global>
.case-designed{margin:0;padding:0;background:#ffffff}
.case-designed img{max-width:100%}
.case-designed .case-foot{padding-block:28px 44px;color:var(--soft);font-size:.85rem;max-width:1180px}
.case-designed .cta .btn + .btn{color:#111}
.case-designed{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}.case-designed{scroll-padding-top:env(safe-area-inset-top,0px)}.case-designed{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}.case-designed img{max-width:100%}.case-designed [hidden]:not([hidden=until-found i]){display:none!important}

/* OKAD house style: white page, Instrument Serif caps for headlines, Instrument Sans for reading,
   Reenie Beanie for hand-written notes with drawn arrows. Pastel outline marks the key words;
   dew-green bands and black cards create rhythm. */
.case-designed{
  --paper:#ffffff; --card:#f4f4f1; --ink:#111111; --soft:#5f5f5b; --rule:#e6e6e1;
  --dew:#eefb6e; --dew-ink:#111111; --on-dew-card:#ffffff;
  --yel:#f2fa5a; --mint:#b5f5c6; --lav:#d4d4fc; --peach:#ffe2ad; --lilac:#ecc8fa;
  --hi:var(--dew); --hi-ink:#111111; --pink:#111111;
  --c1:#8f4fd6; --c2:#17904f;
  --stage:#121114; --stage-ink:#f4f4f0; --stage-soft:#b9b9b3;
  --good:#17904f; --mid:#c98a14; --bad:#d03e3e;
  --display:"Instrument Serif","Times New Roman",serif;
  --body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --hand:"Reenie Beanie","Bradley Hand",cursive;
  --mono:var(--body);
  --r:28px;
}
.case-designed{color-scheme:light}

.case-designed *{box-sizing:border-box}
.case-designed{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
.case-designed .w{max-width:1180px;margin:0 auto;padding-inline:20px}
.case-designed section{padding-block:96px;position:relative}
.case-designed p{margin:0;max-width:64ch}
.case-designed h1,.case-designed h2{font-family:var(--display);font-weight:400;margin:0;line-height:.94;text-transform:uppercase;letter-spacing:-.012em;text-wrap:balance}
.case-designed h1{font-size:clamp(2.8rem,6.4vw,5.6rem)}
.case-designed h2{font-size:clamp(2.3rem,4.9vw,4.1rem)}
.case-designed h3{font-family:var(--body);font-style:italic;font-weight:600;font-size:1.16rem;line-height:1.2;margin:0;letter-spacing:-.005em}
.case-designed .kick{font-family:var(--body);font-size:.92rem;color:var(--soft)}
.case-designed .lead{font-size:1.2rem;color:var(--soft);max-width:60ch}
.case-designed .stack{display:flex;flex-direction:column;gap:20px}
.case-designed .mono{font-family:var(--body);font-size:.8rem}
.case-designed .q-kick{font-family:var(--body);font-style:normal;font-weight:400;font-size:1rem;color:var(--soft)}
.case-designed .pro{font-size:.92rem;color:var(--soft);background:var(--card);border-radius:18px;padding:14px 18px 16px;max-width:70ch}
.case-designed .dew .pro{background:rgba(255,255,255,.55)}
.case-designed .pro b{display:block;font-family:var(--hand);font-style:normal;font-weight:400;font-size:1.7rem;line-height:.9;color:var(--ink);margin-bottom:2px}
.case-designed details.more{margin-top:32px}
.case-designed details.more summary{cursor:pointer;font-family:var(--body);font-weight:600;list-style:none;display:inline-flex;gap:10px;align-items:center;padding:12px 20px;border-radius:99px;background:var(--ink);color:var(--paper)}
.case-designed details.more summary::-webkit-details-marker{display:none}
.case-designed details.more summary::after{content:"+"}
.case-designed details.more[open] summary::after{content:"-"}
.case-designed .howto{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:26px;font-size:.88rem;color:var(--soft)}
.case-designed .howto b{color:var(--ink);font-style:normal;font-weight:600}

/* key words: thick pastel outline traced around the letters */
.case-designed .cap{--hl:transparent;color:inherit}
.case-designed .cap.g,.case-designed .cap.p,.case-designed .cap.y,.case-designed .cap.v,.case-designed h1 .cap.g{color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding-inline:.04em}
.case-designed .cap.g{--hl:var(--mint)} .case-designed .cap.p{--hl:var(--lilac)} .case-designed .cap.y{--hl:var(--peach)} .case-designed .cap.v{--hl:var(--lav)}
.case-designed h1 .cap.g{--hl:var(--yel)}
.case-designed .dew .cap.g,.case-designed .dew .cap.p,.case-designed .dew .cap.y,.case-designed .dew .cap.v{--hl:#ffffff}

/* hand-written notes */
.case-designed .hand{font-family:var(--hand);font-size:2.1rem;line-height:.95;color:var(--ink);font-weight:400}
.case-designed .ann{position:absolute;display:flex;gap:4px;align-items:flex-end;pointer-events:none;z-index:2}
.case-designed .ann svg,.case-designed .hn svg,.case-designed .arrow svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .hn{display:flex;align-items:center;gap:8px;color:var(--ink)}

/* phone frames */
.case-designed .ph{position:relative;aspect-ratio:9/16;max-width:100%;border-radius:18px;overflow:hidden;background:#000}
.case-designed .ph img{width:100%;height:100%;object-fit:cover;display:block}
.case-designed .ph figcaption{position:absolute;left:8px;bottom:8px;right:8px;font-size:.7rem;color:#fff;background:rgba(0,0,0,.55);padding:4px 7px;border-radius:6px;line-height:1.3}
.case-designed figure{margin:0}

/* dew bands + black cards */
.case-designed .dew{background:var(--dew);color:var(--dew-ink);--ink:#111;--soft:#3d3f22;--card:var(--on-dew-card);--rule:rgba(17,17,17,.12)}
.case-designed .dark,.case-designed .box.dark,.case-designed .ins.dark{background:var(--stage)!important;color:var(--stage-ink);--ink:var(--stage-ink);--soft:var(--stage-soft);--rule:rgba(255,255,255,.14)}

/* cover */
.case-designed .cover{padding-block:28px 84px}
.case-designed .top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:20px}
.case-designed .logo{font-family:var(--display);font-size:1.7rem;letter-spacing:.02em}
.case-designed .cover-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center;margin-top:28px}
.case-designed .collage{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
.case-designed .collage .ph:nth-child(even){transform:translateY(28px)}
.case-designed .meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 24px;margin-top:8px}
.case-designed .meta div{display:grid;grid-template-columns:48px minmax(0,1fr);column-gap:12px;row-gap:2px;align-content:start;min-width:0;background:var(--card);border-radius:18px;padding:14px 16px}
.case-designed .meta div svg{grid-row:1 / span 2;width:48px;height:48px;fill:none;stroke:#111;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .meta div svg .blob{stroke:none}
.case-designed .meta b{font-weight:600}
.case-designed .meta span{color:var(--soft);font-size:.92rem}

/* stat strip */
.case-designed .strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--card);border-radius:var(--r);margin-top:72px}
.case-designed .strip div{padding:26px 26px 24px;border-right:1px solid var(--rule)}
.case-designed .strip div:last-child{border-right:0}
.case-designed .strip b{display:block;font-family:var(--display);font-style:italic;font-size:3.6rem;font-weight:400;line-height:.95;font-variant-numeric:tabular-nums}
.case-designed .strip span{color:var(--soft);font-size:.92rem}

/* boxes */
.case-designed .two{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.case-designed .two>*{min-width:0}
.case-designed .before-after{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.case-designed .box{background:var(--card);border-radius:var(--r);padding:26px;display:flex;flex-direction:column;gap:12px;min-width:0}
.case-designed .box p{color:var(--soft)}
.case-designed .box ul{margin:0;padding-left:0;list-style:none;color:var(--soft);display:grid;gap:10px}
.case-designed .box li{background:#ffffff;border-radius:14px;padding:10px 14px}
.case-designed .dew .box li{background:var(--card)}
.case-designed .dark li,.case-designed .box.dark li{background:rgba(255,255,255,.07)!important}
.case-designed .tag{--hl:var(--yel);align-self:flex-start;font-family:var(--display);font-size:1.6rem;line-height:1;text-transform:uppercase;color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding:4px .08em 0}
.case-designed .tag.g{--hl:var(--mint)}
.case-designed .dark .tag{color:#111}
/* "Before": neutral, deliberately unappealing */
.case-designed .box.before .tag{color:var(--soft);text-shadow:none;padding-inline:0}
.case-designed .box.before li{color:#8a8a85}
/* hand caption label (Learned) */
.case-designed .tag.hand-lbl{font-family:var(--hand);font-size:2.3rem;text-transform:none;text-shadow:none;color:var(--soft);padding:0;line-height:.8}
.case-designed .dark .tag.hand-lbl{color:var(--stage-soft)}
/* openings: left = dew accents, right = no colour */
.case-designed .box.dark .tag.dewtag{--hl:var(--dew)}
.case-designed .box.plain .tag{text-shadow:none;color:var(--ink);padding-inline:0}
.case-designed .box.plain .hook-list li span{color:var(--soft)}
.case-designed .box .hook-list li{background:none!important;padding:0;border-radius:0}

/* research */
.case-designed .sources{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .sources .box:nth-child(2) .tag{--hl:var(--lav)} .case-designed .sources .box:nth-child(3) .tag{--hl:var(--peach)}
.case-designed .insights{display:grid;gap:18px;margin-top:56px}
.case-designed .ins{display:grid;grid-template-columns:1.3fr 70px .9fr 1.1fr;gap:20px;align-items:center;background:var(--card);border-radius:var(--r);padding:26px}
.case-designed .quote{font-family:var(--display);font-style:italic;font-size:1.75rem;font-weight:400;line-height:1.08}
.case-designed .quote small{display:block;margin-top:12px;font-family:var(--hand);font-style:normal;font-size:1.45rem;color:var(--soft);letter-spacing:0}
.case-designed .arrow{color:var(--ink);display:grid;place-items:center}
.case-designed .ins .ph{max-width:200px}
.case-designed .ins p{font-size:.98rem;color:var(--soft)}
.case-designed .ins p b{color:var(--ink);font-style:normal;font-weight:600}

/* matrix */
.case-designed .mx-wrap{overflow-x:auto;margin-top:36px;border-radius:var(--r);background:var(--card)}
.case-designed table{border-collapse:collapse;width:100%}
.case-designed .mx{min-width:760px;font-size:.92rem}
.case-designed .mx th,.case-designed .mx td{padding:14px 16px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}
.case-designed .mx th{font-family:var(--display);font-size:1.15rem;text-transform:uppercase;color:var(--ink);font-weight:400}
.case-designed .mx tr:last-child td{border-bottom:0}
.case-designed .mx td:first-child{font-weight:600;white-space:nowrap}
.case-designed .mx .h{font-style:italic}
.case-designed .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.case-designed .chip{background:var(--card);border-radius:99px;padding:8px 16px;font-size:.92rem;font-family:var(--body);font-style:normal}
.case-designed .chip b{font-family:var(--body);font-style:normal;font-weight:600;font-size:.92rem}

/* formats (dew band, white post cards) */
.case-designed .fmt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:44px;position:relative}
.case-designed .fmt{display:flex;flex-direction:column;gap:8px;min-width:0;background:var(--card);border-radius:22px;padding:12px 12px 18px}
.case-designed .fmt .ph{border-radius:12px}
.case-designed .fmt h3{font-size:1.02rem;padding-inline:4px}
.case-designed .fmt p{font-size:.88rem;color:var(--soft);padding-inline:4px}
.case-designed .fmt .lbl{font-family:var(--display);font-size:1.05rem;text-transform:uppercase;line-height:1;padding:6px 4px 0}
.case-designed .lbl.native{color:var(--ink)} .case-designed .lbl.proof{color:var(--c1)}
.case-designed .rule-row{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .rule-row .box:nth-child(2) .tag{--hl:var(--lav)} .case-designed .rule-row .box:nth-child(3) .tag{--hl:var(--peach)}
.case-designed .dew .tag.g{--hl:var(--mint)}

/* anatomy */
.case-designed .anat{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:48px;margin-top:88px;position:relative}
.case-designed .anat-item{display:grid;grid-template-columns:minmax(0,260px) 1fr;gap:24px;align-items:start}
.case-designed .pin{position:absolute;width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew);font-family:var(--display);font-size:1.05rem;display:grid;place-items:center;box-shadow:0 0 0 3px var(--dew);transform:translate(-50%,-50%)}
.case-designed ol.notes{margin:0;padding:0;list-style:none;display:grid;gap:14px;counter-reset:n}
.case-designed ol.notes li{display:grid;grid-template-columns:30px 1fr;gap:10px;font-size:.95rem;counter-increment:n;color:var(--soft)}
.case-designed ol.notes li::before{content:counter(n);width:26px;height:26px;border-radius:50%;background:#111;color:var(--dew);font-family:var(--display);font-style:normal;font-size:1rem;display:grid;place-items:center}
.case-designed ol.notes b{font-style:normal;font-weight:600;color:var(--ink)}

/* casting */
.case-designed .cast{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:44px}
.case-designed .person{display:grid;grid-template-columns:150px 1fr;gap:20px;align-items:start;background:var(--card);border-radius:var(--r);padding:20px}
.case-designed .person .ph{border-radius:14px}
.case-designed .person h3{font-family:var(--display);font-style:normal;font-weight:400;font-size:2.4rem;text-transform:uppercase;line-height:.9}
.case-designed .person p{}
.case-designed .person ul{margin:6px 0 0;padding-left:0;list-style:none;color:var(--soft);font-size:.92rem;display:grid;gap:6px}
.case-designed .person li{background:#ffffff;border-radius:12px;padding:7px 12px}

.case-designed .chart-card{margin-top:16px;background:var(--card);border-radius:var(--r);padding:26px;overflow-x:auto;position:relative}
.case-designed .chart-card > svg{display:block;min-width:620px;width:100%;height:auto}
.case-designed .src-note{font-size:.8rem;color:var(--soft);margin-top:12px}

/* scripts (dew band) */
.case-designed .timeline{display:grid;grid-template-columns:1fr 1.4fr 1.6fr 1.1fr 1.1fr;margin-top:44px;border-radius:var(--r);overflow:hidden;background:var(--card)}
.case-designed .timeline div{padding:18px;border-right:1px solid var(--rule);display:flex;flex-direction:column;gap:6px;min-width:0}
.case-designed .timeline div:last-child{border-right:0}
.case-designed .timeline .s{font-family:var(--hand);font-size:1.5rem;line-height:.8;color:var(--soft)}
.case-designed .timeline b{font-family:var(--display);font-weight:400;font-size:1.45rem;text-transform:uppercase;line-height:1}
.case-designed .timeline .q{font-size:.9rem;color:var(--soft)}
.case-designed .hooks{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;margin-top:0}
.case-designed .box .hook-list{list-style:none;margin:0;padding:0;display:grid;gap:12px}
.case-designed .hook-list li{font-weight:600;font-size:1rem;line-height:1.3;color:var(--ink);border:0;padding:0}
.case-designed .hook-list li span{font-family:var(--display);font-style:normal;font-weight:400;font-size:1.1rem;color:var(--soft);margin-left:6px}
.case-designed .dark .hook-list li span{color:var(--dew)}

/* data loop */
.case-designed .res{min-width:640px;font-size:.92rem}
.case-designed .res th,.case-designed .res td{padding:13px 16px;border-bottom:1px solid var(--rule);text-align:left}
.case-designed .res th{font-family:var(--display);font-size:1.1rem;text-transform:uppercase;color:var(--ink);font-weight:400}
.case-designed .res td.n{font-variant-numeric:tabular-nums;font-family:var(--display);font-size:1.15rem}
.case-designed .res tr:last-child td{border-bottom:0}
.case-designed .st{display:inline-flex;align-items:center;gap:6px;font-size:.84rem}
.case-designed .st i{width:9px;height:9px;border-radius:50%}
.case-designed .s-g i{background:var(--good)} .case-designed .s-y i{background:var(--mid)} .case-designed .s-r i{background:var(--bad)}
.case-designed .loop{margin-top:40px;grid-template-columns:1.5fr 1fr}
.case-designed .funnel{display:grid;gap:10px;margin-top:6px}
.case-designed .fn{display:grid;grid-template-columns:90px minmax(0,1fr);gap:12px;align-items:center;font-size:.92rem}
.case-designed .fn .b{height:38px;border-radius:10px;background:var(--rule);display:flex;align-items:center;padding-left:12px;font-family:var(--display);font-style:normal;font-size:1.4rem;font-variant-numeric:tabular-nums;flex:none}
.case-designed .fn .b.g{background:var(--dew);color:#111;min-width:52px}
.case-designed .learn{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}

/* results (dew band, black cards) */
.case-designed .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .kpi{background:var(--stage);color:var(--stage-ink);border-radius:var(--r);padding:30px;display:flex;flex-direction:column;gap:14px}
.case-designed .kpi b{font-family:var(--display);font-style:italic;font-size:5rem;font-weight:400;line-height:.85;font-variant-numeric:tabular-nums}
.case-designed .kpi span{color:var(--stage-soft);font-size:.95rem}

/* batch 2 */
.case-designed .reel{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:40px}

/* offer */
.case-designed .offer{background:var(--stage);color:var(--stage-ink);border-radius:36px;padding:60px 48px;display:grid;gap:28px;--ink:var(--stage-ink);--soft:var(--stage-soft)}
.case-designed .offer .lead{color:var(--stage-soft)}
.case-designed .offer .q-kick{color:var(--stage-soft)!important}
.case-designed .offer .cap.g{--hl:var(--dew);text-shadow:0.130em 0.000em 1px var(--hl),0.127em 0.029em 1px var(--hl),0.117em 0.056em 1px var(--hl),0.102em 0.081em 1px var(--hl),0.081em 0.102em 1px var(--hl),0.056em 0.117em 1px var(--hl),0.029em 0.127em 1px var(--hl),0.000em 0.130em 1px var(--hl),-0.029em 0.127em 1px var(--hl),-0.056em 0.117em 1px var(--hl),-0.081em 0.102em 1px var(--hl),-0.102em 0.081em 1px var(--hl),-0.117em 0.056em 1px var(--hl),-0.127em 0.029em 1px var(--hl),-0.130em 0.000em 1px var(--hl),-0.127em -0.029em 1px var(--hl),-0.117em -0.056em 1px var(--hl),-0.102em -0.081em 1px var(--hl),-0.081em -0.102em 1px var(--hl),-0.056em -0.117em 1px var(--hl),-0.029em -0.127em 1px var(--hl),-0.000em -0.130em 1px var(--hl),0.029em -0.127em 1px var(--hl),0.056em -0.117em 1px var(--hl),0.081em -0.102em 1px var(--hl),0.102em -0.081em 1px var(--hl),0.117em -0.056em 1px var(--hl),0.127em -0.029em 1px var(--hl),0.080em 0.000em 0 var(--hl),0.074em 0.031em 0 var(--hl),0.057em 0.057em 0 var(--hl),0.031em 0.074em 0 var(--hl),0.000em 0.080em 0 var(--hl),-0.031em 0.074em 0 var(--hl),-0.057em 0.057em 0 var(--hl),-0.074em 0.031em 0 var(--hl),-0.080em 0.000em 0 var(--hl),-0.074em -0.031em 0 var(--hl),-0.057em -0.057em 0 var(--hl),-0.031em -0.074em 0 var(--hl),-0.000em -0.080em 0 var(--hl),0.031em -0.074em 0 var(--hl),0.057em -0.057em 0 var(--hl),0.074em -0.031em 0 var(--hl),0.040em 0.000em 0 var(--hl),0.032em 0.024em 0 var(--hl),0.012em 0.038em 0 var(--hl),-0.012em 0.038em 0 var(--hl),-0.032em 0.024em 0 var(--hl),-0.040em 0.000em 0 var(--hl),-0.032em -0.024em 0 var(--hl),-0.012em -0.038em 0 var(--hl),0.012em -0.038em 0 var(--hl),0.032em -0.024em 0 var(--hl)}
.case-designed .steps{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.case-designed .step{border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:18px;display:flex;flex-direction:column;gap:6px;min-width:0}
.case-designed .step .mono{font-family:var(--hand);font-style:normal;font-size:1.5rem;line-height:.8;color:var(--dew)}
.case-designed .step b{font-family:var(--display);font-weight:400;font-size:1.4rem;text-transform:uppercase;line-height:1}
.case-designed .step p{font-size:.9rem;color:var(--stage-soft)}
.case-designed .cta{display:flex;align-items:center;gap:14px;flex-wrap:wrap}
.case-designed .btn{display:inline-flex;align-items:center;gap:8px;background:var(--dew);color:#111;font-weight:600;padding:16px 26px;border-radius:99px;text-decoration:none}
.case-designed .btn:focus-visible{outline:3px solid #fff;outline-offset:3px}
.case-designed .offer .hn{color:var(--stage-ink)}
.case-designed footer{padding-block:28px 44px;color:var(--soft);font-size:.85rem}

@media (max-width:1000px){
  .case-designed .cover-grid,.case-designed .two,.case-designed .loop{grid-template-columns:1fr}
  .case-designed .fmt-grid{grid-template-columns:repeat(3,1fr)}
  .case-designed .ins{grid-template-columns:1fr;text-align:left}
  .case-designed .ins .arrow{display:none}
  .case-designed .anat,.case-designed .cast,.case-designed .hooks{grid-template-columns:1fr}
  .case-designed .reel{grid-template-columns:repeat(3,1fr)}
  .case-designed .steps{grid-template-columns:1fr 1fr}
  .case-designed .learn,.case-designed .kpis,.case-designed .rule-row,.case-designed .sources{grid-template-columns:1fr}
  .case-designed .strip{grid-template-columns:1fr 1fr}
  .case-designed .strip div:nth-child(2){border-right:0}
  .case-designed .strip div:nth-child(-n+2){border-bottom:1px solid var(--rule)}
  .case-designed .timeline{grid-template-columns:1fr}
  .case-designed .timeline div{border-right:0;border-bottom:1px solid var(--rule)}
  .case-designed .ann{display:none}
}
@media (max-width:600px){
  .case-designed section{padding-block:64px}
  .case-designed .fmt-grid{grid-template-columns:repeat(2,1fr)}
  .case-designed .collage{grid-template-columns:repeat(3,1fr)}
  .case-designed .collage .ph:nth-child(n+7){display:none}
  .case-designed .anat-item{grid-template-columns:1fr}
  .case-designed .anat-item .ph{max-width:240px}
  .case-designed .person{grid-template-columns:110px 1fr}
  .case-designed .offer{padding:40px 22px}
  .case-designed .steps{grid-template-columns:1fr}
  .case-designed .before-after{grid-template-columns:1fr}
  .case-designed .kpi b{font-size:4rem}
  .case-designed .strip b{font-size:2.8rem}
}
@media (prefers-reduced-motion:no-preference){
  .case-designed .ph{transition:transform .3s ease}
  .case-designed .fmt:hover .ph,.case-designed .reel .ph:hover{transform:translateY(-4px)}
}

/* round 2 overrides */
.case-designed{letter-spacing:-.02em}
.case-designed h1,.case-designed h2,.case-designed .hand,.case-designed .tag,.case-designed .timeline b,.case-designed .step b,.case-designed .person h3,.case-designed .fmt .lbl,.case-designed .mx th,.case-designed .res th{letter-spacing:-.005em}
.case-designed .hand,.case-designed .tag.hand-lbl,.case-designed .pro b,.case-designed .quote small,.case-designed .timeline .s,.case-designed .step .mono{letter-spacing:0}
.case-designed .mx .h{font-style:normal}
/* former vertical bars: thin grey outline, no fill */
.case-designed .meta div{display:flex;flex-direction:column;gap:2px;background:transparent;border:1px solid var(--rule);border-radius:18px;padding:14px 16px}
.case-designed .meta div svg{display:none}
.case-designed .person li{background:transparent!important;border:1px solid var(--rule);border-radius:12px;padding:7px 12px}
.case-designed .pro,.case-designed .dew .pro{background:transparent;border:1px solid var(--rule);border-radius:18px}
.case-designed .dew .pro{border-color:rgba(17,17,17,.18)}
/* before / brief: arrows instead of nested plaques */
.case-designed .box ul li,.case-designed .box.dark ul li,.case-designed .dew .box ul li{background:none!important;border:0;border-radius:0;padding:0 0 0 28px;position:relative}
.case-designed .box ul li::before{content:"";position:absolute;left:0;top:.42em;width:18px;height:12px;background:currentColor;color:var(--ink);-webkit-mask:var(--arr) no-repeat center/contain;mask:var(--arr) no-repeat center/contain}
.case-designed .box ul{--arr:url("data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 18 12%27%3E%3Cpath d=%27M1 6h15M11 1l5 5-5 5%27 fill=%27none%27 stroke=%27black%27 stroke-width=%271.4%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27/%3E%3C/svg%3E")}
.case-designed .box.before ul li::before{color:#a3a39e}
.case-designed .box .hook-list li{padding:0}.case-designed .box .hook-list li::before{content:none}
/* learned caption smaller */
.case-designed .tag.hand-lbl{font-size:1.9rem}
/* results table + round box: one row, equal height, inner gap */
.case-designed .loop{gap:14px;align-items:stretch}
.case-designed .loop>.mx-wrap{height:100%}
.case-designed .loop>.box{height:100%}
