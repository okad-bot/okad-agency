---
import Base from '../../layouts/Base.astro';
// Converted from the OKAD case artifact. Styles are scoped under .case-designed.
const title = "800K views on one Reel. Shot as b-roll. | OKAD Agency";
const description = "Your Christian Date is a dating app for Christians. Instead of buying finished UGC videos one by one, I ordered raw footage from creators: one-liners to camera and a library of everyday b-roll. My editors turned that footage into 60 videos a month. Then I shot one special series, a first-timer...";
const ogImage = "/images/cases/your-christian-date-broll-content/ycd/church1.jpg";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Fragment slot="head">
  </Fragment>
  <div class="case-designed">



<!-- COVER -->
<section class="cover">
  <div class="w">
    <div class="cover-grid">
      <div class="stack" style="gap:24px">
        <span class="kick">Your Christian Date · Instagram, TikTok, YouTube · organic</span>
        <h1>800K views on one Reel. <span class="cap g">Shot as b-roll.</span></h1>
        <p class="lead">Your Christian Date is a dating app for Christians. Instead of buying finished UGC videos one by one, I ordered raw footage from creators: one-liners to camera and a library of everyday b-roll. My editors turned that footage into 60 videos a month. Then I shot one special series, a first-timer in church, and it became the account's biggest hit.</p>
        <div class="meta">
          <div><b>My scope</b><span>Briefs, casting, b-roll library, special shoot, editing, posting plan</span></div>
          <div><b>Not my scope</b><span>Paid ads and the app's own funnel</span></div>
        </div>
      </div>
      <div class="proofgrid" aria-label="Frames from the published videos">
        <div class="ann hand" style="right:-6px;top:-70px">the series that took off<svg width="70" height="60" viewBox="0 0 70 60"><path d="M6 6 C 34 2, 56 18, 60 52"/><path d="M51 44 L60 54 L66 42"/></svg></div>
        <img loading="lazy" decoding="async" alt="POV: You go to a Catholic Church for the first time" src="/images/cases/your-christian-date-broll-content/ycd/church1.jpg">
        <img loading="lazy" decoding="async" alt="POV: It's your first time in the Vatican" src="/images/cases/your-christian-date-broll-content/ycd/vat1.jpg">
        <img loading="lazy" decoding="async" alt="Someone who will pray with you, b-roll edit" src="/images/cases/your-christian-date-broll-content/ycd/broll3.jpg">
        <img loading="lazy" decoding="async" alt="If this offends you, one-liner" src="/images/cases/your-christian-date-broll-content/ycd/jenny1.jpg">
        <img loading="lazy" decoding="async" alt="Take her to church, not your bed" src="/images/cases/your-christian-date-broll-content/ycd/rend1.jpg">
        <img loading="lazy" decoding="async" alt="App screencast with Your Christian Date check the link in bio" src="/images/cases/your-christian-date-broll-content/ycd/prod2.jpg">
      </div>
    </div>
    <div class="strip">
      <div><b>800K</b><span>views on the top Reel</span></div>
      <div><b>1M+</b><span>views on the top five Reels together</span></div>
      <div><b>60</b><span>videos a month from one footage pool</span></div>
      <div><b>390</b><span>tagged b-roll clips in the library</span></div>
    </div>
  </div>
</section>

<!-- Q1 -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q1 · Why order b-roll instead of finished videos?</span>
      <h2>One shoot, <span class="cap g">dozens of videos.</span></h2>
      <p class="lead">A finished UGC video is used once. Raw footage can be cut again and again. So the brief asked creators for footage only: 4K, 60 fps, no cuts, no edits, no music. Two tasks per creator. First, short lines to camera. Second, a set of everyday moments a Christian single would actually have.</p>
    </div>
    <div class="fmt-grid">
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="If this offends you" src="/images/cases/your-christian-date-broll-content/ycd/jenny1.jpg"></figure><span class="lbl proof">Task 1 · one-liner</span><h3>A hook to camera</h3><p>"If this offends you, it might be the truth." Eight scripted lines per creator.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Reading the Bible on the couch" src="/images/cases/your-christian-date-broll-content/ycd/bible1.jpg"></figure><span class="lbl native">Task 2 · b-roll</span><h3>Reading the Bible</h3><p>Couch, blanket, morning light. No text, no talking.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Singing in the car" src="/images/cases/your-christian-date-broll-content/ycd/broll2.jpg"></figure><span class="lbl native">Task 2 · b-roll</span><h3>Singing in the car</h3><p>The kind of moment people film themselves anyway.</p></div>
      <div class="fmt"><figure class="ph"><img loading="lazy" decoding="async" alt="Looking at the phone and smiling" src="/images/cases/your-christian-date-broll-content/ycd/broll5.jpg"></figure><span class="lbl native">Task 2 · b-roll</span><h3>Smiling at the phone</h3><p>Swiping, laughing at a message, waking up happy.</p></div>
    </div>
    <div class="rule-row">
      <div class="box"><span class="tag g">I cast</span><h3>Real people, 35 to 65</h3><p>I shortlisted 26 creators on Backstage who look like the app's audience, not like influencers. Rates were $275 to $700 per package.</p></div>
      <div class="box"><span class="tag g">I brief</span><h3>Lines plus a shot list</h3><p>Hooks like "Christians, stop doing this!" and "This or That: Christian edition", plus a list of moments to film.</p></div>
      <div class="box"><span class="tag g">I tag</span><h3>A library, not a folder</h3><p>Every clip went into a catalog with the creator, setting and mood, 390 rows in total, so an editor finds a shot in seconds.</p></div>
    </div>
  </div>
</section>

<!-- Q2 -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q2 · How does one clip become many videos?</span>
      <h2>Same footage, <span class="cap y">a different line on top.</span></h2>
      <p class="lead">The text carries the idea. The footage carries the feeling. The exact same shot of a woman reading her Bible became a joke in one video and a wish in another. That is how a small pool of footage fed 60 videos a month without looking repetitive.</p>
    </div>
    <div class="insights">
      <div class="ins">
        <div class="quote">"Ever feel like there is a girl Bible and..."<small>SAME SHOT, VIDEO ONE</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="Girl Bible vs boy Bible" src="/images/cases/your-christian-date-broll-content/ycd/bible1.jpg"></figure>
        <p><b>Became a meme.</b> Her color-coded Bible next to his plain one. Light, relatable, easy to share with a friend.</p>
      </div>
      <div class="ins dark">
        <div class="quote">"Someone who wants to love God with you"<small>SAME SHOT, VIDEO TWO</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="Someone who wants to love God with you" src="/images/cases/your-christian-date-broll-content/ycd/broll1.jpg"></figure>
        <p><b>Became a wish list.</b> "Stay single until..." then a line per clip: someone who will pray with you, someone who puts God above you.</p>
      </div>
      <div class="ins">
        <div class="quote">"Take her to church, not your bed."<small>A WINNER, RE-CUT WITH NEW FOOTAGE</small></div>
        <div class="arrow" aria-hidden="true"><svg width="64" height="24" viewBox="0 0 64 24"><path d="M3 14 C 20 9, 40 16, 58 11"/><path d="M50 4 L59 11 L50 18"/></svg></div>
        <figure class="ph"><img loading="lazy" decoding="async" alt="Take her to church, not your bed" src="/images/cases/your-christian-date-broll-content/ycd/rend1.jpg"></figure>
        <p><b>Became a template.</b> When a line worked, I rewrote it in a few versions and laid it over other creators' footage, ending on "Check the link in bio".</p>
      </div>
    </div>
  </div>
</section>

<!-- Q3 -->
<section class="dew">
  <div class="w two">
    <div class="stack">
      <span class="q-kick">Q3 · What was the special video?</span>
      <h2>A first-timer <span class="cap g">in church.</span></h2>
      <p class="lead">Next to the b-roll, I wrote one series for a single actor. "POV: You go to a Catholic Church for the first time." He shot it against a plain backdrop, and my editors placed him inside a church. Lines like "I swear I blinked and we switched chapters" and "Because it seems like everyone already knows it".</p>
      <p class="lead">These were the top videos of the whole project. One Reel did around 250K in its first month, then kept going and reached about 800K three weeks later. So I did it again in the Vatican.</p>
      <p class="pro"><b>For marketers</b>The joke is never about faith. It's about being new and awkward, and everyone has been new somewhere. The app comes in only at the end: "I wish there was a space to ask all this out loud."</p>
    </div>
    <div class="stack">
      <div class="trio">
        <img loading="lazy" decoding="async" alt="Church POV frame one" src="/images/cases/your-christian-date-broll-content/ycd/church1.jpg">
        <img loading="lazy" decoding="async" alt="Church POV frame two" src="/images/cases/your-christian-date-broll-content/ycd/church2.jpg">
        <img loading="lazy" decoding="async" alt="Church POV frame three" src="/images/cases/your-christian-date-broll-content/ycd/church3.jpg">
      </div>
      <div class="trio">
        <img loading="lazy" decoding="async" alt="Vatican POV frame one" src="/images/cases/your-christian-date-broll-content/ycd/vat1.jpg">
        <img loading="lazy" decoding="async" alt="Vatican POV frame two" src="/images/cases/your-christian-date-broll-content/ycd/vat2.jpg">
        <img loading="lazy" decoding="async" alt="Vatican POV frame three" src="/images/cases/your-christian-date-broll-content/ycd/vat3.jpg">
      </div>
      <p class="cap-s">Top: the church series. Bottom: the Vatican follow-up, "I didn't flirt in the Vatican."</p>
    </div>
  </div>
</section>

<!-- Q4 -->
<section>
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q4 · How do you plan 60 videos a month?</span>
      <h2>Three buckets, <span class="cap v">one footage pool.</span></h2>
      <p class="lead">After the church series took off, I split January and February into three kinds of video. Each bucket reused footage I already had, plus a few new lines from the actor.</p>
    </div>
    <div class="variants">
      <div class="vrow"><div class="vh a">30 church and Vatican</div><div class="vb">Old and new lines from the actor, five different church backgrounds <span>scale the winner</span></div></div>
      <div class="vrow"><div class="vh b">20 product videos</div><div class="vb">A creator hook, then a screen recording of the app with "Check the link in bio" <span>show the product</span></div></div>
      <div class="vrow"><div class="vh c">11 re-edits</div><div class="vb">Winning lines laid over other creators' b-roll <span>reuse what worked</span></div></div>
    </div>
    <div class="vs">
      <div class="box">
        <span class="tag">Product video</span>
        <p>A hook from a creator, "how to find your Christian soulmate", cut straight into the app's profile feed.</p>
        <div class="pair"><img loading="lazy" decoding="async" alt="Creator hook, how to find your christian soulmate" src="/images/cases/your-christian-date-broll-content/ycd/prod1.jpg"><img loading="lazy" decoding="async" alt="App profile feed screencast" src="/images/cases/your-christian-date-broll-content/ycd/prod2.jpg"></div>
      </div>
      <div class="box dark">
        <span class="tag g dewtag">Re-edit</span>
        <p>"Faith first. Future together." A line that already worked, now on new footage and with the brand at the end.</p>
        <div class="pair"><img loading="lazy" decoding="async" alt="Faith first, future together" src="/images/cases/your-christian-date-broll-content/ycd/rend2.jpg"><img loading="lazy" decoding="async" alt="If you're taking her to church, not to your bed" src="/images/cases/your-christian-date-broll-content/ycd/rend3.jpg"></div>
      </div>
    </div>
  </div>
</section>

<!-- Q5 -->
<section class="dew">
  <div class="w">
    <div class="stack">
      <span class="q-kick">Q5 · What came out of it?</span>
      <h2>One hit, <span class="cap g">a steady tail behind it.</span></h2>
      <p class="lead">Numbers from the client review call in March 2026. The church Reel led. Several others landed between 20K and 100K, and an ordinary Reel held at one to two thousand views.</p>
    </div>
    <div class="kpis">
      <div class="kpi"><b>800K</b><span>views on the top Reel, the church POV. About 250K in month one, the rest over the next three weeks.</span></div>
      <div class="kpi"><b>100K</b><span>views on the next best Reel, then 70K and 50K. Several more around 20K.</span></div>
      <div class="kpi"><b>60</b><span>videos a month from b-roll, one-liners and one special shoot.</span></div>
    </div>
    <div class="learn">
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Funny beats preachy</h3><p>Observational humor about being new did the views. Videos that lectured people about how to be a good Christian went nowhere.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Footage is an asset</h3><p>Ordering raw b-roll once and tagging it meant every new idea could be tested the same day, without a new shoot.</p></div>
      <div class="box"><span class="tag hand-lbl">learned</span><h3>Geo matters on TikTok</h3><p>Autoposting put the TikTok account in the wrong region, and views came from Africa instead of the US. The hit lived on Instagram Reels. Post from the market you want.</p></div>
    </div>
  </div>
</section>

<!-- OFFER -->
<section>
  <div class="w">
    <div class="offer">
      <span class="q-kick">Q6 · What would this look like for you?</span>
      <h2>Order footage once. <span class="cap g">Edit it all year.</span></h2>
      <p class="lead">For apps and brands that need volume on social without a new shoot every week. I build the footage library, write the lines and run the edits.</p>
      <div class="steps">
        <div class="step"><span class="mono">step 1</span><b>Cast</b><p>Creators who look like your audience.</p></div>
        <div class="step"><span class="mono">step 2</span><b>Brief</b><p>Hooks to camera plus a b-roll shot list.</p></div>
        <div class="step"><span class="mono">step 3</span><b>Tag</b><p>Every clip catalogued and searchable.</p></div>
        <div class="step"><span class="mono">step 4</span><b>Edit</b><p>Dozens of videos a month from one pool.</p></div>
        <div class="step"><span class="mono">step 5</span><b>Scale</b><p>Find the hit, then shoot more of it.</p></div>
      </div>
      <div class="cta"><a class="btn" href="https://calendly.com/okad_calls/first" target="_blank" rel="noopener">Book a call</a><a class="btn" href="/#offer" style="background:#fff">10 videos · $500</a><span class="hn"><span style="flex:none"><svg width="54" height="22" viewBox="0 0 54 22"><path d="M51 12 C 36 16, 20 7, 5 11"/><path d="M13 4 L4 11 L12 18"/></svg></span><span class="hand">start here</span></span></div>
    </div>
  </div>
</section>

<p class="w case-foot">OKAD · Your Christian Date, 2025 to 2026. View counts are from the client review call in March 2026.</p>


  </div>
</Base>

<style is:global>
.case-designed{margin:0;padding:0;background:#ffffff}
.case-designed img{max-width:100%}
.case-designed .case-foot{padding-block:28px 44px;color:var(--soft);font-size:.85rem;max-width:1180px}
.case-designed .cta .btn + .btn{color:#111}
.case-designed{color-scheme:light}.case-designed{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}.case-designed img{max-width:100%}.case-designed [hidden]:not([hidden=until-found i]){display:none!important}

/* OKAD house style: white page, Instrument Serif caps for headlines, Instrument Sans for reading,
   Reenie Beanie for hand-written notes with drawn arrows. Pastel outline marks the key words;
   dew-green bands and black cards create rhythm. */
.case-designed{
  --paper:#ffffff; --card:#f4f4f1; --ink:#111111; --soft:#5f5f5b; --rule:#e6e6e1;
  --dew:#eefb6e; --dew-ink:#111111; --on-dew-card:#ffffff;
  --yel:#f2fa5a; --mint:#b5f5c6; --lav:#d4d4fc; --peach:#ffe2ad; --lilac:#ecc8fa;
  --hi:var(--dew); --hi-ink:#111111; --pink:#111111;
  --c1:#8f4fd6; --c2:#17904f;
  --stage:#121114; --stage-ink:#f4f4f0; --stage-soft:#b9b9b3;
  --good:#17904f; --mid:#c98a14; --bad:#d03e3e;
  --display:"Instrument Serif","Times New Roman",serif;
  --body:"Instrument Sans","Helvetica Neue",Arial,sans-serif;
  --hand:"Reenie Beanie","Bradley Hand",cursive;
  --mono:var(--body);
  --r:28px;
}
.case-designed{color-scheme:light}

.case-designed *{box-sizing:border-box}
.case-designed{background:var(--paper);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;margin:0}
.case-designed .w{max-width:1180px;margin:0 auto;padding-inline:20px}
.case-designed section{padding-block:96px;position:relative}
.case-designed p{margin:0;max-width:64ch}
.case-designed h1,.case-designed h2{font-family:var(--display);font-weight:400;margin:0;line-height:.94;text-transform:uppercase;letter-spacing:-.012em;text-wrap:balance}
.case-designed h1{font-size:clamp(2.8rem,6.4vw,5.6rem)}
.case-designed h2{font-size:clamp(2.3rem,4.9vw,4.1rem)}
.case-designed h3{font-family:var(--body);font-style:italic;font-weight:600;font-size:1.16rem;line-height:1.2;margin:0;letter-spacing:-.005em}
.case-designed .kick{font-family:var(--body);font-size:.92rem;color:var(--soft)}
.case-designed .lead{font-size:1.2rem;color:var(--soft);max-width:60ch}
.case-designed .stack{display:flex;flex-direction:column;gap:20px}
.case-designed .mono{font-family:var(--body);font-size:.8rem}
.case-designed .q-kick{font-family:var(--body);font-style:normal;font-weight:400;font-size:1rem;color:var(--soft)}
.case-designed .pro{font-size:.92rem;color:var(--soft);background:var(--card);border-radius:18px;padding:14px 18px 16px;max-width:70ch}
.case-designed .dew .pro{background:rgba(255,255,255,.55)}
.case-designed .pro b{display:block;font-family:var(--hand);font-style:normal;font-weight:400;font-size:1.7rem;line-height:.9;color:var(--ink);margin-bottom:2px}
.case-designed details.more{margin-top:32px}
.case-designed details.more summary{cursor:pointer;font-family:var(--body);font-weight:600;list-style:none;display:inline-flex;gap:10px;align-items:center;padding:12px 20px;border-radius:99px;background:var(--ink);color:var(--paper)}
.case-designed details.more summary::-webkit-details-marker{display:none}
.case-designed details.more summary::after{content:"+"}
.case-designed details.more[open] summary::after{content:"-"}
.case-designed .howto{display:flex;flex-wrap:wrap;gap:8px 22px;margin-top:26px;font-size:.88rem;color:var(--soft)}
.case-designed .howto b{color:var(--ink);font-style:normal;font-weight:600}

/* key words: thick pastel outline traced around the letters */
.case-designed .cap{--hl:transparent;color:inherit}
.case-designed .cap.g,.case-designed .cap.p,.case-designed .cap.y,.case-designed .cap.v,.case-designed h1 .cap.g{color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding-inline:.04em}
.case-designed .cap.g{--hl:var(--mint)} .case-designed .cap.p{--hl:var(--lilac)} .case-designed .cap.y{--hl:var(--peach)} .case-designed .cap.v{--hl:var(--lav)}
.case-designed h1 .cap.g{--hl:var(--yel)}
.case-designed .dew .cap.g,.case-designed .dew .cap.p,.case-designed .dew .cap.y,.case-designed .dew .cap.v{--hl:#ffffff}

/* hand-written notes */
.case-designed .hand{font-family:var(--hand);font-size:2.1rem;line-height:.95;color:var(--ink);font-weight:400}
.case-designed .ann{position:absolute;display:flex;gap:4px;align-items:flex-end;pointer-events:none;z-index:2}
.case-designed .ann svg,.case-designed .hn svg,.case-designed .arrow svg{fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .hn{display:flex;align-items:center;gap:8px;color:var(--ink)}

/* phone frames */
.case-designed .ph{position:relative;aspect-ratio:9/16;max-width:100%;border-radius:18px;overflow:hidden;background:#000}
.case-designed .ph img{width:100%;height:100%;object-fit:cover;display:block}
.case-designed .ph figcaption{position:absolute;left:8px;bottom:8px;right:8px;font-size:.7rem;color:#fff;background:rgba(0,0,0,.55);padding:4px 7px;border-radius:6px;line-height:1.3}
.case-designed figure{margin:0}

/* dew bands + black cards */
.case-designed .dew{background:var(--dew);color:var(--dew-ink);--ink:#111;--soft:#3d3f22;--card:var(--on-dew-card);--rule:rgba(17,17,17,.12)}
.case-designed .dark,.case-designed .box.dark,.case-designed .ins.dark{background:var(--stage)!important;color:var(--stage-ink);--ink:var(--stage-ink);--soft:var(--stage-soft);--rule:rgba(255,255,255,.14)}

/* cover */
.case-designed .cover{padding-block:28px 84px}
.case-designed .top{display:flex;justify-content:space-between;align-items:center;gap:16px;padding-block:20px}
.case-designed .logo{font-family:var(--display);font-size:1.7rem;letter-spacing:.02em}
.case-designed .cover-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center;margin-top:28px}
.case-designed .collage{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;position:relative}
.case-designed .collage .ph:nth-child(even){transform:translateY(28px)}
.case-designed .meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 24px;margin-top:8px}
.case-designed .meta div{display:grid;grid-template-columns:48px minmax(0,1fr);column-gap:12px;row-gap:2px;align-content:start;min-width:0;background:var(--card);border-radius:18px;padding:14px 16px}
.case-designed .meta div svg{grid-row:1 / span 2;width:48px;height:48px;fill:none;stroke:#111;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round;overflow:visible}
.case-designed .meta div svg .blob{stroke:none}
.case-designed .meta b{font-weight:600}
.case-designed .meta span{color:var(--soft);font-size:.92rem}

/* stat strip */
.case-designed .strip{display:grid;grid-template-columns:repeat(4,1fr);background:var(--card);border-radius:var(--r);margin-top:72px}
.case-designed .strip div{padding:26px 26px 24px;border-right:1px solid var(--rule)}
.case-designed .strip div:last-child{border-right:0}
.case-designed .strip b{display:block;font-family:var(--display);font-style:italic;font-size:3.6rem;font-weight:400;line-height:.95;font-variant-numeric:tabular-nums}
.case-designed .strip span{color:var(--soft);font-size:.92rem}

/* boxes */
.case-designed .two{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:start}
.case-designed .two>*{min-width:0}
.case-designed .before-after{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.case-designed .box{background:var(--card);border-radius:var(--r);padding:26px;display:flex;flex-direction:column;gap:12px;min-width:0}
.case-designed .box p{color:var(--soft)}
.case-designed .box ul{margin:0;padding-left:0;list-style:none;color:var(--soft);display:grid;gap:10px}
.case-designed .box li{background:#ffffff;border-radius:14px;padding:10px 14px}
.case-designed .dew .box li{background:var(--card)}
.case-designed .dark li,.case-designed .box.dark li{background:rgba(255,255,255,.07)!important}
.case-designed .tag{--hl:var(--yel);align-self:flex-start;font-family:var(--display);font-size:1.6rem;line-height:1;text-transform:uppercase;color:#111;text-shadow:0.090em 0.000em 1px var(--hl),0.087em 0.023em 1px var(--hl),0.078em 0.045em 1px var(--hl),0.064em 0.064em 1px var(--hl),0.045em 0.078em 1px var(--hl),0.023em 0.087em 1px var(--hl),0.000em 0.090em 1px var(--hl),-0.023em 0.087em 1px var(--hl),-0.045em 0.078em 1px var(--hl),-0.064em 0.064em 1px var(--hl),-0.078em 0.045em 1px var(--hl),-0.087em 0.023em 1px var(--hl),-0.090em 0.000em 1px var(--hl),-0.087em -0.023em 1px var(--hl),-0.078em -0.045em 1px var(--hl),-0.064em -0.064em 1px var(--hl),-0.045em -0.078em 1px var(--hl),-0.023em -0.087em 1px var(--hl),-0.000em -0.090em 1px var(--hl),0.023em -0.087em 1px var(--hl),0.045em -0.078em 1px var(--hl),0.064em -0.064em 1px var(--hl),0.078em -0.045em 1px var(--hl),0.087em -0.023em 1px var(--hl),0.050em 0.000em 0 var(--hl),0.043em 0.025em 0 var(--hl),0.025em 0.043em 0 var(--hl),0.000em 0.050em 0 var(--hl),-0.025em 0.043em 0 var(--hl),-0.043em 0.025em 0 var(--hl),-0.050em 0.000em 0 var(--hl),-0.043em -0.025em 0 var(--hl),-0.025em -0.043em 0 var(--hl),-0.000em -0.050em 0 var(--hl),0.025em -0.043em 0 var(--hl),0.043em -0.025em 0 var(--hl);padding:4px .08em 0}
.case-designed .tag.g{--hl:var(--mint)}
.case-designed .dark .tag{color:#111}
/* "Before": neutral, deliberately unappealing */
.case-designed .box.before .tag{color:var(--soft);text-shadow:none;padding-inline:0}
.case-designed .box.before li{color:#8a8a85}
/* hand caption label (Learned) */
.case-designed .tag.hand-lbl{font-family:var(--hand);font-size:2.3rem;text-transform:none;text-shadow:none;color:var(--soft);padding:0;line-height:.8}
.case-designed .dark .tag.hand-lbl{color:var(--stage-soft)}
/* openings: left = dew accents, right = no colour */
.case-designed .box.dark .tag.dewtag{--hl:var(--dew)}
.case-designed .box.plain .tag{text-shadow:none;color:var(--ink);padding-inline:0}
.case-designed .box.plain .hook-list li span{color:var(--soft)}
.case-designed .box .hook-list li{background:none!important;padding:0;border-radius:0}

/* research */
.case-designed .sources{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .sources .box:nth-child(2) .tag{--hl:var(--lav)} .case-designed .sources .box:nth-child(3) .tag{--hl:var(--peach)}
.case-designed .insights{display:grid;gap:18px;margin-top:56px}
.case-designed .ins{display:grid;grid-template-columns:1.3fr 70px .9fr 1.1fr;gap:20px;align-items:center;background:var(--card);border-radius:var(--r);padding:26px}
.case-designed .quote{font-family:var(--display);font-style:italic;font-size:1.75rem;font-weight:400;line-height:1.08}
.case-designed .quote small{display:block;margin-top:12px;font-family:var(--hand);font-style:normal;font-size:1.45rem;color:var(--soft);letter-spacing:0}
.case-designed .arrow{color:var(--ink);display:grid;place-items:center}
.case-designed .ins .ph{max-width:200px}
.case-designed .ins p{font-size:.98rem;color:var(--soft)}
.case-designed .ins p b{color:var(--ink);font-style:normal;font-weight:600}

/* matrix */
.case-designed .mx-wrap{overflow-x:auto;margin-top:36px;border-radius:var(--r);background:var(--card)}
.case-designed table{border-collapse:collapse;width:100%}
.case-designed .mx{min-width:760px;font-size:.92rem}
.case-designed .mx th,.case-designed .mx td{padding:14px 16px;border-bottom:1px solid var(--rule);text-align:left;vertical-align:top}
.case-designed .mx th{font-family:var(--display);font-size:1.15rem;text-transform:uppercase;color:var(--ink);font-weight:400}
.case-designed .mx tr:last-child td{border-bottom:0}
.case-designed .mx td:first-child{font-weight:600;white-space:nowrap}
.case-designed .mx .h{font-style:italic}
.case-designed .chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:24px}
.case-designed .chip{background:var(--card);border-radius:99px;padding:8px 16px;font-size:.92rem;font-family:var(--body);font-style:normal}
.case-designed .chip b{font-family:var(--body);font-style:normal;font-weight:600;font-size:.92rem}

/* formats (dew band, white post cards) */
.case-designed .fmt-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:44px;position:relative}
.case-designed .fmt{display:flex;flex-direction:column;gap:8px;min-width:0;background:var(--card);border-radius:22px;padding:12px 12px 18px}
