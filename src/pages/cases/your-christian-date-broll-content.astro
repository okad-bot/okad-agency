.case-designed .res td.n{font-variant-numeric:tabular-nums;font-family:var(--display);font-size:1.15rem}
.case-designed .res tr:last-child td{border-bottom:0}
.case-designed .st{display:inline-flex;align-items:center;gap:6px;font-size:.84rem}
.case-designed .st i{width:9px;height:9px;border-radius:50%}
.case-designed .s-g i{background:var(--good)} .case-designed .s-y i{background:var(--mid)} .case-designed .s-r i{background:var(--bad)}
.case-designed .loop{margin-top:40px;grid-template-columns:1.5fr 1fr}
.case-designed .funnel{display:grid;gap:10px;margin-top:6px}
.case-designed .fn{display:grid;grid-template-columns:90px minmax(0,1fr);gap:12px;align-items:center;font-size:.92rem}
.case-designed .fn .b{height:38px;border-radius:10px;background:var(--rule);display:flex;align-items:center;padding-left:12px;font-family:var(--display);font-style:normal;font-size:1.4rem;font-variant-numeric:tabular-nums;flex:none}
.case-designed .fn .b.g{background:var(--dew);color:#111;min-width:52px}
.case-designed .learn{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:16px}

/* results (dew band, black cards) */
.case-designed .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:44px}
.case-designed .kpi{background:var(--stage);color:var(--stage-ink);border-radius:var(--r);padding:30px;display:flex;flex-direction:column;gap:14px}
.case-designed .kpi b{font-family:var(--display);font-style:italic;font-size:5rem;font-weight:400;line-height:.85;font-variant-numeric:tabular-nums}
.case-designed .kpi span{color:var(--stage-soft);font-size:.95rem}

/* batch 2 */
.case-designed .reel{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-top:40px}

/* offer */
.case-designed .offer{background:var(--stage);color:var(--stage-ink);border-radius:36px;padding:60px 48px;display:grid;gap:28px;--ink:var(--stage-ink);--soft:var(--stage-soft)}
.case-designed .offer .lead{color:var(--stage-soft)}
.case-designed .offer .q-kick{color:var(--stage-soft)!important}
