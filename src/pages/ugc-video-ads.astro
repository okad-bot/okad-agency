---
import Base from '../layouts/Base.astro';
import '../styles/okad-house.css';

const CALL = 'https://calendly.com/okad_calls/first';
const ORDER_STARTER = 'mailto:olga@okad.agency?subject=Starter%20pack%20%E2%80%94%2010%20videos%20for%20%24500&body=Product%20link%3A%0AWhere%20you%20run%20ads%20(Meta%20%2F%20TikTok)%3A%0AAI%20or%20creator%20footage%3A%0A';

const guides = [
  { href: '/blog/blog-what-is-canvas-ugc', title: 'What Is Canvas UGC', desc: 'Definition, formats, and how brands use it' },
  { href: '/blog/blog-ugc-creator-rates-pricing', title: 'UGC Creator Pricing', desc: 'How much creators charge and what affects rates' },
  { href: '/blog/blog-canvas-ugc-jobs', title: 'Canvas UGC Jobs', desc: 'Where to find UGC work and what brands look for' },
  { href: '/blog/blog-ugc-video-ads-that-convert', title: 'UGC Ads That Convert', desc: 'Script structures and hooks that drive results' },
  { href: '/blog/blog-ugc-whitelisting-guide', title: 'UGC Whitelisting Guide', desc: 'Run ads from creator accounts on Meta and TikTok' },
  { href: '/blog/blog-high-volume-ugc-production', title: 'High Volume UGC', desc: 'How to produce 50+ videos a month without chaos' },
  { href: '/blog/blog-partnership-ads-spark-ads-guide', title: 'Partnership Ads Guide', desc: 'TikTok Spark Ads and Meta Partnership Ads explained' },
  { href: '/blog/blog-social-proof-ads-guide', title: 'Social Proof Ads', desc: 'Using reviews, testimonials, and trust in ad creative' },
  { href: '/blog/blog-tech-ugc-guide', title: 'Tech UGC Guide', desc: 'UGC strategies for SaaS, apps, and tech products' },
  { href: '/blog/blog-how-to-start-canvas-ugc', title: 'How to Start Canvas UGC', desc: 'Step-by-step guide to launching your first campaign' },
];

const industries = [
  { href: '/ugc-for-skincare', title: 'Skincare & Beauty', desc: 'Tutorials, unboxings, and before/after for beauty brands' },
  { href: '/ugc-for-fitness', title: 'Fitness & Supplements', desc: 'Workout demos, routines, and supplement reviews' },
  { href: '/ugc-for-food-brands', title: 'Food & Beverage', desc: 'Taste tests, recipes, and lifestyle content for CPG' },
  { href: '/video-ads-for-ecommerce', title: 'E-commerce', desc: 'Product demos, hauls, and conversion-focused ads' },
  { href: '/video-ads-for-apps', title: 'Mobile Apps', desc: 'Screen recordings, reaction videos, and app walkthroughs' },
];

const comparisons = [
  { href: '/okad-vs-vidico', title: 'OKAD vs Vidico', desc: 'Premium video studio vs performance-first creative testing' },
  { href: '/okad-vs-billo', title: 'OKAD vs Billo', desc: 'Marketplace model vs full-service production team' },
  { href: '/okad-vs-insense', title: 'OKAD vs Insense', desc: 'Creator platform vs end-to-end ad production' },
];

const steps = [
  { num: '01', title: 'Research', desc: 'We study your product, competitors, reviews, and ad history to find what angles to test.' },
  { num: '02', title: 'Script & Cast', desc: 'We write hooks and scripts, then match you with creators from our 600+ roster.' },
  { num: '03', title: 'Produce', desc: 'Creators film. We edit in native formats (9:16, 4:5) with captions and CTAs.' },
  { num: '04', title: 'Test & Scale', desc: 'Launch on Meta or TikTok, read the data, kill losers, scale winners, repeat.' },
];

const stats = [
  { num: '600+', label: 'Vetted creators' },
  { num: '10K+', label: 'Assets delivered' },
  { num: '100+', label: 'Brands served' },
  { num: '$500', label: 'Starter pack' },
];
---

<Base title="UGC Video Ads — Production, Testing & Scale | OKAD" description="Full-service UGC video ad production: strategy, scripts, 600+ creators, editing, and testing. From $500 for 10 videos.">
  <div class="okh">

    <!-- HERO -->
    <section class="khero" style="padding:80px 0 48px">
      <div class="w" style="max-width:900px">
        <span class="kick">UGC video ads agency</span>
        <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);margin-bottom:16px">UGC Video Ads That Actually <span class="cap">Convert</span></h1>
        <p class="lead">UGC video ads outperform polished brand content on Meta and TikTok because they look like real people talking, not like commercials. We handle the entire pipeline — research, scripts, creator matching, filming, editing, and creative testing — so you get ads that feel native and sell.</p>
        <div class="row" style="margin-top:32px">
          <a class="btn" href="#cta">Order 10 videos &middot; $500</a>
          <a class="btn ghost" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

    <!-- STATS ROW -->
    <section style="padding:0 24px 48px">
      <div class="strip">
        {stats.map((s) => (
          <div><b>{s.num}</b><span>{s.label}</span></div>
        ))}
      </div>
    </section>

    <!-- EXPLORE BY TOPIC -->
    <section style="max-width:960px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:8px">Explore by <span class="cap g">topic</span></h2>
      <p style="color:var(--soft,#4d4d49);margin-bottom:0">In-depth guides from producing 10,000+ UGC ads.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-top:24px">
        {guides.map((g) => (
          <a href={g.href} style="display:block;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;text-decoration:none;color:var(--text);border:1px solid var(--border,#e6e6e6);transition:border-color 0.2s">
            <strong style="display:block;font-size:15px;color:var(--dark,#111);margin-bottom:4px">{g.title}</strong>
            <span style="font-size:13px;color:var(--muted,#8e8e8e)">{g.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- BY INDUSTRY -->
    <section style="max-width:960px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:8px">UGC by <span class="cap y">industry</span></h2>
      <p style="color:var(--soft,#4d4d49);margin-bottom:0">Niche-specific strategies, creator types, and ad formats.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-top:24px">
        {industries.map((g) => (
          <a href={g.href} style="display:block;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;text-decoration:none;color:var(--text);border:1px solid var(--border,#e6e6e6);transition:border-color 0.2s">
            <strong style="display:block;font-size:15px;color:var(--dark,#111);margin-bottom:4px">{g.title}</strong>
            <span style="font-size:13px;color:var(--muted,#8e8e8e)">{g.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- COMPARE -->
    <section style="max-width:960px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:8px"><span class="cap p">Compare</span> agencies</h2>
      <p style="color:var(--soft,#4d4d49);margin-bottom:0">See how OKAD stacks up against other UGC and video ad platforms.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px;margin-top:24px">
        {comparisons.map((g) => (
          <a href={g.href} style="display:block;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;text-decoration:none;color:var(--text);border:1px solid var(--border,#e6e6e6);transition:border-color 0.2s">
            <strong style="display:block;font-size:15px;color:var(--dark,#111);margin-bottom:4px">{g.title}</strong>
            <span style="font-size:13px;color:var(--muted,#8e8e8e)">{g.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- HOW WE WORK -->
    <section style="max-width:960px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">How we <span class="cap v">work</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px">
        {steps.map((s) => (
          <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <span style="font-size:13px;font-weight:600;color:var(--muted,#8e8e8e);letter-spacing:0.05em">{s.num}</span>
            <strong style="display:block;font-size:17px;color:var(--dark,#111);margin:8px 0 6px">{s.title}</strong>
            <p style="font-size:14px;color:var(--soft,#4d4d49);line-height:1.5;margin:0">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--stage,#111);padding:80px 24px;text-align:center" id="cta">
      <div style="max-width:700px;margin:0 auto">
        <h2 style="color:#fff;font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:16px">Ready to test UGC video ads?</h2>
        <p style="color:var(--stage-soft,#8e8e8e);margin-bottom:32px">Get 10 video ads in 5 days. We handle strategy, creators, editing, and testing — you see what scales.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a class="btn" href={ORDER_STARTER}>Order 10 videos &middot; $500</a>
          <a class="btn dew" href={CALL} target="_blank" rel="noopener">Book a free strategy call</a>
        </div>
      </div>
    </section>

  </div>
</Base>
