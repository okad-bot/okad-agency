---
import Base from '../layouts/Base.astro';
import '../styles/okad-house.css';

const CALL = 'https://calendly.com/okad_calls/first';
const ORDER = '/#offer';

const whatIMake = [
  { title: 'AI product visuals', desc: 'Your product in real-life scenes, built from your own photos or customer photos. No studio, no shipping samples.' },
  { title: 'AI B-roll videos', desc: 'Scenes for hooks and backgrounds that would cost a shoot day to film.' },
  { title: 'Mixed ads', desc: 'A real creator for the face and the voice, AI for product shots, scenes and variations.' },
  { title: 'AI static ads', desc: 'Image ads for Meta and TikTok in batches, one layout in many versions.' },
  { title: 'Fully AI videos', desc: 'When the format allows it: explainers, product demos, faceless canvas formats.' },
];

const fitTable = [
  { goal: 'Test many angles cheaply', ai: 'Yes', human: '' },
  { goal: 'Product in lifestyle scenes', ai: 'Yes', human: '' },
  { goal: 'Testimonial, personal story', ai: '', human: 'Yes, people check if the person is real' },
  { goal: 'Health, beauty, results claims', ai: '', human: 'Yes, plus compliance check' },
  { goal: 'Hook and background B-roll', ai: 'Yes', human: '' },
  { goal: 'App demo, screen recording', ai: 'Partly', human: 'Best with a real hand and voice' },
];

const howItWorks = [
  { num: '1', desc: 'You send the product, your best and worst ads, and who buys.' },
  { num: '2', desc: 'I write angles and hooks and decide which parts are AI and which are filmed.' },
  { num: '3', desc: 'I generate, edit and check every frame: hands, text on packaging, product shape.' },
  { num: '4', desc: 'You get videos in 9:16 and 4:5, ready for Meta and TikTok.' },
  { num: '5', desc: 'After launch I look at the numbers and plan the next batch. More on how many variations to test.' },
];

const proofs = [
  { title: 'Dadada Baby', desc: 'AI product visuals of baby furniture built from customer photos. Real homes, real-looking light, no photo shoot.', link: '/cases/baby-furniture-ai-product-visuals', cta: 'Read the case' },
  { title: 'Drawing app', desc: 'Faceless canvas UGC that reached 1.5M organic views.', link: '/cases/drawing-app-faceless-ugc', cta: 'Read the case' },
  { title: 'Canvas and tech UGC without new shoots', desc: 'How I turn existing footage and screen recordings into new ads.', link: '/cases/canvas-tech-ugc-without-new-shoots/', cta: 'Read the guide' },
];

const faqs = [
  { q: 'What is AI UGC?', a: 'Video ads in the style of user-generated content, made fully or partly with AI: avatars, generated scenes, AI voice or AI product shots.' },
  { q: 'Do AI UGC ads work?', a: 'For testing angles and hooks, yes: you get more versions for the same budget. For testimonials and claims, real creators still build more trust.' },
  { q: 'Will Meta flag AI ads?', a: 'Meta asks to label some AI content. I follow platform rules and avoid fake testimonials.' },
  { q: 'Can you mix AI with my existing footage?', a: 'Yes, that\'s often the cheapest route. See modular production.' },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "AI UGC Agency",
  "provider": { "@type": "Organization", "name": "OKAD Agency", "url": "https://okad.agency" },
  "description": "AI UGC ads, AI product visuals and B-roll videos made by an editor, not a template. Cheaper than custom shoots. Start with 10 videos for $500.",
  "url": "https://okad.agency/ai-ugc-agency/",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://okad.agency/" },
    { "@type": "ListItem", "position": 2, "name": "AI UGC Agency" },
  ],
};
---

<Base title="AI UGC Ads Agency: AI Video Ads, Tested on Real Spend | OKAD" description="AI UGC ads, AI product visuals and B-roll videos made by an editor, not a template. Cheaper than custom shoots. Start with 10 videos for $500.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="okh">

    <!-- HERO -->
    <section class="khero" style="padding:80px 0 48px">
      <div class="w" style="max-width:900px">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>AI UGC Agency</span></nav>
        <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);margin-bottom:16px">AI UGC ads that don't look like <span class="cap">AI</span></h1>
        <p class="lead">Anyone can open an AI UGC tool and get an avatar talking about a product. The problem is that viewers have seen a thousand of them, and most of those ads die in the first two seconds.</p>
        <p style="margin-top:16px;color:var(--soft,#4d4d49)">I use AI where it saves money and keep a human where it makes the ad believable. The result: more videos to test for the same budget, without the uncanny look.</p>
        <div class="row" style="margin-top:32px">
          <a class="btn" href={ORDER}>Order 10 videos &middot; $500</a>
          <a class="btn ghost" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

    <!-- WHAT I MAKE WITH AI -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">What I make with <span class="cap g">AI</span></h2>
      <div style="display:grid;gap:16px">
        {whatIMake.map(item => (
          <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <strong style="display:block;margin-bottom:6px">{item.title}</strong>
            <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHERE AI WORKS AND WHERE IT DOESN'T -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">Where AI works and where it <span class="cap y">doesn't</span></h2>
      <div style="overflow-x:auto;border-radius:12px;border:1px solid var(--border,#e6e6e6)">
        <table style="width:100%;border-collapse:collapse;font-size:15px">
          <thead>
            <tr style="background:var(--off-white,#f7f7f7)">
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)">Goal</th>
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)">AI is a good fit</th>
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)">Use a real creator</th>
            </tr>
          </thead>
          <tbody>
            {fitTable.map(r => (
              <tr>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6);font-weight:600">{r.goal}</td>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6)">{r.ai}</td>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6)">{r.human}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p style="margin-top:16px;color:var(--soft,#4d4d49);font-size:15px">My rule: AI makes the testing cheaper, a real person makes the winner trustworthy. Most accounts end up with both.</p>
    </section>

    <!-- PROOF -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px"><span class="cap p">Proof</span></h2>
      <div style="display:grid;gap:16px">
        {proofs.map(c => (
          <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <strong style="display:block;margin-bottom:6px">{c.title}</strong>
            <p style="color:var(--soft,#4d4d49);margin:0 0 12px;font-size:15px">{c.desc}</p>
            <a href={c.link} style="font-size:14px;font-weight:600">{c.cta} →</a>
          </div>
        ))}
      </div>
      <!-- Real AI UGC examples -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:32px">
        <img src="/images/cases/ai-app-designed/img-05.jpg" alt="AI-generated portrait — before and after transformation" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
        <img src="/images/cases/ai-app/ai-app-10.webp" alt="AI UGC ad — business trust hook" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
        <img src="/images/cases/ai-app/ai-app-03.webp" alt="AI UGC ad — recruiter ranking photos" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
        <img src="/images/cases/ai-app-designed/img-01.jpg" alt="AI app UGC ad — LinkedIn question hook" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
      </div>
      <p style="margin-top:12px;color:var(--soft,#4d4d49);font-size:14px;text-align:center">Real AI UGC ads from client accounts</p>
    </section>

    <!-- VIDEO: Script Frameworks -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <div style="position:relative;padding-bottom:56.25%;height:0;border-radius:12px;overflow:hidden">
        <iframe src="https://www.youtube.com/embed/fPTZR_zlkjY" title="Top Performing UGC Script Frameworks" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
      <p style="margin-top:12px;color:var(--soft,#4d4d49);font-size:14px;text-align:center">The script frameworks I use for AI and creator videos</p>
    </section>

    <!-- HOW IT WORKS -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">How it <span class="cap v">works</span></h2>
      <div style="display:grid;gap:12px">
        {howItWorks.map(s => (
          <div style="display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <span style="width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew,#eefb6e);font-size:14px;font-weight:600;display:grid;place-items:center">{s.num}</span>
            <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">{s.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- AI UGC TOOL OR AGENCY -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:16px">AI UGC tool or AI UGC <span class="cap g">agency</span>?</h2>
      <p style="color:var(--soft,#4d4d49);margin-bottom:16px;font-size:15px">Tools like MakeUGC, Creatify or Arcads are great if you have time and someone who can write hooks and edit. You pay a subscription and do the work.</p>
      <p style="color:var(--soft,#4d4d49);font-size:15px">An agency makes sense when you don't want to learn prompts and editing, need the ads to look native, and want someone to read the results. I use these tools myself, along with image and video models, and my job is to make the output pass as a real post.</p>
    </section>

    <!-- PRICING -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:16px">Pricing</h2>
      <p style="color:var(--soft,#4d4d49);margin-bottom:16px;font-size:15px">AI and B-roll videos cost less than custom shoots. The <strong>$500 starter</strong> gets you 10 ready-to-run videos, AI or from my creator library, in 5 business days. Monthly plans start at <strong>$2,500</strong>. <a href="/ugc-pricing/">See UGC pricing</a>.</p>
    </section>

    <!-- FAQ -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">FAQ</h2>
      <div style="display:grid;gap:12px">
        {faqs.map(f => (
          <details style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <summary style="font-weight:600;cursor:pointer">{f.q}</summary>
            <p style="margin:12px 0 0;color:var(--soft,#4d4d49);font-size:15px">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--stage,#111);padding:80px 24px;text-align:center">
      <div style="max-width:700px;margin:0 auto">
        <h2 style="color:#fff;font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:16px">Ready to test AI UGC ads?</h2>
        <p style="color:var(--stage-soft,#8e8e8e);margin-bottom:32px">Get 10 video ads in 5 days. AI where it saves money, a human where it matters.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a class="btn" href={ORDER}>Order 10 videos &middot; $500</a>
          <a class="btn dew" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

  </div>
</Base>
