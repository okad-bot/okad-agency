---
import Base from '../layouts/Base.astro';
---

<Base title="Design Services — OKAD Agency" description="Web design, branding, pitch decks, and marketing materials for global brands.">

  <!-- Hero -->
  <div class="hero">
    <h1>200+ Websites & Brands <em>Designed</em></h1>
    <p class="hero-sub">Web design, branding, pitch decks, and marketing materials for global brands.</p>
  </div>

  <!-- Feature Cards -->
  <div class="features-grid">
    <div class="feature-card">
      <h3>Web Design</h3>
      <p>Sites on Framer, Webflow, and Shopify. Clean layouts, fast loading, works on any screen.</p>
    </div>
    <div class="feature-card">
      <h3>Branding</h3>
      <p>Logo, colors, fonts, guidelines — everything you need so the brand looks consistent everywhere.</p>
    </div>
    <div class="feature-card">
      <h3>Pitch Decks</h3>
      <p>Presentations for investors. Clear story, strong visuals, nothing extra.</p>
    </div>
    <div class="feature-card">
      <h3>Marketing Materials</h3>
      <p>Social posts, email templates, packaging, print — all in one style.</p>
    </div>
  </div>

  <!-- Featured Cases -->
  <h2 class="section-title">Featured Design Cases</h2>
  <section class="cases-section">

    <!-- Jumpman -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/okMGXM3X1P3IbyA8etRfLQXsTCk.png" alt="Jumpman branding" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">Branding</span>
        </div>
        <h3>Branding &mdash; Jumpman</h3>
        <p>Logo, visual system, colors, fonts, and brand book for a Paris cardio studio.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="mailto:olga@okad.agency?subject=Branding%20Project" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Intalent -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/Tdc8KUYgkNnSE3YxS5uEyJX4.png" alt="Intalent web design" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#Webflow</span>
          <span class="case-tag">#Framer</span>
          <span class="case-tag">#Shopify</span>
        </div>
        <h3>Web Design &mdash; Intalent</h3>
        <p>SaaS website on Framer. Clean pages, clear navigation, works on mobile.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="mailto:olga@okad.agency?subject=Web%20Design%20Project" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

  </section>

  <!-- Portfolio Grid -->
  <section class="portfolio-section">
    <h2 class="section-title">More Design Work</h2>
    <div class="portfolio-grid">
      <img src="https://framerusercontent.com/images/S1E8qDxE6cil2qXKc8AMtz6wVs.png" alt="Design portfolio 1" loading="lazy" />
      <img src="https://framerusercontent.com/images/b62qjvUmjLVTCd8WJ9SfsEpF8o.png" alt="Design portfolio 2" loading="lazy" />
      <img src="https://framerusercontent.com/images/kAkM8v5CwAIerVmAdmMIBTqM30.png" alt="Design portfolio 3" loading="lazy" />
      <img src="https://framerusercontent.com/images/yRU505Z52FJaY1wv77laoTUjxM.png" alt="Design portfolio 4" loading="lazy" />
      <img src="https://framerusercontent.com/images/w6fb6Lk9NVFWGcErwOjxMxsCrAs.png" alt="Design portfolio 5" loading="lazy" />
      <img src="https://framerusercontent.com/images/Hj87aXoVNswA39nVTP8YSDd3G00.png" alt="Design portfolio 6" loading="lazy" />
      <img src="https://framerusercontent.com/images/BNfMlg3TE8O0W6ihW5ISITW9eDQ.jpg" alt="Design portfolio 7" loading="lazy" />
      <img src="https://framerusercontent.com/images/wn57Y0QCiso41hmr5dSwHLFY.jpg" alt="Design portfolio 8" loading="lazy" />
    </div>
    <div class="portfolio-cta">
      <a href="https://www.behance.net/okad_agency" class="btn btn-outline" target="_blank" rel="noopener">Explore More on Behance</a>
    </div>
  </section>

  <!-- Pricing Preview -->
  <section class="projects-section">
    <h2 class="section-title">Design Pricing</h2>
    <div class="projects-grid">
      <div class="project-item">
        <span>Branding</span>
        <span>from $1,500</span>
      </div>
      <div class="project-item">
        <span>Landing page</span>
        <span>from $1,500</span>
      </div>
      <div class="project-item">
        <span>Multi-page website</span>
        <span>$1,700 - $7,500</span>
      </div>
      <div class="project-item">
        <span>Branding + website bundle</span>
        <span>from $5,000</span>
      </div>
      <div class="project-item">
        <span>Packaging design</span>
        <span>from $1,000</span>
      </div>
    </div>
    <div style="text-align:center;margin-top:24px;">
      <a href="/pricing" class="btn btn-outline">View full pricing</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact-section">
    <div class="contact-inner">
      <h2>Let's Talk Design</h2>
      <p>Tell us what you need — we'll send a proposal with timeline and relevant work.</p>
      <div class="contact-buttons">
        <a href="https://calendly.com/okad-agency/30min" class="btn" target="_blank" rel="noopener">Book a call</a>
        <a href="mailto:olga@okad.agency" class="contact-btn">Email us</a>
        <a href="/cases" class="contact-btn">View all cases</a>
      </div>
    </div>
  </section>

</Base>
