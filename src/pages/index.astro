---
import Base from '../layouts/Base.astro';
---

<Base title="OKAD Agency — Ad Creatives, UGC Video & Design" description="Ad creative testing, UGC video, web design & branding. 100+ brands, 10,000+ assets delivered.">

  <!-- Hero + Cases Carousel -->
  <div class="hero">
    <h1>Design & Video <em>[Scroll-Stopping Content]</em> <br class="d-break" />To Scale Your Marketing Metrics</h1>
    <p class="hero-sub">Ad creative testing · UGC video · Web & branding. 100+ brands. 10,000+ assets. One team, end to end.</p>
    <div class="hero-buttons">
      <a href="#contact" class="btn btn-hero">Start a Project</a>
    </div>
  </div>
  <h2 class="section-title carousel-title"><em>10,000+</em> Ads & Posts Created</h2>
  <div class="carousel hero-carousel">
    <div class="carousel-track">
      <a href="/cases/high-roas-ugc-ads" class="carousel-card">
        <img src="/images/BmUk0KMAPqqpLzpARwDdXhfg.gif" alt="High ROAS UGC Ads" loading="lazy" />
        <div class="carousel-info">
          <div class="carousel-tags"><span>#DTC</span><span>#E-COM</span></div>
          <h3>High ROAS UGC Ads</h3>
        </div>
      </a>
      <a href="/cases/high-converting-video-ads-for-dtc-brands" class="carousel-card">
        <img src="/images/j1iBjvbPI3bC6gVlOIvjMvQ0Oos.png" alt="AI static Ads" loading="lazy" />
        <div class="carousel-info">
          <div class="carousel-tags"><span>#DTC</span><span>UGC</span></div>
          <h3>AI Static Ads — 3x CTR</h3>
        </div>
      </a>
      <a href="/cases/ugc-creators-over-45" class="carousel-card">
        <img src="/images/FXMkq1jH116yCF0nIQPl2N2vc.png" alt="UGC Creators 45+" loading="lazy" />
        <div class="carousel-info">
          <div class="carousel-tags"><span>#SILVER_AGE</span><span>VIDEO</span></div>
          <h3>Creators 45+ — Trust-First</h3>
        </div>
      </a>
      <a href="/cases/organic-video-content-1m-views" class="carousel-card">
        <img src="/images/fgyKKr3g1dPjydOItu6UTCo3k8.gif" alt="1M views video content" loading="lazy" />
        <div class="carousel-info">
          <div class="carousel-tags"><span>#DIGITAL</span><span>#ORGANIC</span></div>
          <h3>1M+ Views — Dating & EdTech</h3>
        </div>
      </a>
      <a href="/cases/static-ad-creatives-digital-products" class="carousel-card">
        <img src="/images/WpH2ghvnLZkT7E1Ekkky6uTuFg.png" alt="High CPA Ads" loading="lazy" />
        <div class="carousel-info">
          <div class="carousel-tags"><span>#PAID_ADS</span><span>#DIGITAL</span></div>
          <h3>Static Ads for Meta & TikTok</h3>
        </div>
      </a>
      <a href="/cases/alcohol-ugc-content" class="carousel-card">
        <img src="/images/SBAkW2rwVUXKWpG9XA9enjK968.png" alt="Alco Brands" loading="lazy" />
        <div class="carousel-info">
          <div class="carousel-tags"><span>#ALCO</span><span>UGC</span></div>
          <h3>Alco UGC — Compliance-First</h3>
        </div>
      </a>
    </div>
  </div>

  <!-- Ad Approach Section -->
  <section class="approach-section fade-up">
    <h2>How We <em>Build</em> Ad Creatives</h2>
    <div class="carousel approach-carousel">
      <div class="carousel-track">
        <div class="approach-card">
          <span class="approach-metric">3–5</span>
          <h3>Variations Per Ad</h3>
          <p>We shoot one ad and cut 3–5 versions with different hooks to test.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">600+</span>
          <h3>Vetted Creators</h3>
          <p>Our own creators. You don't search — we match and brief them.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">Hook → CTA</span>
          <h3>Script-First Approach</h3>
          <p>Every video has a written script before anyone hits record.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">AI + Human</span>
          <h3>Creative Direction</h3>
          <p>We use AI to move faster, but a person decides what to make.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">1 Team</span>
          <h3>Zero Handoffs</h3>
          <p>Same people write the script, pick the creator, and edit the video.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">CTR · ROAS</span>
          <h3>Data In Every Brief</h3>
          <p>Before the next batch, we look at what actually performed.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">Scroll-Stop</span>
          <h3>Design First</h3>
          <p>If it doesn't catch the eye in the feed, it doesn't work.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Design Cases Carousel -->
  <div class="section-title-row fade-up">
    <h2 class="section-title"><em>200+</em> Websites & Brands Designed</h2>
    <a href="https://www.behance.net/okad_agency" class="btn btn-outline btn-behance-inline" target="_blank" rel="noopener">More on Behance →</a>
  </div>
  <div class="carousel fade-up">
    <div class="carousel-track">
      <a href="/cases/case-jumpman" class="carousel-card">
        <img src="/images/okMGXM3X1P3IbyA8etRfLQXsTCk.png" alt="Jumpman branding" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>BRANDING</span></div>
          <h3>Jumpman — Paris</h3>
          <p>Branding for a Paris cardio studio.</p>
        </div>
      </a>
      <a href="/cases/case-jumpman-website-main" class="carousel-card">
        <img src="/images/Tdc8KUYgkNnSE3YxS5uEyJX4.png" alt="Intalent web design" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>WEBFLOW</span><span>FRAMER</span><span>SHOPIFY</span></div>
          <h3>Web Design — Intalent</h3>
          <p>Webflow site, mobile-first.</p>
        </div>
      </a>
      <a href="/cases/case-lingoculture" class="carousel-card">
        <img src="/images/S1E8qDxE6cil2qXKc8AMtz6wVs.png" alt="LingoCulture pitch deck" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>PITCH DECK</span></div>
          <h3>LingoCulture</h3>
          <p>Pitch deck for a French learning platform.</p>
        </div>
      </a>
      <a href="/cases/case-jardins-etretat-redesign-main" class="carousel-card">
        <img src="/images/Eru8rMMcLr7V4Q793EdYywHjY.jpg" alt="Les Jardins d'Etretat redesign" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>WEB</span><span>FRAMER</span></div>
          <h3>Étretat — Redesign</h3>
          <p>Website redesign for a French venue.</p>
        </div>
      </a>
    </div>
  </div>
  <div class="behance-cta behance-cta-mobile">
    <a href="https://www.behance.net/okad_agency" class="btn btn-outline" target="_blank" rel="noopener">More on Behance →</a>
  </div>
  <!-- Design Approach Section -->
  <section class="approach-section fade-up">
    <h2>How We <em>Design</em> Brands & Websites</h2>
    <div class="carousel approach-carousel">
      <div class="carousel-track">
        <div class="approach-card">
          <span class="approach-metric">0.3 sec</span>
          <h3>Attention Design</h3>
          <p>People don't read websites. We make sure they still get it.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">Full Pack</span>
          <h3>Brand + Web + Assets</h3>
          <p>We do the logo, site, deck, and templates — it all looks like one brand.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">AI + No-Code</span>
          <h3>Framer · Webflow · Shopify</h3>
          <p>No custom code. You'll update content yourself after launch.</p>
        </div>
        <div class="approach-card">
          <span class="approach-metric">Mobile ←→</span>
          <h3>Mobile-First Design</h3>
          <p>Most of your visitors are on phones. We start there.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section fade-up">
    <h2><em>Trusted</em> by <br class="d-break" />100+ Brands</h2>
    <div class="logos-proof">
      <img src="/logos/logo-0.png" alt="" />
      <img src="/logos/logo-1.png" alt="" />
      <img src="/logos/logo-2.png" alt="" />
      <img src="/logos/logo-3.png" alt="" />
      <img src="/logos/logo-4.png" alt="" />
      <img src="/logos/logo-5.png" alt="" />
      <img src="/logos/logo-6.png" alt="" />
      <img src="/logos/logo-7.png" alt="" />
      <img src="/logos/logo-8.png" alt="" />
      <img src="/logos/logo-9.png" alt="" />
      <img src="/logos/logo-10.png" alt="" />
      <img src="/logos/logo-11.png" alt="" />
      <img src="/logos/logo-12.png" alt="" />
      <img src="/logos/logo-13.png" alt="" />
      <img src="/logos/logo-14.png" alt="" />
      <img src="/logos/logo-15.png" alt="" />
      <img src="/logos/logo-16.png" alt="" />
      <img src="/logos/logo-17.png" alt="" />
      <img src="/logos/logo-18.png" alt="" />
      <span>Seamoss</span>
      <span>Longevity</span>
    </div>
    <div class="carousel testimonial-carousel">
    <div class="carousel-track">
      <div class="testimonial-card">
        <blockquote>Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.</blockquote>
        <div class="testimonial-author">
          <img src="/images/9yQb8hBXfQCe1f6JkqCRMnt4AKs.jpeg" alt="Maxime Lenzlinger" loading="lazy" />
          <div>
            <div class="testimonial-name">Maxime Lenzlinger</div>
            <div class="testimonial-role">Co-founder / Marketing, VUE SWISS</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>The final result exceeded my expectations. The structure was clear, the content was well-aligned with the brand tone.</blockquote>
        <div class="testimonial-author">
          <img src="/images/mkinoi0MbzI3iMzkSDbgPOq2GI.png" alt="Kristina Hr." loading="lazy" />
          <div>
            <div class="testimonial-name">Kristina Hr.</div>
            <div class="testimonial-role">Marketing, Mushroom genetics</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>You're the best team I've ever worked with. You are professional, organized, creative, and kind.</blockquote>
        <div class="testimonial-author">
          <img src="/images/LaQrt95uuBqxdIKPQ5u3sWttcvc.png" alt="Claire Ginn" loading="lazy" />
          <div>
            <div class="testimonial-name">Claire Ginn</div>
            <div class="testimonial-role">Founder, YPM Agency</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>Olga and her team are some of the best designers around. They're creative, work efficiently, and always deliver quality work.</blockquote>
        <div class="testimonial-author">
          <img src="/images/fyo2eKnJgN0TDx8SMjUG2NCqWk.jpeg" alt="Damon Dixon" loading="lazy" />
          <div>
            <div class="testimonial-name">Damon Dixon</div>
            <div class="testimonial-role">Founder, Douxds</div>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section fade-up" id="contact">
    <div class="contact-inner">
      <img src="/images/q6hHpGFkcDHUGgEMPAoS5KUCo.png" alt="Olga Kad Miller" class="contact-avatar" />
      <span class="contact-author-name">Olga Kad Miller, Founder</span>
      <h2>Let's <em>Talk</em></h2>
      <p class="contact-desc">I review every brief and write the strategy myself.</p>
      <div class="contact-actions">
        <a href="https://calendly.com/okad_calls/first" class="contact-btn-primary" target="_blank" rel="noopener">Book a Call</a>
        <a href="mailto:olga@okad.agency" class="contact-btn-secondary">Email Us</a>
        <a href="https://www.linkedin.com/in/o-kad/" class="contact-btn-secondary" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </section>

  <!-- Videos Section -->
  <section class="videos-section fade-up">
    <h2><em>Behind</em> the Scenes</h2>
    <div class="video-grid">
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=-UTQ0HyGE80" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/-UTQ0HyGE80/hqdefault.jpg" alt="High-Converting UGC Video Ad System" loading="lazy" />
          <p>High-Converting UGC Video Ad System</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=6ww6ykmc2Pw" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/6ww6ykmc2Pw/hqdefault.jpg" alt="How to create Static Ads / 4 Elements every Ad needs" loading="lazy" />
          <p>How to create Static Ads / 4 Elements every Ad needs</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=UxOC3_DvR2o" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/UxOC3_DvR2o/hqdefault.jpg" alt="How We Build Websites That Convert" loading="lazy" />
          <p>How We Build Websites That Convert</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=njD3orMjpoM" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/njD3orMjpoM/hqdefault.jpg" alt="Full Branding vs Micro-Branding / 6 Real Projects" loading="lazy" />
          <p>Full Branding vs Micro-Branding / 6 Real Projects</p>
        </a>
      </div>
    </div>
  </section>

</Base>
