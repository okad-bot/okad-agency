---
import Base from '../layouts/Base.astro';
import '../styles/okad-home2.css';
import fs from 'node:fs';

const CALL = 'https://calendly.com/okad_calls/first';
// Brief form ("Without a call"). Paste the endpoint of your form service here (Formspree, Basin, Getform, Web3Forms...).
// Empty = the form opens an email with everything filled in, so it works before the service is connected.
const FORM_ACTION = 'https://okad.cc/api/okad-brief/submit';
const EMAIL = 'olga@okad.agency';
const CASE1 = '/cases/creative-testing-ai-app-meta-ads';
const CASE2 = '/cases/drawing-app-faceless-ugc';
const CASE3 = '/cases/ad-re-edits-five-brands';
const CASE4 = '/cases/by-okad-camera-roll-creators';
const CASE_LK = '/cases/lookalikey-ugc-ads';
const ZENTOES = '/cases/zentoes-walmart-launch-ads';
const AI_BOOK = '/cases/ai-book-trailers/';
const PROTEIN = '/cases/protein-pouch-ugc-ads/';
const AI_SHUGGLE = '/cases/shuggle-ai-video/';
const AI_JEWELRY = '/cases/ai-jewelry-content/';
const COV = '/images/cases/covers/okad-cover-';

const mail = (subject: string, body: string) => 'mailto:' + EMAIL + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
const BRIEF = mail('Brief: what would you test?', 'Brand and website:\nWhat you sell and to whom:\nLinks to your ads or accounts (Meta ad library is fine):\nFootage you already have (Drive or Dropbox link):\nWhat you need: monthly ads / $1,000 test / organic / not sure\n');
// swap TEST for the Stripe payment link once it exists
const TEST = mail('$1,000 test', 'Brand and website:\nWhat to test (re-edits, UGC, AI videos, statics, or not sure):\nLink to your ads (Meta ad library is fine):\n');
const ORGANIC = mail('Organic content plan', 'App or brand and website:\nWhere you post (Instagram, TikTok...):\nLinks to your accounts:\nAny footage you already have:\n');
const PRODUCTION = mail('Production only', 'Brand and website:\nWhat you need and how many:\nYour plan or brief:\n');
const AGENCY = mail('White-label ads', 'Agency and website:\nWhat your clients need:\nHow many videos a month:\n');

// hero rail: first six were picked for the first screen, the rest follow
const wall = [
  { v: '/videos/hero-facetime', t: 'UGC', c: 'AI headshot app', h: CASE1, webm: true },
  { v: '/videos/case2-cream', t: 'Re-edit', c: 'ZenToes', h: ZENTOES, webm: true },
  { v: '/videos/rail-lookalikey', t: 'UGC', c: 'Lookalikey', h: CASE_LK, webm: true },
  { v: '/images/cases/longevity-supplement-story-ads/lg/v/athletes', t: 'Story ad', c: 'Longevity brand', h: '/cases/longevity-supplement-story-ads' },
  { v: '/videos/hero-ugc', t: 'UGC', c: 'AI headshot app', h: CASE1, webm: true },
  { v: '/cases/ai-jewelry-content/assets/video/d_6', t: 'AI video', c: 'Jewelry brand', h: AI_JEWELRY },
  { v: '/cases/ai-book-trailers/assets/video/b_v1', poster: '/cases/ai-book-trailers/assets/img/img-01.jpg', t: 'AI video', c: 'Book publisher', h: AI_BOOK },
  { v: '/images/cases/ad-re-edits-five-brands/ad/v/cflags', t: 'Re-edit', c: 'Gut health brand', h: CASE3 },
  { v: '/cases/shuggle-ai-video/assets/video/s_gala', poster: '/cases/shuggle-ai-video/assets/img/img-02.jpg', t: 'AI video', c: 'Shuggle', h: AI_SHUGGLE },
  { v: '/videos/hero-todo', t: 'UGC', c: 'AI headshot app', h: CASE1, webm: true },
  { v: '/images/cases/ad-re-edits-five-brands/ad/v/cbrain', t: 'Re-edit', c: 'Supplement brand', h: CASE3 },
];

const stats = [
  ['−35%', 'cost per customer, AI app', CASE1],
  ['2.2', 'ROAS on the first test, Lookalikey', CASE_LK],
  ['5,471', 'sign-ups from organic, $0 on ads', CASE4],
  ['1.5M', 'organic views, iPad app', CASE2],
];

const make = [
  ['Re-edits', 'From your old footage', 'New hooks, order and sound. Ready in days.'],
  ['UGC', 'Real people, 3,000+ creators', 'When buyers need to see someone use it.'],
  ['AI video', 'No footage, no shoot', 'When you need volume fast or a scene nobody can film. Not plastic: see the jewelry case.'],
  ['Statics', 'Images and carousels', 'When your product sells with a picture.'],
];

const cases = [
  { c: 'lime', href: CASE1, img: COV + 'ai-headshot-app.webp', fmt: 'UGC', tags: ['case 01', 'Consumer AI app'], h: 'From 2 videos that ever worked <em>to 160+ ads</em> in four months', p: 'Scripts from research, matched creators, native formats. Sales picked the winners.' },
  { c: 'mint', href: CASE_LK, img: COV + 'lookalikey.webp', fmt: 'UGC', tags: ['case 02', 'Lookalikey · gift cards'], h: 'Their ads explained the feature. <em>Mine show what happens next.</em>', p: 'First test: 3 creators, 3 videos each, no word "AI" in any script. A family hooked on one card became the winner.' },
  { c: 'lav', href: CASE4, img: COV + 'by-okad.webp', fmt: 'Organic', tags: ['case 03', 'User acquisition'], h: 'Organic Reels. <em>5,000+ sign-ups, $0 on ads.</em>', p: 'Reels from old clips, borrowed formats and offers tested like hooks. No new shoots, no ad spend.' },
];
const moreCases = [
  { href: CASE3, img: COV + 'ad-re-edits.webp', fmt: 'Re-edits' },
  { href: AI_JEWELRY, img: '/cases/ai-jewelry-content/assets/img/cover.jpg', fmt: 'AI content' },
  { href: ZENTOES, img: COV + 'zentoes.webp', fmt: 'Re-edits + statics' },
  { href: PROTEIN, img: COV + 'protein-pouch.webp', fmt: 'UGC' },
  { href: AI_BOOK, img: '/cases/ai-book-trailers/assets/img/cover.jpg', fmt: 'AI video' },
  { href: AI_SHUGGLE, img: '/cases/shuggle-ai-video/assets/img/cover.jpg', fmt: 'AI video' },
];

const testOpts = [
  ['You have old footage', '20 re-edits'],
  ['You need real people', '5 UGC videos'],
  ['No footage, need it fast', '3 to 5 AI videos'],
  ['You sell with images', '20 static ads'],
];
const testDays = [
  ['Day 1', 'You send a link and any footage'],
  ['Day 2 to 3', 'I send the test plan and scripts'],
  ['Day 5', 'First ads ready. UGC: 2 to 3 weeks'],
  ['Then', 'You launch, I tell you what to make next'],
];

// Real client quotes. Never edit the wording.
const quotes = [
  ["Olga has been great to work with. She's reliable, collaborative, and incredibly responsive to feedback. The quality of her work is outstanding.", 'Michele Laikowski', 'Assistant Director Digital Marketing, Kensington Publishing', 'AI video · book publisher'],
  ["Creator B content has performed the best, especially 'I created one card and now my whole family is obsessed'. We're currently running at a 1.96 ROAS, recently hitting more towards 2.20 ROAS.", 'Spencer Herron', 'Lookalikey', 'UGC ads · first test'],
  ["The videos, especially the Three Split Screen concept, performed really well, and we're still leveraging them in our campaigns today.", 'Lina Lin', 'Athena Club', 'UGC ads'],
  ['Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.', 'Maxime Lenzlinger', 'Co-founder, VUE SWISS', 'Video ads'],
  ["I really like that we've anchored every video clearly in our three pillars. From my side, this direction is solid and consistent with how we want STIGA to show up.", 'Karl Inde', 'STIGA', 'Video'],
  ['Let me re-iterate how much we enjoy and appreciate the quality of your work, but more importantly, your sense of urgency when you know things are time-sensitive. We are so lucky to have you :)', 'Varun Godha', 'Diamondere', 'AI content'],
  ["You're the best team I've ever worked with. You are professional, organized, creative, and kind.", 'Claire Ginn', 'Founder, YPM Agency', 'Agency partner'],
];

const faqs = [
  ['Can we work without a call?', "Yes. Fill in the short brief at the bottom of this page. Within 24 business hours I reply with what I'd test first and the price. You pay by link and I start."],
  ['How fast do I get the first ads?', 'First ads in 5 business days. UGC with new creators takes 2 to 3 weeks.'],
  ['What if nothing works?', 'Some ads will lose, that\'s what a test is for. At the start I ask how bold you want to go: safer ideas built on what already works for you and your competitors, or new ideas that can win big or flop. At minimum you get a tested answer. At best, a new winner. Tests need enough volume, so I plan them with enough ads.'],
  ['Where are your creators?', 'In every big market: the US, UK, Europe, the Middle East, Asia and more. Any age, look and background. Any language.'],
  ['Are creator fees included?', 'No, they come on top and depend on the brief. I tell you the full price before we start.'],
  ['Do you run the ads?', 'No, your team or media buyer runs them. I read the results and plan the next batch.'],
  ['Can I cancel the monthly plan?', "Yes, any time with one month's notice."],
  ['How do I pay?', '100% upfront for each test or month.'],
  ['What is the smallest order?', 'The $1,000 test. For ads without strategy, Production only starts at $2,500 a month.'],
];

const clientLogos = fs.existsSync('public/logos/clients') ? fs.readdirSync('public/logos/clients').filter((f) => /\.(png|svg|webp)$/i.test(f)).sort().map((f) => `/logos/clients/${f}`) : [];
const logos = [...clientLogos, ...Array.from({ length: 19 }, (_, i) => `/logos/logo-${i}.png`)];
---

<Base title="OKAD · Ads and organic content, tested every month" description="Fresh ads, fast, with a strategist behind every one: UGC, AI video, re-edits and statics. Monthly creative testing from $4,000 or a $1,000 test. 100+ brands, 10,000+ ads.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'OKAD', url: 'https://okad.agency/', email: EMAIL, founder: { '@type': 'Person', name: 'Olga Kad Miller', sameAs: ['https://www.linkedin.com/in/o-kad/', 'https://www.instagram.com/by.okad/'] }, areaServed: 'Worldwide', address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' }, priceRange: '$1,000 to $7,000+' })} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) })} />
  </Fragment>

  <div class="k2">
    <!-- HERO -->
    <section class="khero2" id="ads">
      <div class="w">
        <div class="chips" aria-label="What I make"><a href="#make">UGC</a><a href="#make">AI video</a><a href="#make">Re-edits</a><a href="#make">Static ads</a></div>
        <h1>Fresh ads, <span class="circ">fast.</span> <span class="cap">A <mark>strategist</mark> behind every one.</span></h1>
        <p class="lead">New ads and organic content every month, tested, with a clear answer on what to make next.</p>
        <div class="btns">
          <a class="btn" href={CALL} target="_blank" rel="noopener">Book a call</a>
          <a class="btn line" href="#test">$1,000 test</a>
        </div>
        <p class="micro"><a href="#start">No call? Send a short brief →</a></p>
        <div class="rail-top">
          <span>Tap a video for sound</span>
          <span class="rnav"><button type="button" data-rail="wl" data-dir="-1" aria-label="Previous">←</button><button type="button" data-rail="wl" data-dir="1" aria-label="Next">→</button></span>
        </div>
      </div>
      <div class="wall" id="wl">
        {wall.map((x, i) => (
          <figure class="wv">
            <div class="ph">
              <video data-lazy poster={x.poster ?? `${x.v}.jpg`} muted loop playsinline preload={i < 4 ? 'metadata' : 'none'} aria-label={`${x.t} ad for ${x.c}`}>
                {x.webm && <source data-src={`${x.v}.webm`} type="video/webm" />}
                <source data-src={`${x.v}.mp4`} type="video/mp4" />
              </video>
              <span class="tag">{x.t}</span>
              <span class="snd" aria-hidden="true">sound off</span>
            </div>
            <a href={x.h}>{x.c} →</a>
          </figure>
        ))}
      </div>
    </section>

    <!-- NUMBERS + LOGOS -->
    <section class="sec">
      <div class="w">
        <p class="small">Numbers I can share. Most clients are under NDA.</p>
        <div class="nums">{stats.map(([b, s, h]) => <a href={h}><b>{b}</b><span>{s}</span></a>)}</div>
      </div>
      <p class="small center">Brands I have made ads for</p>
      <div class="logos"><div class="lt">{[...logos, ...logos].map((src, i) => <img src={src} alt="" aria-hidden={i >= logos.length ? 'true' : undefined} loading="eager" decoding="async" height="26" />)}</div></div>
    </section>

    <!-- WHAT I MAKE -->
    <section class="sec" id="make"><span id="services"></span>
      <div class="w narrow">
        <p class="eyebrow">Any mix, every month</p>
        <h2>What I <em>make</em></h2>
        <div class="mk">{make.map(([t, b, p]) => <div><i>{t}</i><p><b>{b}</b>{p}</p></div>)}</div>
        <div class="inmonth"><b>~50 ads</b><span>in a $4,000 month with strategy and scripts. For example: 10 UGC, 20 re-edits, 20 statics</span></div>
      </div>
    </section>

    <!-- CASES -->
    <section class="sec" id="cases">
      <div class="w">
        <p class="eyebrow">Real ad accounts, real numbers</p>
        <h2>Selected <em>cases</em></h2>
        <p class="niche">Ads for apps, supplements, beauty, fashion, dating, books, electronics and more.</p>
        <div class="cases">
          {cases.map((x) => (
            <a class={`case ${x.c}`} href={x.href}>
              <img src={x.img} alt="" loading="lazy" width="1500" height="1200" />
              <div class="tags"><span class="fmt">{x.fmt}</span>{x.tags.map((t) => <span>{t}</span>)}</div>
              <h3 set:html={x.h} />
              <p>{x.p}</p>
              <span class="btn">Read the case →</span>
            </a>
          ))}
        </div>
        <p class="small">More cases, swipe →</p>
      </div>
      <div class="crail">
        {moreCases.map((x) => <a href={x.href}><img src={x.img} alt="" loading="lazy" /><span class="fmt">{x.fmt}</span></a>)}
        <a class="all" href="/cases/">All cases →</a>
      </div>
    </section>

    <!-- TEST PLAN -->
    <section class="sec" id="plan">
      <div class="w narrow">
        <p class="eyebrow">What you get before a single ad is made</p>
        <h2>A real <em>test plan</em></h2>
        <div class="plan" aria-hidden="true">
          <img src="/images/test-plan/plan-1.jpg" alt="" loading="lazy" class="p1" />
          <img src="/images/test-plan/plan-2.jpg" alt="" loading="lazy" class="p2" />
          <img src="/images/test-plan/plan-3.jpg" alt="" loading="lazy" class="p3" />
          <span class="lock">Client details hidden</span>
        </div>
        <ul class="ticks"><li>Which angles I test first, and why</li><li>What each ad checks: hook, format or audience</li><li>The copy for every ad</li><li>How to spot the winner in your ad account</li></ul>
        <figure class="q">
          <blockquote>"This is super, exactly the type of research and detail I was after to validate why to proceed with each test and how to track and identify the winning variable easily."</blockquote>
          <figcaption><b>Thomas G.</b>Founder, UK socks brand</figcaption>
        </figure>
        <a class="btn full" href={CALL} target="_blank" rel="noopener">Book a call</a>
      </div>
    </section>

    <!-- HOW WE WORK -->
    <section class="sec" id="work"><span id="offer"></span><span id="how"></span>
      <div class="w">
        <div class="why narrow"><b>2 to 3 weeks</b>That's how fast most ads burn out. After that you pay more for the same customer, so new ones need to keep coming.</div>
        <p class="eyebrow">Pick the way that fits you</p>
        <h2>How we <em>work</em></h2>
        <div class="ways">
          <div class="card dark">
            <p class="step">Monthly creative testing</p>
            <h3>New ads every month</h3>
            <p class="price">$4,000 to $7,000+ <span>/ month</span></p>
            <p class="fit">For brands and apps that spend on ads every month and need fresh ones that sell.</p>
            <div class="tiers">
              <div><p class="tt">Core</p><p class="p">$4,000</p><p>About 50 ads a month, any mix</p></div>
              <div><p class="tt">Scale</p><p class="p">$7,000+</p><p>About 100 ads a month, more UGC</p></div>
            </div>
            <p class="note">UGC creator fees on top.</p>
            <ul class="ticks"><li>Strategy, test plan and every script</li><li>New hooks on the ads that work</li><li>I read your results after every batch and plan the next one</li></ul>
            <a class="btn dew full" href={CALL} target="_blank" rel="noopener">Book a call</a>
            <a class="link" href="#test">or start with a $1,000 test</a>
          </div>

          <div class="card dewc" id="test">
            <p class="step">Not sure yet?</p>
            <h3>Start with one test</h3>
            <p class="price">$1,000 <span>one time</span></p>
            <p class="fit">I pick the format for your situation:</p>
            <div class="opts">{testOpts.map(([s, o]) => <div><span>{s}</span><b>{o}</b></div>)}</div>
            <p class="note">UGC creator fees on top.</p>
            <div class="days">{testDays.map(([d, t]) => <p><b>{d}</b>{t}</p>)}</div>
            <p class="credit">Liked the results? Your first month starts right after the test.</p>
            <a class="btn full" href={CALL} target="_blank" rel="noopener">Book a call to start</a>
            <a class="link" href="#start">or start without a call</a>
          </div>

          <div class="card path">
            <p class="step">Organic content</p>
            <h3>For apps and new brands</h3>
            <p class="price">from $2,500 <span>/ month</span></p>
            <p class="fit">A content plan, scripts, and Reels and TikToks from your footage, creators or AI. Starting from zero is fine. What works in organic becomes your first ads.</p>
            <a class="btn line full" href={CALL} target="_blank" rel="noopener">Book a call</a>
          </div>

          <div class="card path">
            <p class="step">Production only</p>
            <h3>You bring the plan</h3>
            <p class="price">from $2,500 <span>/ month</span></p>
            <p class="fit">No strategy, just the ads you ask for.</p>
            <div class="pp"><span>Re-edits</span><b>from $50</b><span>UGC with creators</span><b>from $100 + creator fee</b><span>AI video</span><b>from $200</b><span>Static ads</span><b>from $50</b></div>
            <a class="btn line full" href={CALL} target="_blank" rel="noopener">Book a call</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ME -->
    <section class="sec" id="contact">
      <div class="w narrow">
        <div class="me">
          <div class="top"><img src="/images/thumbs/olga.webp" width="64" height="64" alt="Olga Kad Miller" /><div><p class="hand">Olga Kad Miller</p><p class="role">Founder, OKAD · Lisbon</p></div></div>
          <h3>I'm a creative strategist who still makes ads with my own hands</h3>
          <ul class="ticks"><li>10,000+ ads and posts for 100+ brands</li><li>Many of my own videos passed 1M views</li><li>I edit a big part of the ads myself</li></ul>
          <p class="team">I lead the strategy and write every script. Editors, a designer and 3,000+ creators make the ads with me. You always talk to me.</p>
          <a class="btn dew full" href={CALL} target="_blank" rel="noopener">Book a call</a>
          <a class="link" href="#start">or start without a call</a>
          <p class="soc"><a href="https://www.linkedin.com/in/o-kad/" target="_blank" rel="noopener">LinkedIn</a><a href="https://www.instagram.com/by.okad/" target="_blank" rel="noopener">@by.okad</a><a href="https://www.youtube.com/@okad_agency" target="_blank" rel="noopener">YouTube</a></p>
        </div>
      </div>
    </section>

    <!-- QUOTES -->
    <section class="sec">
      <div class="w">
        <h2>What clients <em>say</em></h2>
        <p class="small">Swipe for more →</p>
      </div>
      <div class="qrail">
        {quotes.map(([q, n, r, s]) => <figure class="q"><p class="src">{s}</p><blockquote>"{q}"</blockquote><figcaption><b>{n}</b>{r}</figcaption></figure>)}
      </div>
      <div class="w"><p class="partner">Official partner of <img src="/images/partners/influee-badge.webp" alt="Influee" height="22" loading="lazy" /></p></div>
    </section>

    <!-- FAQ -->
    <section class="sec" id="faq">
      <div class="w narrow">
        <h2>Questions</h2>
        <div class="faq">{faqs.map(([q, a], i) => <details open={i < 3}><summary>{q}</summary><p>{a}</p></details>)}</div>
      </div>
    </section>

    <!-- START: two ways -->
    <section class="sec" id="start">
      <div class="w">
        <h2>Two ways to <em>start</em></h2>
        <div class="two">
          <div class="way call">
            <p class="step">With a call</p>
            <h3>Show me your ads</h3>
            <p>A short video call. I look at your ads and your competitors with you and say what I'd test first. Most clients start here.</p>
            <a class="btn full" href={CALL} target="_blank" rel="noopener">Book a call</a>
          </div>
          <div class="way nocall">
            <p class="step">Without a call</p>
            <h3>Send me a brief</h3>
            <ol>
              <li><b>You fill in</b> the short brief below.</li>
              <li><b>Within 24 business hours</b> I reply with what I'd test first and the price.</li>
              <li><b>You pay</b> by link and I start. First ads in 5 business days.</li>
            </ol>
            <form class="brief" id="brief" action={FORM_ACTION || undefined} method="post" data-action={FORM_ACTION}>
              <input type="hidden" name="_subject" value="New brief from okad.agency" />
              <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <label>Your name<input type="text" name="name" required autocomplete="name" /></label>
              <label>Email<input type="email" name="email" required autocomplete="email" /></label>
              <label>Your website or product<input type="text" name="website" required placeholder="brand.com" inputmode="url" /></label>
              <fieldset>
                <legend>What do you need?</legend>
                <div class="pick">
                  <label><input type="radio" name="need" value="Monthly ads" required /><span>Monthly ads</span></label>
                  <label><input type="radio" name="need" value="$1,000 test" /><span>$1,000 test</span></label>
                  <label><input type="radio" name="need" value="Organic" /><span>Organic</span></label>
                  <label><input type="radio" name="need" value="Not sure" /><span>Not sure</span></label>
                </div>
              </fieldset>
              <label>Your ads or accounts <i>optional</i><input type="text" name="ads" placeholder="Meta ad library, Instagram, TikTok links" /></label>
              <label>Footage you already have <i>optional</i><input type="text" name="footage" placeholder="Drive or Dropbox link" /></label>
              <label>Anything else <i>optional</i><textarea name="notes" rows="3"></textarea></label>
              <button class="btn full" type="submit">Send the brief</button>
              <p class="err" hidden>Something went wrong. Email me at {EMAIL} instead.</p>
            </form>
            <div class="sent" id="sent" hidden>
              <p class="step">Got it</p>
              <h3>Thanks, I'll reply within 24 business hours</h3>
              <p>With what I'd test first and the price. Want to talk instead?</p>
              <a class="btn full" href={CALL} target="_blank" rel="noopener">Book a call</a>
            </div>
            <p class="copy">Rather email? <button type="button" class="cp" data-copy={EMAIL}>{EMAIL} <span>copy</span></button></p>
          </div>
        </div>
        <p class="foot">Need a website or a brand? <a href="/design">Design studio →</a><br />Agency? I make white-label UGC and AI video. <a href={AGENCY}>Email me →</a></p>
      </div>
    </section>
  </div>

  <div class="k2 mbar" id="mbar" hidden>
    <a class="btn" href={CALL} target="_blank" rel="noopener">Book a call</a>
    <a class="btn dew" href="#start">No call? Start here</a>
  </div>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mbar = document.getElementById('mbar');
    if (mbar) {
      mbar.hidden = false;
      const onScroll = () => mbar.classList.toggle('on', window.scrollY > 600);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    // hero rail starts nudged left so it reads as scrollable
    const wl = document.getElementById('wl');
    if (wl && matchMedia('(max-width:700px)').matches) requestAnimationFrame(() => { wl.scrollLeft = 44; });
    // tap for sound, one video with sound at a time
    document.querySelectorAll<HTMLElement>('.k2 .wall .ph').forEach((ph) => {
      ph.addEventListener('click', () => {
        const v = ph.querySelector('video')!;
        const turnOn = v.muted;
        document.querySelectorAll<HTMLVideoElement>('.k2 .wall video').forEach((o) => { o.muted = true; o.closest('.ph')?.classList.remove('on'); });
        if (turnOn) { v.muted = false; v.play().catch(() => {}); ph.classList.add('on'); }
      });
    });
    document.querySelectorAll<HTMLButtonElement>('.k2 [data-copy]').forEach((b) => b.addEventListener('click', () => {
      navigator.clipboard?.writeText(b.dataset.copy!).then(() => { const t = b.querySelector('span'); if (t) { t.textContent = 'copied'; setTimeout(() => (t.textContent = 'copy'), 2000); } }).catch(() => {});
    }));
    // brief form: sends to FORM_ACTION when set, otherwise opens an email with the answers
    const brief = document.getElementById('brief') as HTMLFormElement | null;
    brief?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(brief);
      if (fd.get('_gotcha')) return;
      const action = brief.dataset.action;
      const done = () => { brief.hidden = true; const s = document.getElementById('sent'); if (s) s.hidden = false; };
      if (!action) {
        const lines = [['Name', 'name'], ['Email', 'email'], ['Website', 'website'], ['Need', 'need'], ['Ads or accounts', 'ads'], ['Footage', 'footage'], ['Notes', 'notes']].map(([l, k]) => `${l}: ${fd.get(k) || ''}`).join('\n');
        location.href = 'mailto:olga@okad.agency?subject=' + encodeURIComponent('Brief from ' + (fd.get('name') || 'okad.agency')) + '&body=' + encodeURIComponent(lines);
        done(); return;
      }
      const btn = brief.querySelector('button[type=submit]') as HTMLButtonElement; btn.disabled = true; btn.textContent = 'Sending...';
      try {
        const r = await fetch(action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        if (!r.ok) throw new Error();
        done();
      } catch { btn.disabled = false; btn.textContent = 'Send the brief'; (brief.querySelector('.err') as HTMLElement).hidden = false; }
    });
    // videos load and play only in view
    const lazy = document.querySelectorAll<HTMLVideoElement>('.k2 video[data-lazy]');
    const startVid = (v: HTMLVideoElement) => {
      if (!v.dataset.loaded) {
        v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => { s.src = s.dataset.src!; });
        v.load(); v.dataset.loaded = '1';
      }
      if (!reduce) v.play().catch(() => {});
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) startVid(v); else if (v.dataset.loaded) v.pause();
      }), { rootMargin: '200px' });
      lazy.forEach((v) => io.observe(v));
    } else lazy.forEach(startVid);
    document.querySelectorAll<HTMLButtonElement>('.k2 [data-rail]').forEach((b) => {
      b.addEventListener('click', () => {
        const rail = document.getElementById(b.dataset.rail!);
        if (!rail) return;
        const card = rail.firstElementChild as HTMLElement | null;
        rail.scrollBy({ left: Number(b.dataset.dir) * (card ? card.offsetWidth + 10 : 300), behavior: 'smooth' });
      });
    });
  </script>
</Base>
