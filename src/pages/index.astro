---
import Base from '../layouts/Base.astro';
---

<Base title="OKAD Agency — Ad Creatives, UGC Video & Design" description="Ad creatives, UGC video, marketing assets design. From your first ad to 200+ creatives/month — we scale with you.">

  <!-- Hero + Cases Carousel -->
  <div class="hero">
    <h1>Quality <em>[Scroll-Stopping Content]</em> At The Volume Your Marketing Needs</h1>
    <p class="hero-sub">Ad creatives, UGC video, marketing assets design. From your first ad to 200+ creatives/month — we scale with you.</p>
    <div class="hero-buttons">
      <a href="#contact" class="btn">Start a Project</a>
    </div>
  </div>
  <h2 class="section-title carousel-title">10,000+ Ads & Posts Created</h2>
  <div class="carousel hero-carousel">
    <div class="carousel-track">
      <a href="/cases/high-roas-ugc-ads" class="carousel-card">
        <img src="https://framerusercontent.com/images/BmUk0KMAPqqpLzpARwDdXhfg.gif" alt="High ROAS UGC Ads" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>#DTC</span><span>#E-COM</span></div>
          <h3>High ROAS UGC Ads — 8+ sec watch time</h3>
        </div>
      </a>
      <a href="/cases/high-converting-video-ads-for-dtc-brands" class="carousel-card">
        <img src="https://framerusercontent.com/images/j1iBjvbPI3bC6gVlOIvjMvQ0Oos.png" alt="AI static Ads" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>#DTC</span><span>UGC</span></div>
          <h3>AI Static Ads — 3x CTR</h3>
        </div>
      </a>
      <a href="/cases" class="carousel-card">
        <img src="https://framerusercontent.com/images/FXMkq1jH116yCF0nIQPl2N2vc.png" alt="UGC Creators 45+" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>#SILVER_AGE</span><span>VIDEO</span></div>
          <h3>Creators 45+ — Trust-First Content</h3>
        </div>
      </a>
      <a href="/cases" class="carousel-card">
        <img src="https://framerusercontent.com/images/fgyKKr3g1dPjydOItu6UTCo3k8.gif" alt="1M views video content" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>#DIGITAL</span><span>#ORGANIC</span></div>
          <h3>1M+ Views — Dating & EdTech</h3>
        </div>
      </a>
      <a href="/cases" class="carousel-card">
        <img src="https://framerusercontent.com/images/WpH2ghvnLZkT7E1Ekkky6uTuFg.png" alt="High CPA Ads" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>#PAID_ADS</span><span>#DIGITAL</span></div>
          <h3>Static Ads for Meta & TikTok</h3>
        </div>
      </a>
      <a href="/cases" class="carousel-card">
        <img src="https://framerusercontent.com/images/SBAkW2rwVUXKWpG9XA9enjK968.png" alt="Alco Brands" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>#ALCO</span><span>UGC</span></div>
          <h3>Alco UGC — No Shipping, No Unboxings</h3>
        </div>
      </a>
    </div>
  </div>

  <!-- Design Cases Carousel -->
  <h2 class="section-title fade-up">200+ Websites & Brands Designed</h2>
  <div class="carousel fade-up">
    <div class="carousel-track">
      <a href="/cases/case-jumpman" class="carousel-card">
        <img src="https://framerusercontent.com/images/okMGXM3X1P3IbyA8etRfLQXsTCk.png" alt="Jumpman branding" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>BRANDING</span></div>
          <h3>Jumpman — Paris</h3>
          <p>Premium identity for a trampoline cardio studio.</p>
        </div>
      </a>
      <a href="/cases/case-jumpman-website-main" class="carousel-card">
        <img src="https://framerusercontent.com/images/Tdc8KUYgkNnSE3YxS5uEyJX4.png" alt="Intalent web design" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>WEBFLOW</span><span>FRAMER</span><span>SHOPIFY</span></div>
          <h3>Web Design — Intalent</h3>
          <p>Mobile-first, fast, converts on first visit.</p>
        </div>
      </a>
      <a href="/cases/case-trusto" class="carousel-card">
        <img src="https://framerusercontent.com/images/S1E8qDxE6cil2qXKc8AMtz6wVs.png" alt="Trusto branding" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>BRANDING</span><span>WEB</span></div>
          <h3>Trusto — Brand & Web</h3>
          <p>Full digital presence for a fintech startup.</p>
        </div>
      </a>
      <a href="/cases/case-sardana" class="carousel-card">
        <img src="https://framerusercontent.com/images/b62qjvUmjLVTCd8WJ9SfsEpF8o.png" alt="Sardana design" loading="lazy" />
        <div class="carousel-overlay">
          <div class="carousel-tags"><span>PACKAGING</span></div>
          <h3>Sardana — Packaging</h3>
          <p>From brand identity to shelf-ready packaging.</p>
        </div>
      </a>
    </div>
  </div>
  <div style="text-align:center; padding: 16px 24px 40px;">
    <a href="https://www.behance.net/okad_agency" class="btn btn-outline" target="_blank" rel="noopener">Explore More Design Cases on Behance</a>
  </div>

  <!-- Contact Section -->
  <section class="contact-section fade-up" id="contact">
    <div class="contact-inner">
      <h2>Start with a Conversation</h2>
      <p>I'm Olga, founder of OKAD. Most projects start with a quick 20-min call to understand your brand and share relevant cases.</p>
      <div class="contact-rows">
        <div class="contact-row">
          <span class="contact-label">Email: olga@okad.agency</span>
          <a href="mailto:olga@okad.agency" class="contact-btn">Email Us</a>
        </div>
        <div class="contact-row">
          <span class="contact-label">Founder: Olga Kad Miller</span>
          <a href="https://www.linkedin.com/in/o-kad/" class="contact-btn" target="_blank" rel="noopener">Add on LinkedIn</a>
        </div>
        <div class="contact-row">
          <span class="contact-label">WhatsApp: +351 939 209 099</span>
          <a href="https://wa.me/351939209099" class="contact-btn" target="_blank" rel="noopener">WA Us</a>
        </div>
      </div>
      <img src="https://framerusercontent.com/images/q6hHpGFkcDHUGgEMPAoS5KUCo.png" alt="Olga Kad Miller" class="contact-avatar" />
    </div>
  </section>

  <!-- Videos Section -->
  <section class="videos-section fade-up">
    <h2>Not ready for a call?</h2>
    <p class="section-sub">Watch me walk through real projects &mdash; results, process, and lessons.</p>
    <div class="video-grid">
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=-UTQ0HyGE80" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/-UTQ0HyGE80/hqdefault.jpg" alt="High-Converting UGC Video Ad System" loading="lazy" />
          <p>High-Converting UGC Video Ad System</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=6ww6ykmc2Pw" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/6ww6ykmc2Pw/hqdefault.jpg" alt="How to create Static Ads / 4 Elements every Ad needs" loading="lazy" />
          <p>How to create Static Ads / 4 Elements every Ad needs</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=UxOC3_DvR2o" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/UxOC3_DvR2o/hqdefault.jpg" alt="How We Build Websites That Convert" loading="lazy" />
          <p>How We Build Websites That Convert</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=njD3orMjpoM" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/njD3orMjpoM/hqdefault.jpg" alt="Full Branding vs Micro-Branding / 6 Real Projects" loading="lazy" />
          <p>Full Branding vs Micro-Branding / 6 Real Projects</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section fade-up">
    <h2>Our work paid for itself 10x over. Don't take our word for it.</h2>
    <p class="testimonials-sub">Ad creatives, websites, and brand systems for 100+ brands. From first concept to global rollout.</p>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <blockquote>Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/9yQb8hBXfQCe1f6JkqCRMnt4AKs.jpeg" alt="Maxime Lenzlinger" loading="lazy" />
          <div>
            <div class="testimonial-name">Maxime Lenzlinger</div>
            <div class="testimonial-role">Co-founder / Marketing, VUE SWISS</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>The final result exceeded my expectations. The structure was clear, the content was well-aligned with the brand tone.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/mkinoi0MbzI3iMzkSDbgPOq2GI.png" alt="Kristina Hr." loading="lazy" />
          <div>
            <div class="testimonial-name">Kristina Hr.</div>
            <div class="testimonial-role">Marketing, Mushroom genetics</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>You're the best team I've ever worked with. You are professional, organized, creative, and kind.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/LaQrt95uuBqxdIKPQ5u3sWttcvc.png" alt="Claire Ginn" loading="lazy" />
          <div>
            <div class="testimonial-name">Claire Ginn</div>
            <div class="testimonial-role">Founder, YPM Agency</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>Olga and her team are some of the best designers around. They're creative, work efficiently, and always deliver quality work.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/fyo2eKnJgN0TDx8SMjUG2NCqWk.jpeg" alt="Damon Dixon" loading="lazy" />
          <div>
            <div class="testimonial-name">Damon Dixon</div>
            <div class="testimonial-role">Founder, Douxds</div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
