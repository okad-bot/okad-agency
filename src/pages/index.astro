---
import Base from '../layouts/Base.astro';
import '../styles/okad-house.css';

const CALL = 'https://calendly.com/okad_calls/first';
const CASE1 = '/cases/creative-testing-ai-app-meta-ads';
const CASE2 = '/cases/drawing-app-faceless-ugc';
const CASE3 = '/cases/ad-re-edits-five-brands';
const CASE4 = '/cases/by-okad-camera-roll-creators';
const CASE_LK = '/cases/lookalikey-ugc-ads';
const AI_BOOK = '/cases/ai-book-trailers/';
const PROTEIN = '/cases/protein-pouch-ugc-ads/';
const AI_SHUGGLE = '/cases/shuggle-ai-video/';
const AI_JEWELRY = '/cases/ai-jewelry-content/';
// "no call needed": the test starts by email until a Stripe link exists. Swap TEST_LINK for the Stripe URL later.
const TEST_LINK = 'mailto:olga@okad.agency?subject=' + encodeURIComponent('First test') + '&body=' + encodeURIComponent('Brand and website:\nWhat to test (re-edits, UGC, AI videos, statics):\nLink to your ads (Meta ad library is fine):\nMonthly ad spend:\n');
// newsletter: paste the signup form URL (Beehiiv, Kit, Substack...) to show an email field. Empty = follow links.
const NEWSLETTER_ACTION = '';

const C = '/images/cases';
// group: niches, space-separated (apps, health, ecom, dating)
const videoWork = [
  { group: 'health ecom', href: '/cases/protein-pouch-ugc-ads/', cover: '/images/cases/covers/okad-case-22-protein-pouch.webp', tags: ['UGC ads', 'Protein'], title: 'Protein, ranked by how easy it is: 10 videos, 13 cuts' },
  { group: 'ai', href: AI_BOOK, cover: '/images/cases/covers/okad-case-23-ai-book-trailers.webp', tags: ['AI video', 'Book publisher'], title: 'AI book trailers: 12K+ likes on six posts' },
  { group: 'ai ecom', href: AI_JEWELRY, cover: '/images/cases/covers/okad-case-25-ai-jewelry.webp', tags: ['AI content', 'Fine jewelry'], title: '12 posts and 6 videos a month, no photoshoots' },
  { group: 'ai apps', href: AI_SHUGGLE, cover: '/images/cases/covers/okad-case-24-shuggle-ai-video.webp', tags: ['AI video', 'Shuggle'], title: 'Two people, one awkward dance, no actors' },
  { group: 'apps', href: CASE2, cover: '/images/cases/covers/okad-case-03-drawing-app.webp', tags: ['Faceless UGC', 'iPad app'], title: '1.5M organic views, zero faces on camera' },
  { group: 'health', href: '/cases/supplement-brand-ugc-ad-testing', cover: '/images/cases/covers/okad-case-11-supplement-brand.webp', tags: ['Paid ads', 'Supplements'], title: '16 creator videos, 48 ads to test' },
  { group: 'ecom health', href: '/cases/zentoes-walmart-launch-ads', cover: '/images/cases/covers/okad-case-09-zentoes.webp', tags: ['Re-edits', 'Retail'], title: 'ZenToes: a Walmart launch, no new shoot' },
  { group: 'ecom', href: '/cases/baby-furniture-ai-product-visuals', cover: '/images/cases/covers/okad-case-13-dadada-baby.webp', tags: ['AI statics', 'Furniture'], title: 'Nursery ads without a nursery shoot' },
  { group: 'dating', href: '/cases/your-christian-date-broll-content', cover: '/images/cases/covers/okad-case-02-your-christian-date.webp', tags: ['Organic', 'Dating app'], title: '800K views on one Reel' },
  { group: 'ecom', href: '/cases/fragstore-content-factory', cover: '/images/cases/covers/okad-case-07-fragstore.webp', tags: ['Organic', 'Toy store'], title: 'Fragstore: 48.9K views in 3 weeks' },
  { group: 'apps', href: '/cases/smalltalk2me-social-content', cover: '/images/cases/covers/okad-case-06-smalltalk2me.webp', tags: ['Organic', 'EdTech'], title: '24K views, 849 saves on one tip' },
  { group: 'dating', href: '/cases/dating-com-creator-content', cover: '/images/cases/covers/okad-case-08-dating-com.webp', tags: ['Organic', 'Dating 40+'], title: 'Dating.com: 60+ videos for 40+' },
  { group: 'health', href: '/cases/longevity-supplement-story-ads', cover: '/images/cases/covers/okad-case-14-longevity-supplement.webp', tags: ['Paid ads', 'EN + DE'], title: '68 ads. Story before product' },
  { group: 'ecom health dating', href: '/cases/ad-re-edits-five-brands', cover: '/images/cases/covers/okad-case-21-ad-re-edits.webp', tags: ['Re-edits', '5 brands'], title: '~80 ads from old folders' },
  { group: 'apps', href: '/cases/case-uprest', img: '/images/thumbs/case-uprest.webp', tags: ['Paid ads', 'B2B'], title: 'UpRest: €2.75 per lead' },
  { group: 'ecom apps', href: '/cases/high-converting-video-ads-for-dtc-brands', img: '/images/thumbs/j1iBjvbPI3bC6gVlOIvjMvQ0Oos.webp', tags: ['AI statics', 'DTC'], title: 'AI static ads: 3x CTR' },
  // Women's health / Milamend case is live in /cases but hidden from the homepage on purpose
];
const groups = [
  ['all', 'All'],
  ['ai', 'AI video'],
  ['apps', 'Apps & SaaS'],
  ['health', 'Health & supplements'],
  ['ecom', 'E-com & products'],
  ['dating', 'Dating'],
];

const services = [
  { n: '01', c: 'mint', t: 'Re-edits from your footage', p: 'New hooks, new order and new sound on clips you already have. The fastest way to fresh ads.', price: 'from $50', unit: 'per ad', cases: [['Five brands, zero new shoots', '/cases/ad-re-edits-five-brands'], ['ZenToes Walmart launch', '/cases/zentoes-walmart-launch-ads']] },
  { n: '02', c: 'lav', t: 'New UGC with creators', p: 'Scripts, casting from 3,000+ creators, filming and editing. 3 to 5 hooks per video.', price: 'from $100', unit: 'per video, creator included', cases: [['AI app: −35% per customer', '/cases/creative-testing-ai-app-meta-ads'], ['Lookalikey', '/cases/lookalikey-ugc-ads'], ['Protein pouch: 13 cuts', PROTEIN]] },
  { n: '03', c: 'peach', t: 'AI video', p: 'AI UGC, animation and product videos when there is no footage yet, or when you need volume fast.', price: 'from $200', unit: 'per video', cases: [['AI book trailers: 12K+ likes', AI_BOOK], ['Jewelry content, no shoots', AI_JEWELRY], ['Shuggle: no actors', AI_SHUGGLE]] },
  { n: '04', c: 'lilac', t: 'Static ads', p: 'Statics and carousels from your photos, reviews and AI visuals, made in sets.', price: 'from $50', unit: 'per static', cases: [['Nursery ads without a shoot', '/cases/baby-furniture-ai-product-visuals'], ['AI statics: 3x CTR', '/cases/high-converting-video-ads-for-dtc-brands']] },
];

const strategy = { price: 'from $500', unit: 'for one test, up to 30 ads · from $2,500 for a month or longer', p: 'A deep look at your ad account, your competitors and your reviews, and a plan of which ads to make and test first. The test and monthly plans already include a test plan and scripts.' };

const wall = [
  { v: '/cases/ai-book-trailers/assets/video/b_v1', poster: '/cases/ai-book-trailers/assets/img/img-01.jpg', t: 'AI video', c: 'Book publisher', h: AI_BOOK },
  { v: '/videos/rail-lookalikey', t: 'UGC', c: 'Lookalikey', h: CASE_LK, webm: true },
  { v: '/images/cases/ad-re-edits-five-brands/ad/v/cflags', t: 'Re-edit', c: 'Gut health brand', h: CASE3 },
  { v: '/videos/case2-cream', t: 'Re-edit', c: 'ZenToes', h: '/cases/zentoes-walmart-launch-ads', webm: true },
  { v: '/cases/shuggle-ai-video/assets/video/s_gala', poster: '/cases/shuggle-ai-video/assets/img/img-02.jpg', t: 'AI video', c: 'Shuggle', h: AI_SHUGGLE },
  { v: '/images/cases/longevity-supplement-story-ads/lg/v/party', t: 'Story ad', c: 'Longevity brand', h: '/cases/longevity-supplement-story-ads' },
  { v: '/videos/hero-todo', t: 'UGC', c: 'AI headshot app', h: CASE1, webm: true },
  { v: '/cases/ai-jewelry-content/assets/video/d_4', poster: '/cases/ai-jewelry-content/assets/img/img-09.jpg', t: 'AI video', c: 'Jewelry brand', h: AI_JEWELRY },
  { v: '/images/cases/ad-re-edits-five-brands/ad/v/cbrain', t: 'Re-edit', c: 'Supplement brand', h: CASE3 },
  { v: '/images/cases/longevity-supplement-story-ads/lg/v/robert', t: 'Story ad', c: 'Longevity brand', h: '/cases/longevity-supplement-story-ads' },
  { v: '/videos/hero-facetime', t: 'UGC', c: 'AI headshot app', h: CASE1, webm: true },
];

const why = [
  ['2 to 3 weeks', 'Most ads burn out this fast. After that you pay more for the same customer.'],
  ['30+ a month', 'Meta now rewards many different ads, not one perfect video. Few teams can make that many.'],
  ['Days, not weeks', 'A shoot takes weeks. Re-edits, AI and statics are ready in days.'],
];

const testSteps = [
  ['Day 1', 'Brief', 'You send your product, footage and ad results. Or I find your ads in the Meta ad library.'],
  ['Days 2 to 3', 'Plan and scripts', 'I read your reviews and competitors, write the test plan and every script. You approve.'],
  ['Day 5', 'First batch', 'Re-edits, AI videos and statics are ready. UGC with creators takes 2 to 3 weeks, because they need your product first.'],
  ['After 7 to 14 days', 'Next batch', 'You launch and share the results. I keep what works, drop what doesn\'t and plan the next batch.'],
];

const faqs = [
  ['How fast do I get the first ads?', 'Re-edits, AI videos and statics in 5 business days. UGC with creators takes 2 to 3 weeks, because we send them your product first.'],
  ['Do you have a team?', 'Yes, a small one. I do the strategy, every script and a big part of the editing myself. Two people help me: one runs UGC casting from our 3,000+ creators, the other does graphics and AI generation.'],
  ['Are creator fees included?', 'Yes, the price per video includes the creator.'],
  ['Who owns the ads?', 'You do. Run them on any paid channel. If you want Spark or partnership ads from a creator\'s account, I arrange it with the creator.'],
  ['Do you run the ads?', "No, I make the ads and the test plan. You or your media buyer launch them. If you don't have one, I'll show you how to set up the test and can recommend a media buyer."],
  ['How do I pay?', 'The test is paid upfront. Monthly plans are paid month by month, with no long contract.'],
  ['Which languages?', 'Any. I have made ads in English, German and many other languages, with native creators.'],
  ['Is it AI or real people?', 'Both. Before we start I tell you which videos are AI and which are filmed by creators.'],
  ['What if I don’t like a script?', 'You approve every script before anyone films or edits, and one round of edits is included in every batch.'],
  ['What if nothing works?', 'Then we know which angles don\'t sell. The next batch tests new ones, and I re-cut the best ads with new hooks first, because that is the cheapest next test.'],
];

const principles = [
  ['3–5', 'Variations per ad', 'We shoot one ad and cut 3–5 versions with different hooks to test.'],
  ['3,000+', 'Vetted creators', "Our own creators. You don't search. We match and brief them."],
  ['Hook → CTA', 'Script first', 'Every video has a written script before anyone hits record.'],
  ['AI + human', 'Creative direction', 'We use AI to move faster, but a person decides what to make.'],
  ['1 team', 'Zero handoffs', 'The same people write the script, pick the creator and edit the video.'],
  ['CTR · ROAS', 'Data in every brief', 'Before the next batch, we look at what actually performed.'],
  ['Scroll-stop', 'Design first', "If it doesn't catch the eye in the feed, it doesn't work."],
];

const steps = [
  ['Week 1', 'Research', 'Reviews, comments, ad history'],
  ['Week 2', 'Test plan', '50–70 ideas you approve'],
  ['Week 2', 'Scripts & casting', 'Hooks and matched creators'],
  ['Weeks 3–4', 'Production', 'Native videos, 9:16 + 4:5'],
  ['Weeks 5–6', 'Results', 'Scale, fix or stop each video'],
];

const design = [
  { href: '/cases/case-jumpman', img: '/images/thumbs/case-jumpman.webp', tags: ['Branding'], title: 'Jumpman, Paris', text: 'Brand identity for a Paris cardio studio.' },
  { href: '/cases/case-jumpman-website-main', img: '/images/thumbs/case-jumpman-website-main.webp', tags: ['Web', 'Framer'], title: 'Jumpman website', text: 'Doubled B2C bookings in the first month.' },
  { href: '/cases/case-jardins-etretat-redesign-main', img: '/images/thumbs/case-jardins-etretat-redesign-main.webp', tags: ['Web', 'Framer'], title: "Jardins d'Étretat", text: 'Website redesign for a French venue.' },
  { href: '/cases/case-lingoculture', img: '/images/thumbs/case-lingoculture.webp', tags: ['Pitch deck'], title: 'LingoCulture', text: 'Partner deck for a French learning platform.' },
  { href: '/cases/case-ckx', img: '/images/thumbs/case-ckx.webp', tags: ['UX/UI', 'Framer'], title: 'ChainKeyX', text: 'Bento-style website for a DeFi startup.' },
  { href: '/cases/case-innowomen-branding', img: '/images/thumbs/case-innowomen-branding.webp', tags: ['Branding'], title: 'In a Woman', text: 'Branding for a women-in-tech accelerator.' },
];

// Real client quotes from email. Ask each client before publishing.
const quotes = [
  ["Creator B content has performed the best, especially 'I created one card and now my whole family is obsessed'. We're currently running at a 1.96 ROAS, recently hitting more towards 2.20 ROAS.", 'Spencer Herron', 'Lookalikey · first test, 3 videos per creator', 'lookalikey'],
  ["The videos, especially the Three Split Screen concept, performed really well, and we're still leveraging them in our campaigns today.", 'Lina Lin', 'Athena Club', 'athena-club'],
  ['Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.', 'Maxime Lenzlinger', 'Co-founder, VUE SWISS', '/images/9yQb8hBXfQCe1f6JkqCRMnt4AKs.jpeg'],
  ["I really like that we've anchored every video clearly in our three pillars. From my side, this direction is solid and consistent with how we want STIGA to show up.", 'Karl Inde', 'STIGA', 'stiga'],
  ['The final result exceeded my expectations. The structure was clear, the content was well-aligned with the brand tone.', 'Kristina Hr.', 'Marketing, Mushroom genetics', '/images/mkinoi0MbzI3iMzkSDbgPOq2GI.png'],
  ['Let me re-iterate how much we enjoy and appreciate the quality of your work, but more importantly, your sense of urgency when you know things are time-sensitive. We are so lucky to have you :)', 'Varun Godha', 'Diamondere', 'diamondere'],
  ["You're the best team I've ever worked with. You are professional, organized, creative, and kind.", 'Claire Ginn', 'Founder, YPM Agency', '/images/LaQrt95uuBqxdIKPQ5u3sWttcvc.png'],
  // removed from the homepage: Paula (VUE SWISS, no surname), Michele L. (no result in the quote)
];

const videos = [
  ['-UTQ0HyGE80', 'High-converting UGC video ad system'],
  ['6ww6ykmc2Pw', 'How to create static ads: 4 elements every ad needs'],
];

import fs from 'node:fs';
// client logos: drop PNG/SVG files into public/logos/clients/ and they join the marquee automatically
const clientLogos = fs.existsSync('public/logos/clients') ? fs.readdirSync('public/logos/clients').filter((f) => /\.(png|svg|webp)$/i.test(f)).sort().map((f) => `/logos/clients/${f}`) : [];
const logos = [...clientLogos, ...Array.from({ length: 19 }, (_, i) => `/logos/logo-${i}.png`)];
const logoFor = (slug: string) => clientLogos.find((l) => l.split('/').pop()!.replace(/\.\w+$/, '') === slug) ?? '';
const hasWave = fs.existsSync('public/videos/olga-wave.mp4');
const arrowR = '<svg class="arr" width="54" height="48" viewBox="0 0 54 48" aria-hidden="true"><path d="M4 6 C 26 0, 44 14, 46 40"/><path d="M38 33 L46 42 L51 31"/></svg>';
---

<Base title="OKAD · Video and static ads for DTC brands and apps" description="Fresh ads, fast, with a strategist behind each one: re-edits, UGC, AI videos and statics. First test from $1,000. 100+ brands, 10,000+ ads.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'ProfessionalService', name: 'OKAD', url: 'https://okad.agency/', email: 'olga@okad.agency', founder: { '@type': 'Person', name: 'Olga Kad Miller', sameAs: ['https://www.linkedin.com/in/o-kad/', 'https://www.instagram.com/by.okad/'] }, areaServed: 'Worldwide', address: { '@type': 'PostalAddress', addressLocality: 'Lisbon', addressCountry: 'PT' }, priceRange: '$50 to $2,500+' })} />
  </Fragment>

  <div class="okh">

    <!-- HERO: video first -->
    <section class="khero">
      <div class="w">
        <div class="hero-grid">
          <div class="stack">
            <div class="svc-chips" aria-label="What I make"><a href="#services">UGC</a><a href="#services">AI video</a><a href="#services">Re-edits</a><a href="#services">Static ads</a></div>
            <h1>Fresh ads, fast. <span class="cap">A strategist behind every one.</span></h1>
            <p class="lead">Video and static ads for brands and apps: re-edits of your footage, UGC with 3,000+ creators, AI video and statics. Every ad is planned and scripted before anyone films.</p>
            <a class="hello" href="#contact">
              {hasWave
                ? <video class="hello-av" src="/videos/olga-wave.mp4" poster="/images/thumbs/olga.webp" autoplay muted loop playsinline aria-label="Olga waving"></video>
                : <img class="hello-av" src="/images/thumbs/olga.webp" width="56" height="56" alt="Olga Kad Miller" />}
              <span><b class="hand">Hi, I'm Olga</b><span>creative strategist · 10,000+ ads for 100+ brands</span></span>
            </a>
            <div class="row">
              <a class="btn" href="#offer">Start a test<span class="m-hide"> · from $1,000</span></a>
              <a class="btn ghost" href={CALL} target="_blank" rel="noopener">Book a call</a>
            </div>
          </div>
          <div class="collage" aria-label="Frames from our ads">
            <span class="note hand hn">real frames from our ads <Fragment set:html={arrowR} /></span>
            <figure class="ph"><video poster="/videos/hero-reedit.jpg" autoplay muted loop playsinline preload="metadata" aria-label="Re-edited ad from brand footage: POV, your husband steals your foot cream"><source src="/videos/hero-reedit.webm" type="video/webm" /><source src="/videos/hero-reedit.mp4" type="video/mp4" /></video><figcaption class="ph-tag">Re-edit</figcaption></figure>
            <figure class="ph"><video poster="/videos/hero-ugc.jpg" autoplay muted loop playsinline preload="metadata" aria-label="UGC ad with a creator: good, better, best"><source src="/videos/hero-ugc.webm" type="video/webm" /><source src="/videos/hero-ugc.mp4" type="video/mp4" /></video><figcaption class="ph-tag">UGC</figcaption></figure>
            <figure class="ph"><video poster="/videos/hero-ai.jpg" autoplay muted loop playsinline preload="metadata" aria-label="AI video ad: glowing gut inside a 3D body"><source src="/videos/hero-ai.mp4" type="video/mp4" /></video><figcaption class="ph-tag">AI video</figcaption></figure>
            <a class="sticker" href={CASE1}>
              <b>160+</b>
              <span>video ads for one AI app in four months<small>Case 01 · read →</small></span>
            </a>
          </div>
        </div>

        <p class="res-kick">Numbers I can share. Most of my clients work under NDA.</p>
        <div class="strip res-strip">
          <a href={CASE1}><b>−35%</b><span>cost per customer for an AI app</span></a>
          <a href={CASE_LK}><b>2.2</b><span>ROAS for Lookalikey on the first test</span></a>
          <a href={CASE4}><b>5,471</b><span>sign-ups from organic posts, $0 on ads</span></a>
          <a href={CASE2}><b>1.5M</b><span>organic views and 2,000 app sign-ups</span></a>
        </div>
      </div>
    </section>

    <!-- LOGOS -->
    <section aria-label="Clients">
      <div class="logos-cap"><span class="kick">Brands I have made ads for</span></div>
      <div class="logos">
        <div class="lt">
          {[...logos, ...logos].map((src, i) => <img src={src} alt="" aria-hidden={i >= logos.length ? 'true' : undefined} loading="eager" decoding="async" height="26" />)}
        </div>
      </div>
    </section>

    <!-- WHY NOW -->
    <section class="sec tight" id="why">
      <div class="w">
        <div class="why-box">
        <h2>Why you need <span class="cap y">more ads</span> than before</h2>
        <div class="why3">
          {why.map(([b, p]) => <div><b>{b}</b><p>{p}</p></div>)}
        </div>
        </div>
      </div>
    </section>

    <!-- WATCH THE ADS -->
    <section class="sec tight" id="ads">
      <div class="w">
        <div class="rail-head">
          <div class="t">
            <span class="kick">Tap a video for sound</span>
            <h2>Watch the <span class="cap y">ads</span></h2>
          </div>
          <div class="rail-nav"><button type="button" data-rail="wl" data-dir="-1" aria-label="Previous">←</button><button type="button" data-rail="wl" data-dir="1" aria-label="Next">→</button></div>
        </div>
      </div>
      <div class="rail wall" id="wl">
        {wall.map((x) => (
          <figure class="wv">
            <div class="ph">
              <video data-lazy poster={x.poster ?? `${x.v}.jpg`} muted loop playsinline preload="none" aria-label={`${x.t} ad for ${x.c}`}>
                {x.webm && <source data-src={`${x.v}.webm`} type="video/webm" />}
                <source data-src={`${x.v}.mp4`} type="video/mp4" />
              </video>
              <span class="ph-tag">{x.t}</span>
              <span class="snd" aria-hidden="true">sound off</span>
            </div>
            <figcaption><a href={x.h}>{x.c} →</a></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <!-- SERVICES: what I make -->
    <section class="sec tight" id="services">
      <div class="w">
        <div class="head">
          <div class="t">
            <span class="kick">Prices per piece, so you can plan your budget</span>
            <h2>What I <span class="cap g">make</span></h2>
          </div>
        </div>
        <div class="svc4">
          {services.map((x) => (
            <div class={`sv ${x.c}`}>
              <span class="sv-n">{x.n}</span>
              <h3>{x.t}</h3>
              <p>{x.p}</p>
              <div class="sv-price"><b>{x.price}</b><span>{x.unit}</span></div>
              <div class="sv-cases">{x.cases.map(([l, h]) => <a href={h}>{l} →</a>)}</div>
            </div>
          ))}
        </div>
        <div class="strat">
          <div><span class="sv-n">05</span><h3>Strategy</h3><p>{strategy.p}</p></div>
          <div class="sv-price"><b>{strategy.price}</b><span>{strategy.unit}</span></div>
        </div>
      </div>
    </section>

    <!-- CASES -->
    <section class="sec" id="cases">
      <div class="w">
        <div class="head">
          <div class="t">
            <span class="kick">Real ad accounts, real numbers</span>
            <h2>Selected <span class="cap g">cases</span></h2>
          </div>
          <a class="btn ghost" href="/cases">All cases →</a>
        </div>

        <div class="fcases">
          <!-- CASE 01 -->
          <article class="fcase">
            <a class="fcase-link" href={CASE1} aria-label="Read the case: 160+ ads for a consumer AI app"></a>
            <div class="info">
              <div class="meta">
                <span class="num">case 01</span>
                <div class="tags"><span>Creative testing</span><span>Consumer AI app</span><span>Meta ads · US</span></div>
              </div>
              <h3>From 2 videos that ever worked <span class="cap w">to 160+ ads</span> in four months</h3>
              <p>Scripts from research, matched creators, native formats. Sales picked the winners.</p>
              <div class="fk">
                <div><b>160<em>+</em></b><span>video ads delivered</span></div>
                <div><b>−35<em>%</em></b><span>cost per customer vs account average</span></div>
                <div><b><em>#</em>1</b><span>biggest budget of ~770 ads went to our video</span></div>
              </div>
              <div class="go">
                <a class="btn" href={CASE1}>Read the case →</a>
                <span class="kick">11 chapters · client anonymised</span>
              </div>
            </div>
