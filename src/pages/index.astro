  </div>

  <script>
    // respect reduced motion: stop the looping clips, the poster frame stays
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll<HTMLVideoElement>('.okh video[autoplay]').forEach((v) => { v.removeAttribute('autoplay'); v.pause(); });
    }
    const mbar = document.getElementById('mbar');
    if (mbar) {
      mbar.hidden = false;
      const onScroll = () => mbar.classList.toggle('on', window.scrollY > 500);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    // case filter chips
    const chips = document.querySelectorAll<HTMLButtonElement>('.okh .cfilt .chip');
    const vcards = document.querySelectorAll<HTMLElement>('.okh #vw .vcard');
    chips.forEach((c) => c.addEventListener('click', () => {
      const g = c.dataset.g;
      chips.forEach((x) => { const on = x === c; x.classList.toggle('on', on); x.setAttribute('aria-pressed', String(on)); });
      vcards.forEach((v) => { v.hidden = g !== 'all' && v.dataset.group !== g; });
      document.getElementById('vw')?.scrollTo({ left: 0 });
    }));
    // below-the-fold clips load and play only when they scroll into view
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lazy = document.querySelectorAll<HTMLVideoElement>('.okh video[data-lazy]');
    const startVid = (v: HTMLVideoElement) => {
      if (!v.dataset.loaded) {
        v.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((s) => { s.src = s.dataset.src!; });
        v.load(); v.dataset.loaded = '1';
      }
      if (!reduce) v.play().catch(() => {});
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) startVid(v); else if (v.dataset.loaded) v.pause();
      }), { rootMargin: '200px' });
      lazy.forEach((v) => io.observe(v));
    } else lazy.forEach(startVid);
    document.querySelectorAll<HTMLButtonElement>('.okh [data-rail]').forEach((b) => {
      b.addEventListener('click', () => {
        const rail = document.getElementById(b.dataset.rail!);
        if (!rail) return;
        const card = rail.firstElementChild as HTMLElement | null;
        const step = card ? card.offsetWidth + 14 : 320;
        rail.scrollBy({ left: Number(b.dataset.dir) * step, behavior: 'smooth' });
      });
    });
  </script>
