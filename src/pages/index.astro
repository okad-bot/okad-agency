---
import Base from '../layouts/Base.astro';
---

<Base title="OKAD Agency — Ad Creatives, UGC Video & Design" description="Ad creatives, UGC video, marketing assets design. From your first ad to 200+ creatives/month — we scale with you.">

  <!-- Hero -->
  <div class="hero">
    <h1>Quality <em>Scroll-Stopping Content</em> At The Volume Your Marketing Needs</h1>
    <p class="hero-sub">Ad creatives, UGC video, marketing assets design. From your first ad to 200+ creatives/month — we scale with you.</p>
  </div>

  <!-- Stats Row -->
  <section class="stats-section">
    <div class="stats-grid">
      <div class="stat-card">
        <h2>10,000+ Ads & Posts Created</h2>
        <div class="stat-tags">
          <span class="stat-tag">#PAID_ADS</span>
          <span class="stat-tag pink">#ORGANIC</span>
          <span class="stat-tag green">#STATIC & VIDEO</span>
        </div>
        <div class="stat-images">
          <img src="https://framerusercontent.com/images/BmUk0KMAPqqpLzpARwDdXhfg.gif" alt="UGC ads example" loading="lazy" />
          <img src="https://framerusercontent.com/images/j1iBjvbPI3bC6gVlOIvjMvQ0Oos.png" alt="Ad creatives" loading="lazy" />
          <img src="https://framerusercontent.com/images/FXMkq1jH116yCF0nIQPl2N2vc.png" alt="Carousel content" loading="lazy" />
        </div>
        <div class="stat-tags" style="margin-top:12px;">
          <span class="stat-tag">UGC</span>
          <span class="stat-tag pink">AD Creatives</span>
          <span class="stat-tag green">Carousels</span>
          <span class="stat-tag blue">AI</span>
          <span class="stat-tag orange">Creator Sourcing</span>
        </div>
      </div>
      <div class="stat-card">
        <h2>200+ Websites & Brands Designed</h2>
        <div class="stat-tags">
          <span class="stat-tag blue">#BRANDING</span>
          <span class="stat-tag">#WEB_DESIGN</span>
          <span class="stat-tag orange">#MARKETING_MATERIALS</span>
        </div>
        <div class="stat-images">
          <img src="https://framerusercontent.com/images/okMGXM3X1P3IbyA8etRfLQXsTCk.png" alt="Shopify design" loading="lazy" />
          <img src="https://framerusercontent.com/images/Tdc8KUYgkNnSE3YxS5uEyJX4.png" alt="Framer design" loading="lazy" />
          <img src="https://framerusercontent.com/images/S1E8qDxE6cil2qXKc8AMtz6wVs.png" alt="Digital branding" loading="lazy" />
        </div>
        <div class="stat-tags" style="margin-top:12px;">
          <span class="stat-tag blue">Shopify</span>
          <span class="stat-tag">Framer</span>
          <span class="stat-tag orange">Digital branding</span>
          <span class="stat-tag green">Packaging branding</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Cases -->
  <h2 class="section-title">Explore Our Content Cases</h2>
  <section class="cases-section">

    <!-- Case 1 -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/BmUk0KMAPqqpLzpARwDdXhfg.gif" alt="High ROAS UGC Ads" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#dtc</span>
          <span class="case-tag">#e-com</span>
        </div>
        <h3>High ROAS UGC Ads</h3>
        <p>UGC-driven ad creatives designed to maximize return on ad spend for DTC and e-commerce brands. Real creators, real results.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Case 2 -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/j1iBjvbPI3bC6gVlOIvjMvQ0Oos.png" alt="AI static Ads" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#dtc</span>
          <span class="case-tag">UGC content</span>
        </div>
        <h3>AI static Ads &mdash; 3x CTR vs original creo</h3>
        <p>AI-generated static ads that tripled click-through rates compared to original creatives. Smart automation meets creative excellence.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Case 3 -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/FXMkq1jH116yCF0nIQPl2N2vc.png" alt="UGC Ads by Creators 45+" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#silver_age</span>
          <span class="case-tag">Video</span>
        </div>
        <h3>UGC Ads & Content by Creators 45+</h3>
        <p>Authentic UGC content created by silver-age creators, connecting with mature audiences through relatable, genuine storytelling.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Case 4 -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/fgyKKr3g1dPjydOItu6UTCo3k8.gif" alt="1M views video content" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#digital</span>
        </div>
        <h3>1M views Video-content for Digital</h3>
        <p>Video content strategy and production that achieved over 1 million views for a digital brand. Engaging, shareable, and on-trend.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Case 5 -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/WpH2ghvnLZkT7E1Ekkky6uTuFg.png" alt="High CPA Ads for Digital" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#Digital</span>
        </div>
        <h3>High CPA Ads creatives for Digital</h3>
        <p>Performance-focused ad creatives designed to hit aggressive CPA targets. Data-driven design with high-converting visual hooks.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Case 6 -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/SBAkW2rwVUXKWpG9XA9enjK968.png" alt="UGC & AI content for Alco Brands" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#Alco</span>
        </div>
        <h3>UGC & AI-content for Alco Brands</h3>
        <p>Creative content combining UGC authenticity with AI-powered production for alcohol brands. Compliant, creative, and conversion-ready.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

  </section>

  <!-- Design Cases -->
  <h2 class="section-title">Explore Design Cases</h2>
  <section class="cases-section">

    <!-- Jumpman -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/okMGXM3X1P3IbyA8etRfLQXsTCk.png" alt="Jumpman branding case" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">Branding</span>
        </div>
        <h3>Branding &mdash; Jumpman</h3>
        <p>Complete brand identity for Jumpman: logo system, color palette, typography, and brand guidelines that capture energy and ambition.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

    <!-- Intalent -->
    <div class="case-card">
      <div class="case-img">
        <img src="https://framerusercontent.com/images/Tdc8KUYgkNnSE3YxS5uEyJX4.png" alt="Intalent web design case" loading="lazy" />
      </div>
      <div class="case-body">
        <div class="case-tags">
          <span class="case-tag">#Webflow</span>
          <span class="case-tag">#Framer</span>
          <span class="case-tag">#Shopify</span>
        </div>
        <h3>Web Design &mdash; Intalent</h3>
        <p>Modern, conversion-focused web design for Intalent. Clean layouts, intuitive navigation, and responsive design across all devices.</p>
        <div class="case-links">
          <a href="/cases" class="case-link">Explore case</a>
          <a href="#contact" class="btn">Get a quote</a>
        </div>
      </div>
    </div>

  </section>

  <!-- Portfolio Grid -->
  <section class="portfolio-section">
    <div class="portfolio-grid">
      <img src="https://framerusercontent.com/images/S1E8qDxE6cil2qXKc8AMtz6wVs.png" alt="Portfolio work 1" loading="lazy" />
      <img src="https://framerusercontent.com/images/b62qjvUmjLVTCd8WJ9SfsEpF8o.png" alt="Portfolio work 2" loading="lazy" />
      <img src="https://framerusercontent.com/images/kAkM8v5CwAIerVmAdmMIBTqM30.png" alt="Portfolio work 3" loading="lazy" />
      <img src="https://framerusercontent.com/images/yRU505Z52FJaY1wv77laoTUjxM.png" alt="Portfolio work 4" loading="lazy" />
      <img src="https://framerusercontent.com/images/w6fb6Lk9NVFWGcErwOjxMxsCrAs.png" alt="Portfolio work 5" loading="lazy" />
      <img src="https://framerusercontent.com/images/Hj87aXoVNswA39nVTP8YSDd3G00.png" alt="Portfolio work 6" loading="lazy" />
      <img src="https://framerusercontent.com/images/BNfMlg3TE8O0W6ihW5ISITW9eDQ.jpg" alt="Portfolio work 7" loading="lazy" />
      <img src="https://framerusercontent.com/images/wn57Y0QCiso41hmr5dSwHLFY.jpg" alt="Portfolio work 8" loading="lazy" />
    </div>
    <div class="portfolio-cta">
      <a href="https://www.behance.net/okad_agency" class="btn btn-outline" target="_blank" rel="noopener">Explore More Design Cases on Behance</a>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="contact-section" id="contact">
    <div class="contact-inner">
      <h2>Start with a Conversation</h2>
      <p>I'm Olga, founder of OKAD. Most projects start with a quick 20-min call to understand your brand and share relevant cases.</p>
      <p>Email: <a href="mailto:olga@okad.agency">olga@okad.agency</a></p>
      <p>Founder: Olga Kad Miller</p>
      <p>WhatsApp: <a href="https://wa.me/351939209099">+351 939 209 099</a></p>
      <div class="contact-buttons">
        <a href="mailto:olga@okad.agency" class="contact-btn">Email Us</a>
        <a href="https://www.linkedin.com/in/o-kad/" class="contact-btn" target="_blank" rel="noopener">Add on LinkedIn</a>
        <a href="https://wa.me/351939209099" class="contact-btn" target="_blank" rel="noopener">WA Us</a>
      </div>
      <img src="https://framerusercontent.com/images/q6hHpGFkcDHUGgEMPAoS5KUCo.png" alt="Olga Kad Miller" class="contact-avatar" />
    </div>
  </section>

  <!-- Videos Section -->
  <section class="videos-section">
    <h2>Not ready for a call?</h2>
    <p class="section-sub">Watch me walk through real projects &mdash; results, process, and lessons.</p>
    <div class="video-grid">
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=-UTQ0HyGE80" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/-UTQ0HyGE80/hqdefault.jpg" alt="High-Converting UGC Video Ad System" loading="lazy" />
          <p>High-Converting UGC Video Ad System</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=6ww6ykmc2Pw" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/6ww6ykmc2Pw/hqdefault.jpg" alt="How to create Static Ads / 4 Elements every Ad needs" loading="lazy" />
          <p>How to create Static Ads / 4 Elements every Ad needs</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=UxOC3_DvR2o" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/UxOC3_DvR2o/hqdefault.jpg" alt="How We Build Websites That Convert" loading="lazy" />
          <p>How We Build Websites That Convert</p>
        </a>
      </div>
      <div class="video-card">
        <a href="https://www.youtube.com/watch?v=njD3orMjpoM" target="_blank" rel="noopener">
          <img src="https://img.youtube.com/vi/njD3orMjpoM/hqdefault.jpg" alt="Full Branding vs Micro-Branding / 6 Real Projects" loading="lazy" />
          <p>Full Branding vs Micro-Branding / 6 Real Projects</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-section">
    <h2>Our work paid for itself 10x over. Don't take our word for it.</h2>
    <p class="testimonials-sub">Ad creatives, websites, and brand systems for 100+ brands. From first concept to global rollout.</p>
    <div class="testimonial-grid">
      <div class="testimonial-card">
        <blockquote>Very happy with the video produced by OKAD. It helped us increase our creative output, and communication was smooth throughout.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/9yQb8hBXfQCe1f6JkqCRMnt4AKs.jpeg" alt="Maxime Lenzlinger" loading="lazy" />
          <div>
            <div class="testimonial-name">Maxime Lenzlinger</div>
            <div class="testimonial-role">Co-founder / Marketing, VUE SWISS</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>The final result exceeded my expectations. The structure was clear, the content was well-aligned with the brand tone.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/mkinoi0MbzI3iMzkSDbgPOq2GI.png" alt="Kristina Hr." loading="lazy" />
          <div>
            <div class="testimonial-name">Kristina Hr.</div>
            <div class="testimonial-role">Marketing, Mushroom genetics</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>You're the best team I've ever worked with. You are professional, organized, creative, and kind.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/LaQrt95uuBqxdIKPQ5u3sWttcvc.png" alt="Claire Ginn" loading="lazy" />
          <div>
            <div class="testimonial-name">Claire Ginn</div>
            <div class="testimonial-role">Founder, YPM Agency</div>
          </div>
        </div>
      </div>
      <div class="testimonial-card">
        <blockquote>Olga and her team are some of the best designers around. They're creative, work efficiently, and always deliver quality work.</blockquote>
        <div class="testimonial-author">
          <img src="https://framerusercontent.com/images/fyo2eKnJgN0TDx8SMjUG2NCqWk.jpeg" alt="Damon Dixon" loading="lazy" />
          <div>
            <div class="testimonial-name">Damon Dixon</div>
            <div class="testimonial-role">Founder, Douxds</div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Base>
