---
import Base from '../layouts/Base.astro';
---

<Base title="Merch Design & Production — OKAD Agency" description="Merch that doesn't get thrown away. Concept-first approach with fashion-level creativity and European production.">
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href="https://okad.agency/merch/" />
    <link rel="alternate" hreflang="ru" href="https://okad.agency/merch-ru/" />
  </Fragment>

  <!-- Hero -->
  <div class="hero">
    <h1>Merch that doesn't <em>get thrown away</em></h1>
    <p class="hero-sub">Because 90% of branded merch ends up in the trash. We make the kind people actually wear, use, and post about.</p>
  </div>

  <!-- Stat -->
  <div style="text-align:center;padding:0 24px 60px;">
    <div class="stat-card" style="max-width:500px;margin:0 auto;text-align:center;">
      <h2 style="font-size:64px;line-height:1;">90%</h2>
      <p style="color:var(--color-muted);font-size:16px;margin-top:8px;">of branded merch ends up in the trash within a year. We exist to fix that.</p>
    </div>
  </div>

  <!-- Approach Pillars -->
  <h2 class="section-title">Our Approach</h2>
  <div class="features-grid">
    <div class="feature-card">
      <h3>Concept-First</h3>
      <p>Every item starts with a strategic concept tied to your brand story, audience, and occasion. No generic logo slapping.</p>
    </div>
    <div class="feature-card">
      <h3>Fashion-Level Creativity</h3>
      <p>We design merch people actually want to wear. Streetwear aesthetics, limited-edition drops, and trend-aware design.</p>
    </div>
    <div class="feature-card">
      <h3>Content Integration</h3>
      <p>Every merch project comes with content-ready assets: product photos, unboxing videos, and social media templates.</p>
    </div>
    <div class="feature-card">
      <h3>European Production</h3>
      <p>Sourced and manufactured in Europe for quality control, faster shipping, and sustainable materials.</p>
    </div>
    <div class="feature-card">
      <h3>Format Flexibility</h3>
      <p>From 50-piece limited runs to 5,000+ conference kits. Apparel, accessories, tech gear, packaging, and custom formats.</p>
    </div>
  </div>

  <!-- Target Audiences -->
  <h2 class="section-title">Who It's For</h2>
  <div class="features-grid">
    <div class="feature-card">
      <h3>Conference Organizers</h3>
      <p>Speaker kits, attendee swag, and sponsor packages that feel premium and represent your event's identity.</p>
    </div>
    <div class="feature-card">
      <h3>HR Teams</h3>
      <p>Onboarding kits, team gifts, and employer brand merchandise that builds culture and pride from day one.</p>
    </div>
    <div class="feature-card">
      <h3>Community Partners</h3>
      <p>Limited-edition drops, creator collabs, and community rewards that strengthen brand loyalty and drive organic reach.</p>
    </div>
  </div>

  <!-- Services -->
  <section class="process-section">
    <h2 class="section-title">What We Do</h2>
    <div class="process-grid">
      <div class="process-step">
        <div class="step-num">1</div>
        <h3>Strategy</h3>
        <p>Brand audit, audience analysis, concept development, and item selection.</p>
      </div>
      <div class="process-step">
        <div class="step-num">2</div>
        <h3>Design</h3>
        <p>Custom artwork, mockups, material selection, and production-ready files.</p>
      </div>
      <div class="process-step">
        <div class="step-num">3</div>
        <h3>Sourcing</h3>
        <p>Vetted European suppliers, sample production, quality checks.</p>
      </div>
      <div class="process-step">
        <div class="step-num">4</div>
        <h3>Production</h3>
        <p>Manufacturing, quality control, packaging, and logistics coordination.</p>
      </div>
      <div class="process-step">
        <div class="step-num">5</div>
        <h3>Content</h3>
        <p>Product photography, unboxing videos, and social media assets.</p>
      </div>
      <div class="process-step">
        <div class="step-num">6</div>
        <h3>Activations</h3>
        <p>Event setups, distribution strategy, and on-site brand experiences.</p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="contact-section">
    <div class="contact-inner">
      <h2>Let's make merch worth keeping</h2>
      <p>Tell us about your event, team, or campaign and we'll come back with a concept, timeline, and quote.</p>
      <div class="contact-buttons">
        <a href="https://calendly.com/okad-agency/30min" class="btn" target="_blank" rel="noopener">Book a call</a>
        <a href="mailto:olga@okad.agency" class="contact-btn">Email us</a>
      </div>
    </div>
  </section>

</Base>
