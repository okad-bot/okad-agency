---
import Base from '../layouts/Base.astro';
import '../styles/okad-house.css';

const CALL = 'https://calendly.com/okad_calls/first';
const ORDER = '/#offer';

const painPoints = [
  { title: 'Claims get ads rejected', desc: 'Health claims trigger Meta and TikTok review. Scripts need real language from real users, not marketing copy that sounds like a label.' },
  { title: 'Creators must look credible', desc: 'A 19-year-old reading a script about joint pain doesn\'t convert. Casting matters more in supplements than in any other niche.' },
  { title: 'One winning ad dies in two weeks', desc: 'Supplement audiences on Meta are narrow. Frequency climbs fast, and the only fix is a steady flow of new creative.' },
  { title: 'Competitors all look the same', desc: 'Same bottle, same "I tried this for 30 days" format, same green-screen. Differentiation comes from the angle, not the production.' },
];

const whatWorks = [
  { title: 'Before and after routines', desc: 'Not prohibited transformation claims — a real person showing what their morning looks like with the product. Relatable > dramatic.' },
  { title: 'Ingredient education', desc: 'Short explainers on one ingredient: what it does, why it matters, what the research says. Positions the brand as informed, not salesy.' },
  { title: 'Unboxing and first impression', desc: 'The moment someone opens the package, reads the label, smells or tastes the product. Genuine reactions stop the scroll.' },
  { title: 'Problem-solution with real language', desc: 'Scripts pulled from customer reviews and Reddit threads, not from the brand brief. "I was tired of feeling bloated every afternoon" beats "supports digestive health".' },
  { title: 'Stacking and routine integration', desc: 'How the product fits into a routine the buyer already has: morning coffee, gym bag, nightstand. Context sells supplements.' },
  { title: 'Hook variations at scale', desc: '3 to 5 openings per video body. One hook for the pain, one for curiosity, one for social proof. Same footage, different first two seconds, completely different results.' },
];

const proofs = [
  { title: 'Supplement brand, 48 hook versions', desc: '16 creator videos turned into 48 hook versions to test which opening actually sells. Data showed that problem-callout hooks outperformed benefit hooks by 40%.', link: '/cases/supplement-ugc-ad-testing', cta: 'Read the case' },
  { title: 'ZenToes, Walmart launch', desc: '11 launch videos and 14 static ads built from footage the brand already had. Zero new shoots, retail-ready creative in under two weeks.', link: '/cases/zentoes-walmart-launch-ads', cta: 'Read the case' },
];

const faqs = [
  { q: 'Can UGC ads make health claims?', a: 'Not directly. I script around real user experiences and avoid claims that trigger ad review. "I feel less bloated" from a real customer is fine; "clinically proven to reduce bloating" in an ad is not, unless you have the documentation and disclosures.' },
  { q: 'What kind of creators work for supplements?', a: 'People who look like the buyer: gym regulars for sports nutrition, women 35+ for wellness, parents for kids\' vitamins. I cast from 600+ vetted creators matched to your audience.' },
  { q: 'How many videos do I need to test?', a: 'Start with 10 to 16 videos across 3 to 4 angles, each with 3 to 5 hook variations. That gives you 30 to 80 testable ads in the first batch. My testing framework explains the math.' },
  { q: 'Do you handle compliance review?', a: 'I write scripts that avoid common rejection triggers, but final compliance review is your responsibility, especially for FDA-regulated claims. I flag anything that looks risky before production.' },
  { q: 'How fast do supplement ads fatigue?', a: 'Faster than most niches. A winner usually lasts 10 to 14 days before frequency kills it. That is why I build in batches, not one-offs, and plan the next round while the current one is still running.' },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "UGC Ads for Supplement Brands",
  "provider": { "@type": "Organization", "name": "OKAD Agency", "url": "https://okad.agency" },
  "description": "UGC video ads for supplement and wellness brands. Compliant scripts, credible creators, hook testing. Start with 10 videos for $500.",
  "url": "https://okad.agency/ugc-for-supplements/",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://okad.agency/" },
    { "@type": "ListItem", "position": 2, "name": "UGC for Supplements" },
  ],
};
---

<Base title="UGC Ads for Supplement Brands: Compliant, Tested, Scalable | OKAD" description="UGC video ads for supplement and wellness brands. Compliant scripts, credible creators, hook testing at scale. Start with 10 videos for $500.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="okh">

    <!-- HERO -->
    <section class="khero" style="padding:80px 0 48px">
      <div class="w" style="max-width:900px">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>UGC for Supplements</span></nav>
        <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);margin-bottom:16px">UGC ads for supplement brands that don't get <span class="cap">rejected</span></h1>
        <p class="lead">Supplement ads live on a knife edge: the script that converts best is often one word away from getting flagged. I write scripts from real customer language, cast creators who look like your buyer, and test 3 to 5 hooks per video so you find winners before the current batch fatigues.</p>
        <p style="margin-top:16px;color:var(--soft,#4d4d49)">From a recent project: 16 creator videos became 48 testable ads. Problem-callout hooks beat benefit hooks by 40%.</p>
        <div class="row" style="margin-top:32px">
          <a class="btn" href={ORDER}>Order 10 videos &middot; $500</a>
          <a class="btn ghost" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

    <!-- WHY SUPPLEMENTS ARE HARD -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">Why supplement ads are <span class="cap y">harder</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
        {painPoints.map(p => (
          <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <strong style="display:block;margin-bottom:4px">{p.title}</strong>
            <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">{p.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- WHAT WORKS -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">What works in supplement <span class="cap g">UGC</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
        {whatWorks.map(w => (
          <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <strong style="display:block;margin-bottom:4px">{w.title}</strong>
            <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">{w.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PROOF -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px"><span class="cap p">Proof</span></h2>
      <div style="display:grid;gap:16px">
        {proofs.map(c => (
          <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <strong style="display:block;margin-bottom:6px">{c.title}</strong>
            <p style="color:var(--soft,#4d4d49);margin:0 0 12px;font-size:15px">{c.desc}</p>
            <a href={c.link} style="font-size:14px;font-weight:600">{c.cta} →</a>
          </div>
        ))}
      </div>
    </section>

    <!-- HOW I WORK -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">How I work with supplement <span class="cap v">brands</span></h2>
      <div style="display:grid;gap:12px">
        <div style="display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <span style="width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew,#eefb6e);font-size:14px;font-weight:600;display:grid;place-items:center">1</span>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px"><strong>Research.</strong> I read your reviews, competitor ads in Meta Ad Library, Reddit threads about your category. The angles come from what real buyers say, not from the brand brief.</p>
        </div>
        <div style="display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <span style="width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew,#eefb6e);font-size:14px;font-weight:600;display:grid;place-items:center">2</span>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px"><strong>Scripts with compliance in mind.</strong> I write hooks and bodies that sell without triggering ad review. Real experiences, not medical claims.</p>
        </div>
        <div style="display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <span style="width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew,#eefb6e);font-size:14px;font-weight:600;display:grid;place-items:center">3</span>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px"><strong>Casting.</strong> Creators who match your buyer: age, lifestyle, credibility. From my network of 600+ vetted creators.</p>
        </div>
        <div style="display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <span style="width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew,#eefb6e);font-size:14px;font-weight:600;display:grid;place-items:center">4</span>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px"><strong>Edit and deliver.</strong> 9:16 and 4:5, captions, native look. Each video gets 3 to 5 hook variations.</p>
        </div>
        <div style="display:grid;grid-template-columns:32px 1fr;gap:12px;align-items:start;padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <span style="width:28px;height:28px;border-radius:50%;background:#111;color:var(--dew,#eefb6e);font-size:14px;font-weight:600;display:grid;place-items:center">5</span>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px"><strong>Test and iterate.</strong> After launch I look at hook rate, CTR and CPA. The next batch builds on what won. <a href="/blog/meta-creative-testing-framework/">My testing framework</a>.</p>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:16px">Pricing</h2>
      <ul style="list-style:none;padding:0;display:grid;gap:10px;color:var(--soft,#4d4d49);font-size:15px">
        <li><strong>Starter, no call:</strong> 10 ready-to-run videos, a testing plan, 5 business days, <strong>$500</strong>.</li>
        <li><strong>Monthly testing:</strong> from <strong>$2,500/month</strong>, about <strong>$100 per custom video</strong> with strategy, scripts, casting, filming and editing.</li>
      </ul>
      <p style="margin-top:16px"><a href="/ugc-pricing/">Full breakdown on UGC pricing</a> · <a href="/blog/best-ugc-agencies/">Compare agencies</a></p>
    </section>

    <!-- FAQ -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">FAQ</h2>
      <div style="display:grid;gap:12px">
        {faqs.map(f => (
          <details style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <summary style="font-weight:600;cursor:pointer">{f.q}</summary>
            <p style="margin:12px 0 0;color:var(--soft,#4d4d49);font-size:15px">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--stage,#111);padding:80px 24px;text-align:center">
      <div style="max-width:700px;margin:0 auto">
        <h2 style="color:#fff;font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:16px">Ready to test supplement ads that don't get flagged?</h2>
        <p style="color:var(--stage-soft,#8e8e8e);margin-bottom:32px">10 compliant, tested videos in 5 business days. No call needed.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a class="btn" href={ORDER}>Order 10 videos &middot; $500</a>
          <a class="btn dew" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

  </div>
</Base>
