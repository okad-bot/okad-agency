---
import Base from '../layouts/Base.astro';
import '../styles/okad-house.css';

const CALL = 'https://calendly.com/okad_calls/first';
const ORDER = '/#offer';

const cases = [
  { title: 'Consumer AI app, Meta ads, US', desc: 'The account had 2 videos that had ever worked. In four months I delivered 160+ video ads. Cost per customer came in 35% below the account average, and one of my videos got the biggest budget out of ~770 ads in the account.', link: '/cases/creative-testing-ai-app-meta-ads', cta: 'Read the case' },
  { title: 'Supplement brand', desc: '16 creator videos turned into 48 hook versions to test, so the brand could learn which opening sells instead of guessing.', link: '/cases/supplement-ugc-ad-testing', cta: 'Read the case' },
  { title: 'Your Christian Date', desc: 'A B-roll library, 60 videos a month and an organic Reel with 800K views.', link: '/cases/christian-dating-app-ugc-broll', cta: 'Read the case' },
  { title: 'ZenToes, Walmart launch', desc: '11 launch videos and 14 static ads built from footage the brand already had. Zero new shoots.', link: '/cases/zentoes-walmart-launch-ads', cta: 'Read the case' },
];

const comparison = [
  { col: '', marketplace: 'Marketplace (Billo, Insense)', freelance: 'Freelance creators', okad: 'OKAD' },
  { col: 'Who writes the script', marketplace: 'You', freelance: 'You or the creator', okad: 'I do, from research' },
  { col: 'Hook variations', marketplace: 'Extra or none', freelance: 'Rarely', okad: '3 to 5 per video' },
  { col: 'Quality control', marketplace: 'Varies', freelance: 'Varies', okad: 'Every video before you see it' },
  { col: 'What happens after launch', marketplace: 'Nothing', freelance: 'Nothing', okad: 'I read the numbers and plan the next batch' },
  { col: 'Start', marketplace: 'Per video', freelance: 'Per video', okad: '10 videos for $500, no call' },
];

const steps = [
  { wk: 'Weeks 1 to 2', title: 'Research and plan', desc: 'Angles, hooks, creator brief. If you want to see how I write briefs, here is my template.' },
  { wk: 'Weeks 3 to 4', title: 'Production', desc: 'Creators film, I edit native videos in 9:16 and 4:5.' },
  { wk: 'Weeks 5 to 6', title: 'Results', desc: 'We look at the numbers together and decide: scale, fix or stop each video.' },
];

const faqs = [
  { q: 'What is a UGC ad agency?', a: 'An agency that makes creator-style video ads for paid social: it finds creators, writes scripts, edits and delivers ads ready to run on Meta and TikTok. A good one also tests them and tells you which ones to scale.' },
  { q: 'Do I need a call to start?', a: 'No. The $500 starter is ordered online. Calls are for monthly plans.' },
  { q: 'Can the ads run from the creator\'s account?', a: 'Yes, through Meta Partnership Ads or TikTok Spark Ads. See whitelisting and partnership ads.' },
  { q: 'Do you work with apps and software?', a: 'Yes. Four of my case studies are apps: an AI app, a dating app, a drawing app and an edtech app. See Tech UGC.' },
  { q: 'How fast?', a: 'The starter batch in 5 business days. Monthly plans run in batches every 1 to 2 weeks.' },
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "UGC Ad Agency",
  "provider": { "@type": "Organization", "name": "OKAD Agency", "url": "https://okad.agency" },
  "description": "UGC ads made to be tested, not just posted. Scripts, 600+ vetted creators, native editing and a data loop. Start with 10 ready-to-run videos for $500.",
  "url": "https://okad.agency/ugc-ad-agency/",
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://okad.agency/" },
    { "@type": "ListItem", "position": 2, "name": "UGC Ad Agency" },
  ],
};
---

<Base title="UGC Ad Agency for Meta & TikTok | 10 Videos for $500 | OKAD" description="UGC ads made to be tested, not just posted. Scripts, 600+ vetted creators, native editing and a data loop. Start with 10 ready-to-run videos for $500.">
  <Fragment slot="head">
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Reenie+Beanie&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <div class="okh">

    <!-- HERO -->
    <section class="khero" style="padding:80px 0 48px">
      <div class="w" style="max-width:900px">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>UGC Ad Agency</span></nav>
        <h1 style="font-size:clamp(2rem,4.5vw,3.4rem);margin-bottom:16px">A UGC ad agency that tests every video on <span class="cap">real spend</span></h1>
        <p class="lead">Most UGC agencies stop at delivery. You get a folder of videos and a good luck. I build UGC ads for one job: finding the few videos that bring customers at a price you can scale.</p>
        <p style="margin-top:16px;color:var(--soft,#4d4d49)">That means research before scripts, 3 to 5 hooks per video, creators matched to your buyer, and a look at the numbers after every batch. Then I make more of what worked and drop what didn't.</p>
        <div class="row" style="margin-top:32px">
          <a class="btn" href={ORDER}>Order 10 videos &middot; $500</a>
          <a class="btn ghost" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

    <!-- STATS -->
    <section style="padding:0 24px 48px">
      <div class="strip">
        <div><b>10,000+</b><span>ads and posts made</span></div>
        <div><b>600+</b><span>vetted creators</span></div>
        <div><b>100+</b><span>brands</span></div>
        <div><b>3 to 5</b><span>hooks per ad</span></div>
      </div>
    </section>

    <!-- WHAT YOU GET -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">What you <span class="cap g">get</span></h2>
      <div style="display:grid;gap:20px">
        <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:6px">Research.</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">I read your reviews, competitor ads in the Meta Ad Library and comments under your best posts. The angles come from what buyers already say.</p>
        </div>
        <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:6px">Scripts with hook variations.</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">One body, 3 to 5 openings. This is how 13 clips become 72 ads (how <a href="/blog/blog-high-volume-ugc-production">modular production</a> works).</p>
        </div>
        <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:6px">Creators who fit your buyer.</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">Moms, gym regulars, founders, 45+ customers. I cast from my own network of 600+ vetted creators.</p>
        </div>
        <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:6px">Native editing.</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">9:16 and 4:5, captions, no studio polish. The videos look like a post, not an ad.</p>
        </div>
        <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:6px">A data loop.</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">After each batch I look at hook rate, CTR and cost per purchase, and the next batch builds on the winners. See <a href="/blog/blog-hook-rate-explained">which numbers I track</a>.</p>
        </div>
      </div>
    </section>

    <!-- VIDEO: Creative Strategy -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <div style="position:relative;padding-bottom:56.25%;height:0;border-radius:12px;overflow:hidden">
        <iframe src="https://www.youtube.com/embed/pmaBFCKhyLg" title="Creative Strategy: The Research Behind High-Converting Ads" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
      <p style="margin-top:12px;color:var(--soft,#4d4d49);font-size:14px;text-align:center">How I research before writing a single script</p>
    </section>

    <!-- PROOF -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">Proof: what this looks like in <span class="cap y">real accounts</span></h2>
      <div style="display:grid;gap:16px">
        {cases.map(c => (
          <div style="padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <strong style="display:block;margin-bottom:6px">{c.title}</strong>
            <p style="color:var(--soft,#4d4d49);margin:0 0 12px;font-size:15px">{c.desc}</p>
            <a href={c.link} style="font-size:14px;font-weight:600">{c.cta} →</a>
          </div>
        ))}
      </div>
      <!-- Real ad examples -->
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:32px">
        <img src="/images/cases/ai-app/ai-app-01.webp" alt="AI app UGC ad — creator talking head" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
        <img src="/images/cases/womens-health-supplement-ads/img-01.jpg" alt="Supplement UGC ad — creator testimonial" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
        <img src="/images/cases/zentoes-walmart-launch-ads/img-03.jpg" alt="ZenToes UGC ad — product demo" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
        <img src="/images/cases/dating-com-creator-content/img-01.jpg" alt="Dating app UGC — creator storytime" loading="lazy" style="width:100%;border-radius:10px;aspect-ratio:9/16;object-fit:cover" />
      </div>
      <p style="margin-top:12px;color:var(--soft,#4d4d49);font-size:14px;text-align:center">Real ads from client accounts</p>

      <blockquote style="margin:32px 0 0;padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border-left:3px solid var(--dew,#eefb6e);font-style:italic">
        "OKAD found video ads that actually bring us customers. Fast, organized and easy to work with. We keep ordering new batches."
        <span style="display:block;margin-top:8px;font-style:normal;font-size:14px;color:var(--soft,#4d4d49)">Marketing Lead, InstaHeadshots</span>
      </blockquote>
    </section>

    <!-- HOW THE FIRST SIX WEEKS GO -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">How the first <span class="cap v">six weeks</span> go</h2>
      <div style="display:grid;gap:16px">
        {steps.map((s, i) => (
          <div style="display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:start;padding:24px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <span style="font-size:13px;font-weight:600;color:var(--soft,#4d4d49)">{s.wk}</span>
            <div>
              <strong style="display:block;margin-bottom:4px">{s.title}</strong>
              <p style="color:var(--soft,#4d4d49);margin:0;font-size:15px">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- VIDEO: Stop Letting Creators Write Your Hooks -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <div style="position:relative;padding-bottom:56.25%;height:0;border-radius:12px;overflow:hidden">
        <iframe src="https://www.youtube.com/embed/b1DVhq_Z0Bs" title="Stop Letting Creators Write Your Hooks" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" allow="accelerometer;autoplay;clipboard-write;encrypted-media;gyroscope;picture-in-picture" allowfullscreen loading="lazy"></iframe>
      </div>
      <p style="margin-top:12px;color:var(--soft,#4d4d49);font-size:14px;text-align:center">Why scripts should come from strategy, not from the creator</p>
    </section>

    <!-- COMPARISON TABLE -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">UGC ad agency, marketplace or <span class="cap p">freelancers</span>?</h2>
      <p style="color:var(--soft,#4d4d49);margin-bottom:24px">If you just need a few raw clips, a marketplace is cheaper. If you need ads that keep finding winners, you need someone who owns the testing. More on this in <a href="/blog/blog-ugc-video-ads-that-convert">what makes a UGC ad sell</a>.</p>
      <div style="overflow-x:auto;border-radius:12px;border:1px solid var(--border,#e6e6e6)">
        <table style="width:100%;border-collapse:collapse;font-size:15px">
          <thead>
            <tr style="background:var(--off-white,#f7f7f7)">
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)"></th>
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)">Marketplace (Billo, Insense)</th>
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)">Freelance creators</th>
              <th style="padding:14px 16px;text-align:left;border-bottom:1px solid var(--border,#e6e6e6)">OKAD</th>
            </tr>
          </thead>
          <tbody>
            {comparison.slice(1).map(r => (
              <tr>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6);font-weight:600">{r.col}</td>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6)">{r.marketplace}</td>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6)">{r.freelance}</td>
                <td style="padding:14px 16px;border-bottom:1px solid var(--border,#e6e6e6)">{r.okad}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- PRICING -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:16px">Pricing</h2>
      <ul style="list-style:none;padding:0;display:grid;gap:10px;color:var(--soft,#4d4d49);font-size:15px">
        <li><strong>Starter, no call:</strong> 10 ready-to-run videos, a testing plan, 5 business days, <strong>$500</strong>.</li>
        <li><strong>Monthly testing:</strong> from <strong>$2,500/month</strong>, about <strong>$100 per custom video</strong> with strategy, scripts, casting, filming and editing. Cheaper at volume.</li>
      </ul>
      <p style="margin-top:16px"><a href="/ugc-pricing/">Full breakdown on UGC pricing.</a></p>
    </section>

    <!-- WHAT TO LOOK FOR (extra depth per feedback) -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">What to look for in a UGC ad <span class="cap g">agency</span></h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
        <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:4px">Ask who writes the scripts</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">If the answer is "the creator", you are buying footage, not ads.</p>
        </div>
        <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:4px">Ask what happens after launch</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">A good agency reads hook rate, CTR and CPA and changes the next batch.</p>
        </div>
        <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:4px">Ask for hook variations</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">3 to 5 per video should be standard.</p>
        </div>
        <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:4px">Check usage rights</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">Paid ad usage and its length should be in the price.</p>
        </div>
        <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:4px">Start small</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">A first batch of 10 shows more than any sales call.</p>
        </div>
        <div style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
          <strong style="display:block;margin-bottom:4px">Look at cases with numbers</strong>
          <p style="color:var(--soft,#4d4d49);margin:0;font-size:14px">Not just a reel of nice videos.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section style="max-width:900px;margin:0 auto;padding:48px 24px">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem);margin-bottom:24px">FAQ</h2>
      <div style="display:grid;gap:12px">
        {faqs.map(f => (
          <details style="padding:20px;background:var(--off-white,#f7f7f7);border-radius:12px;border:1px solid var(--border,#e6e6e6)">
            <summary style="font-weight:600;cursor:pointer">{f.q}</summary>
            <p style="margin:12px 0 0;color:var(--soft,#4d4d49);font-size:15px">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section style="background:var(--stage,#111);padding:80px 24px;text-align:center">
      <div style="max-width:700px;margin:0 auto">
        <h2 style="color:#fff;font-size:clamp(1.5rem,3vw,2.2rem);margin-bottom:16px">Ready to test UGC ads?</h2>
        <p style="color:var(--stage-soft,#8e8e8e);margin-bottom:32px">Get 10 video ads in 5 days. I handle strategy, creators, editing, and testing — you see what scales.</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
          <a class="btn" href={ORDER}>Order 10 videos &middot; $500</a>
          <a class="btn dew" href={CALL} target="_blank" rel="noopener">Book a call</a>
        </div>
      </div>
    </section>

  </div>
</Base>
