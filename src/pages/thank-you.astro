---
import Base from '../layouts/Base.astro';
---

<Base title="Thank You — OKAD Agency" description="Thanks for reaching out. We'll get back to you shortly." noindex={true}>
  <div class="page-header" style="padding:120px 24px;">
    <h1>Thank You!</h1>
    <p>We've received your message and will get back to you within 24 hours. In the meantime, feel free to explore our work.</p>
    <div style="display:flex;gap:12px;justify-content:center;margin-top:32px;flex-wrap:wrap;">
      <a href="/" class="btn">Back to Home</a>
      <a href="/cases" class="btn btn-outline">View Cases</a>
    </div>
  </div>
</Base>
