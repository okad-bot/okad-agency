---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  lang?: string;
  noindex?: boolean;
}

const {
  title = 'OKAD Agency',
  description = 'OKAD Agency delivers standout web design, pitch decks, captivating video production, content creation & graphic design to help global brands stand out.',
  ogImage = '/assets/og-image.png',
  lang = 'en',
  noindex = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
import '../styles/global.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '@fontsource/instrument-sans/400-italic.css';
import '@fontsource/instrument-sans/600-italic.css';
import '@fontsource/reenie-beanie/400.css';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-YS34PNP7XN"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-YS34PNP7XN');
    </script>
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fragment+Mono&family=Handjet&display=swap"
      rel="stylesheet"
    />

  </head>
  <body>
    <div class="topbar">
      <span>Start with 1 task or 10 hours — scale when ready. <a href="/pricing">View pricing →</a></span>
    </div>

    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">OKAD</a>
        <button class="menu-toggle" aria-label="Menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
        <nav class="main-nav">
          <a href="/">Video ads</a>
          <a href="/cases">Cases</a>
          <a href="/design">Design</a>
          <a href="/pricing">Pricing</a>
          <a href="/blog/">Learn</a>
          <button type="button" class="nav-email copy-email" data-email="olga@okad.agency" title="Click to copy">olga@okad.agency</button>
          <a href="https://calendly.com/okad_calls/first" class="nav-cta" target="_blank" rel="noopener">Book a call</a>
        </nav>
      </div>
    </header>

    <script>
      const toggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('.main-nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
        nav.classList.remove('open');
        toggle?.setAttribute('aria-expanded', 'false');
      }));
    </script>

    <main>
      <slot />
    </main>

    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
      }, { threshold: 0.1 });
      document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
    </script>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-top">
          <a href="/" class="footer-logo">OKAD</a>
          <p class="footer-tagline">Ad creatives, UGC video, web design & branding — 100+ brands, 10,000+ assets.</p>
        </div>
        <nav class="footer-nav">
          <a href="/cases">Cases</a>
          <a href="/design">Design</a>
          <a href="/#cases">UGC Video</a>
          <a href="/" class="footer-logo-mid">OKAD</a>
          <a href="/#offer">Ad Creatives</a>
          <a href="/pricing">Pricing</a>
          <a href="/blog/">Learn</a>
        </nav>
        <div class="footer-social">
          <a href="https://x.com/okad_agency" target="_blank" rel="noopener" aria-label="X/Twitter">𝕏</a>
          <a href="https://www.behance.net/okad_agency" target="_blank" rel="noopener" aria-label="Behance">Be</a>
          <a href="https://www.linkedin.com/company/okad-agency/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
          <a href="https://www.youtube.com/@okad_agency" target="_blank" rel="noopener" aria-label="YouTube">▶</a>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2026 OKAD GROUP LLC. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <div class="copy-toast" role="status" aria-live="polite" hidden>Email copied</div>
    <style is:global>
      .copy-email{cursor:pointer;font:inherit}
      .nav-email{background:none;border:0;padding:0;color:inherit;font-size:inherit}
      .copy-toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:200;background:#111;color:#eefb6e;font:600 15px/1 'Instrument Sans',system-ui,sans-serif;padding:12px 18px;border-radius:99px;box-shadow:0 12px 30px -12px rgba(0,0,0,.5)}
      .copy-toast[hidden]{display:none}
    </style>
    <script>
      // Every email on the site is shown as text and copied on click (no mailto).
      const toast = document.querySelector<HTMLElement>('.copy-toast');
      let t: number | undefined;
      const copy = async (email: string, el?: HTMLElement) => {
        try { await navigator.clipboard.writeText(email); }
        catch {
          const ta = document.createElement('textarea'); ta.value = email; document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); } catch {}
          ta.remove();
        }
        if (toast) { toast.textContent = `${email} copied`; toast.hidden = false; clearTimeout(t); t = window.setTimeout(() => (toast.hidden = true), 2200); }
        (window as any).gtag?.('event', 'copy_email', { email_location: el?.className || 'link' });
      };
      document.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('.copy-email, a[href^="mailto:"]');
        if (!el) return;
        e.preventDefault();
        const email = el.dataset.email || (el.getAttribute('href') || '').replace('mailto:', '').split('?')[0];
        copy(email, el);
      });
    </script>
  </body>
</html>
